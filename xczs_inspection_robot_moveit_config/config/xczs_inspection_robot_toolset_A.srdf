<?xml version="1.0"?>
<!--
  Dual-arm semantic robot description for end-effector TOOLSET A (default):
  three_cylinder on the right wrist + two_cylinder on the left wrist.
  Arms, virtual_joint, fortune-cat home states and the wrist-flange/tool
  collision exemptions are shared with toolset B (xczs_inspection_robot_toolset_B.srdf);
  only this set's tool groups / end-effectors / collision exemptions appear here,
  so every link referenced exists in the toolset-A robot_description.
-->
<robot
  xmlns:xacro="http://www.ros.org/wiki/xacro"
  name="xczs_inspection_robot">
  <virtual_joint
    name="odom_joint"
    type="floating"
    parent_frame="odom"
    child_link="body" />

  <group name="left_arm">
    <chain base_link="body" tip_link="l_arm_6" />
  </group>

  <group name="right_arm">
    <chain base_link="body" tip_link="r_arm_6" />
  </group>

  <group name="three_cylinder">
    <joint name="r_three_cyl_finger1_joint" />
    <joint name="r_three_cyl_finger2_joint" />
    <joint name="r_three_cyl_finger3_joint" />
  </group>

  <group name="two_cylinder">
    <joint name="l_two_cyl_finger1_joint" />
    <joint name="l_two_cyl_finger2_joint" />
  </group>

  <!-- Calibrated fortune-cat transport pose, identical to Gazebo spawn and
       the manual/reset defaults exposed by the robot adapter. -->
  <group_state name="home" group="left_arm">
    <joint name="l_arm_0_joint" value="0" />
    <joint name="l_arm_1_joint" value="-1.4" />
    <joint name="l_arm_2_joint" value="0" />
    <joint name="l_arm_3_joint" value="-0.3" />
    <joint name="l_arm_4_joint" value="0" />
    <joint name="l_arm_5_joint" value="0.7" />
    <joint name="l_arm_6_joint" value="-0.85" />
  </group_state>

  <group_state name="home" group="right_arm">
    <joint name="r_arm_0_joint" value="0" />
    <joint name="r_arm_1_joint" value="-1.6" />
    <joint name="r_arm_2_joint" value="-0.4" />
    <joint name="r_arm_3_joint" value="0" />
    <joint name="r_arm_4_joint" value="0" />
    <joint name="r_arm_5_joint" value="0.8" />
    <joint name="r_arm_6_joint" value="0.1" />
  </group_state>

  <group_state name="open" group="three_cylinder">
    <joint name="r_three_cyl_finger1_joint" value="0" />
    <joint name="r_three_cyl_finger2_joint" value="0" />
    <joint name="r_three_cyl_finger3_joint" value="0" />
  </group_state>

  <group_state name="open" group="two_cylinder">
    <joint name="l_two_cyl_finger1_joint" value="0" />
    <joint name="l_two_cyl_finger2_joint" value="0" />
  </group_state>

  <end_effector
    name="three_cylinder"
    parent_link="r_arm_6"
    group="three_cylinder"
    parent_group="right_arm" />
  <end_effector
    name="two_cylinder"
    parent_link="l_arm_6"
    group="two_cylinder"
    parent_group="left_arm" />

  <!-- Adjacent / never-moving link pairs whose collision checks are skipped. -->
  <disable_collisions link1="body" link2="l_arm_0" reason="Adjacent" />
  <disable_collisions link1="body" link2="r_arm_0" reason="Adjacent" />
  <disable_collisions link1="body" link2="l_wheel_0" reason="Adjacent" />
  <disable_collisions link1="body" link2="l_wheel_1" reason="Adjacent" />
  <disable_collisions link1="body" link2="r_wheel_0" reason="Adjacent" />
  <disable_collisions link1="body" link2="r_wheel_1" reason="Adjacent" />
  <disable_collisions link1="body" link2="body_lidar_link" reason="Adjacent" />
  <disable_collisions link1="body" link2="l_laser" reason="Adjacent" />
  <disable_collisions link1="body" link2="r_laser" reason="Adjacent" />

  <disable_collisions link1="l_arm_0" link2="l_arm_1" reason="Adjacent" />
  <disable_collisions link1="l_arm_1" link2="l_arm_2" reason="Adjacent" />
  <disable_collisions link1="l_arm_2" link2="l_arm_3" reason="Adjacent" />
  <disable_collisions link1="l_arm_3" link2="l_arm_4" reason="Adjacent" />
  <disable_collisions link1="l_arm_4" link2="l_arm_5" reason="Adjacent" />
  <disable_collisions link1="l_arm_5" link2="l_arm_6" reason="Adjacent" />
  <disable_collisions link1="l_arm_6" link2="l_camera" reason="Adjacent" />

  <disable_collisions link1="r_arm_0" link2="r_arm_1" reason="Adjacent" />
  <disable_collisions link1="r_arm_1" link2="r_arm_2" reason="Adjacent" />
  <disable_collisions link1="r_arm_2" link2="r_arm_3" reason="Adjacent" />
  <disable_collisions link1="r_arm_3" link2="r_arm_4" reason="Adjacent" />
  <disable_collisions link1="r_arm_4" link2="r_arm_5" reason="Adjacent" />
  <disable_collisions link1="r_arm_5" link2="r_arm_6" reason="Adjacent" />
  <disable_collisions link1="r_arm_6" link2="r_camera" reason="Adjacent" />
  <disable_collisions link1="r_arm_6" link2="arm_camera_link" reason="Adjacent" />

  <!-- Each native tool socket is seated over its arm_6 wrist boss.  Only
       directly connected fixed pairs are excluded. -->
  <disable_collisions link1="r_arm_6" link2="r_three_cyl_base" reason="Adjacent" />
  <disable_collisions link1="l_arm_6" link2="l_two_cyl_base" reason="Adjacent" />

  <disable_collisions link1="r_three_cyl_finger1" link2="r_three_cyl_finger2" reason="Default" />

  <disable_collisions link1="l_two_cyl_finger1" link2="l_two_cyl_finger2" reason="Default" />

  <!-- Tucked fingers overlap their tool base at the retracted position (the
       tool body's flat face presses cabinet buttons). -->
  <disable_collisions link1="r_three_cyl_base" link2="r_three_cyl_finger1" reason="Tucked finger inside tool body" />
  <disable_collisions link1="r_three_cyl_base" link2="r_three_cyl_finger2" reason="Tucked finger inside tool body" />
  <disable_collisions link1="r_three_cyl_base" link2="r_three_cyl_finger3" reason="Tucked finger inside tool body" />
  <disable_collisions link1="r_three_cyl_finger2" link2="r_three_cyl_finger3" reason="Serial finger stages" />
  <disable_collisions link1="l_two_cyl_base" link2="l_two_cyl_finger1" reason="Tucked finger inside tool body" />
  <disable_collisions link1="l_two_cyl_base" link2="l_two_cyl_finger2" reason="Tucked finger inside tool body" />
  <!-- The wrist (r_arm_6) is separated from the upper forearm (r_arm_4) only by
       the short r_arm_5 link; their collision meshes pack to sub-mm contact in
       folded poses (the fortune-cat idle posture, r_arm_5≈0.8 rad).  This is a
       stable, contact-free pose in Gazebo ODE, so exclude the pair from MoveIt
       planning exactly like the adjacent arm-link pairs. -->
  <disable_collisions link1="r_arm_4" link2="r_arm_6" reason="Packed wrist gap in folded idle pose" />
</robot>
