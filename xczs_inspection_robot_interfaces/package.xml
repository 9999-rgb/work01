<?xml version="1.0"?>
<package format="3">
  <name>xczs_inspection_robot_interfaces</name>
  <version>1.0.0</version>
  <description>
    ROS 2 message / service / action interfaces for the XCZS inspection
    robot.  Pure interface package: no nodes, no launch, no config.
  </description>

  <maintainer email="live@example.com">live</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>action_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>trajectory_msgs</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
