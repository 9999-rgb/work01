#!/usr/bin/env bash
# Validate Web -> task manager -> namespaced ROS 2 -> Gazebo cabinet control.

set -euo pipefail

API_URL="${XCZS_CONTROL_API_URL:-http://127.0.0.1:8090}"
API_TOKEN="${XCZS_CONTROL_TOKEN:-}"
AUTH_USERNAME="${XCZS_CONTROL_USERNAME:-}"
AUTH_PASSWORD="${XCZS_CONTROL_PASSWORD:-}"
CABINET="cabinet_a"
TASK_TIMEOUT="${XCZS_CABINET_TIMEOUT:-360}"
RUN_NAVIGATION="true"
RUN_EXHAUSTIVE="false"
RUN_CONTRACT_TESTS="false"
EXPECTED_CONTROLS=33
EXPECTED_COUNTS_DEFAULT="20 11 1 1"
EXPECTED_COUNTS="$EXPECTED_COUNTS_DEFAULT"
# This is the verified task-layer handoff envelope.  The cabinet operator's
# closed-loop docking phase deliberately narrows it before moving either arm.
# 1.0 m covers the Nav2 inflation-limited stop for the tight Set B docks
# (knob/switch stop 0.5-0.8 m short); the docking controller then narrows to
# its own 0.008 m target.
NAVIGATION_POSITION_TOLERANCE_M=1.0
RESPONSE_BODY=""
TASK_BODY=""
ACTIVE_TASK_ID=""
CURRENT_STATION_CONTROL=""
PENDING_CLEANUP_BODY=""
SSE_FILE=""
SSE_PID=""
COMPLETED_TASKS=0
EXPECTED_FAILURE_TASKS=0
UNREACHABLE_TASKS=0
declare -A VALIDATED_OPERABLE_CONTROLS=()
AUTH_CURL_ARGS=()

usage() {
  cat <<'EOF'
用法: scripts/validate_cabinet_web [选项]

通过多柜体 Web 任务 API 验证独立导航、物理操作、力度判定和实时规划失败。
运行前需启动: ./run_all.sh

选项:
  --api URL           控制服务地址（默认 http://127.0.0.1:8090）
  --token TOKEN       JWT Bearer token（也可用 XCZS_CONTROL_TOKEN）
  --username NAME     登录用户名（也可用 XCZS_CONTROL_USERNAME）
  --password PASSWORD 登录密码（建议使用 XCZS_CONTROL_PASSWORD）
  --cabinet NAME      柜体实例（默认 cabinet_a；全量验收时逐实例调用）
  --timeout SECONDS   单个任务超时（默认 360）
  --expect-controls N 柜体目录预期控件总数（默认 33）
  --expect-counts STR 四类控件预期数量 "按钮 旋钮 开关 门"（默认 "20 11 1 1"）
  --no-navigate       仅跳过通用工位导航；实际操作仍执行逐控件导航
  --exhaustive        验收全部可操作控件：可操作项实操，受限项逐项实时规划验证
  --contract-tests    追加并发冲突和 /task/{id}/cancel 验证
  -h, --help          显示帮助
EOF
}

fail() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || fail "缺少命令: $1"
}

normalize_task_timeout() {
  local value="$1"
  local decimal=""
  [[ "$value" =~ ^[0-9]+$ && "${#value}" -le 10 ]] || return 1
  decimal=$((10#$value))
  (( decimal >= 1 && decimal <= 86400 )) || return 1
  TASK_TIMEOUT="$decimal"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --api)
      [[ $# -ge 2 ]] || fail "--api 缺少 URL"
      API_URL="${2%/}"
      shift 2
      ;;
    --cabinet)
      [[ $# -ge 2 ]] || fail "--cabinet 缺少实例名"
      CABINET="$2"
      shift 2
      ;;
    --token)
      [[ $# -ge 2 ]] || fail "--token 缺少 TOKEN"
      API_TOKEN="$2"
      shift 2
      ;;
    --username)
      [[ $# -ge 2 ]] || fail "--username 缺少 NAME"
      AUTH_USERNAME="$2"
      shift 2
      ;;
    --password)
      [[ $# -ge 2 ]] || fail "--password 缺少 PASSWORD"
      AUTH_PASSWORD="$2"
      shift 2
      ;;
    --timeout)
      [[ $# -ge 2 ]] || fail "--timeout 缺少秒数"
      TASK_TIMEOUT="$2"
      shift 2
      ;;
    --expect-controls)
      [[ $# -ge 2 ]] || fail "--expect-controls 缺少数量"
      EXPECTED_CONTROLS="$2"
      shift 2
      ;;
    --expect-counts)
      [[ $# -ge 2 ]] || fail "--expect-counts 缺少数量串"
      EXPECTED_COUNTS="$2"
      shift 2
      ;;
    --no-navigate)
      RUN_NAVIGATION="false"
      shift
      ;;
    --exhaustive)
      RUN_EXHAUSTIVE="true"
      shift
      ;;
    --contract-tests)
      RUN_CONTRACT_TESTS="true"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      fail "未知选项: $1"
      ;;
  esac
done

[[ "$CABINET" =~ ^[a-z][a-z0-9_]{0,62}$ ]] ||
  fail "--cabinet 必须以小写字母开头，只能包含小写字母、数字和下划线，且总长度不超过 63"
normalize_task_timeout "$TASK_TIMEOUT" ||
  fail "--timeout 必须是 1..86400 的整数"
[[ "$EXPECTED_CONTROLS" =~ ^[1-9][0-9]{0,6}$ ]] ||
  fail "--expect-controls 必须是正整数"
if [[ "$(wc -w <<<"$EXPECTED_COUNTS")" -ne 4 ]]; then
  fail "--expect-counts 必须是四个空格分隔的整数（如 '20 11 1 1'）"
fi
read -r EXPECTED_BUTTONS EXPECTED_KNOBS EXPECTED_SWITCHES EXPECTED_DOORS <<<"$EXPECTED_COUNTS"
for _expected_count in "$EXPECTED_BUTTONS" "$EXPECTED_KNOBS" "$EXPECTED_SWITCHES" "$EXPECTED_DOORS"; do
  [[ "$_expected_count" =~ ^[0-9]+$ ]] ||
    fail "--expect-counts 必须是四个非负整数（如 '20 11 1 1'）"
done
if (( EXPECTED_BUTTONS + EXPECTED_KNOBS + EXPECTED_SWITCHES + EXPECTED_DOORS != EXPECTED_CONTROLS )); then
  fail "四类控件计数之和需等于 --expect-controls（$EXPECTED_CONTROLS），当前为 $EXPECTED_COUNTS"
fi
require_command curl
require_command jq
require_command mktemp

if [[ -z "$API_TOKEN" && -z "$AUTH_PASSWORD" && -n "${XCZS_ADMIN_PASSWORD:-}" ]]; then
  AUTH_PASSWORD="$XCZS_ADMIN_PASSWORD"
fi
if [[ -n "$API_TOKEN" && ( -n "$AUTH_USERNAME" || -n "$AUTH_PASSWORD" ) ]]; then
  fail "--token 不能与用户名/密码同时使用"
fi
if [[ -n "$AUTH_PASSWORD" && -z "$AUTH_USERNAME" ]]; then
  AUTH_USERNAME="admin"
fi
if [[ -n "$AUTH_USERNAME" && -z "$AUTH_PASSWORD" ]]; then
  fail "提供用户名时必须同时提供密码"
fi

configure_auth() {
  local login_body=""
  local raw_response=""
  local response_code=""
  if [[ -n "$API_TOKEN" ]]; then
    AUTH_CURL_ARGS=(-H "Authorization: Bearer $API_TOKEN")
    return
  fi
  if [[ -z "$AUTH_USERNAME" ]]; then
    AUTH_CURL_ARGS=()
    return
  fi
  login_body="$(
    jq -cn --arg username "$AUTH_USERNAME" --arg password "$AUTH_PASSWORD" \
      '{username:$username,password:$password}'
  )"
  raw_response="$(
    curl -sS --connect-timeout 5 --max-time 30 \
      -H 'Content-Type: application/json' -X POST --data-binary @- \
      -w $'\n%{http_code}' "$API_URL/auth/login" <<<"$login_body"
  )" || fail "POST /auth/login 请求失败"
  response_code="${raw_response##*$'\n'}"
  RESPONSE_BODY="${raw_response%$'\n'*}"
  if [[ "$response_code" != "200" ]]; then
    jq . <<<"$RESPONSE_BODY" >&2 2>/dev/null || printf '%s\n' "$RESPONSE_BODY" >&2
    fail "POST /auth/login 期望 HTTP 200，实际 $response_code"
  fi
  API_TOKEN="$(jq -er '.access_token | select(type == "string" and length > 0)' \
    <<<"$RESPONSE_BODY")" || fail "/auth/login 未返回 access_token"
  AUTH_CURL_ARGS=(-H "Authorization: Bearer $API_TOKEN")
  printf '已以用户 %s 登录。\n' "$AUTH_USERNAME"
}

configure_auth

request_json() {
  local method="$1"
  local path="$2"
  local expected_code="$3"
  local request_body="${4:-}"
  local raw_response
  local response_code

  if [[ -n "$request_body" ]]; then
    raw_response="$(
      curl -sS --connect-timeout 5 --max-time 30 \
        "${AUTH_CURL_ARGS[@]}" \
        -H 'Content-Type: application/json' \
        -X "$method" --data "$request_body" \
        -w $'\n%{http_code}' "$API_URL$path"
    )" || fail "$method $path 请求失败"
  else
    raw_response="$(
      curl -sS --connect-timeout 5 --max-time 30 \
        "${AUTH_CURL_ARGS[@]}" \
        -X "$method" -w $'\n%{http_code}' "$API_URL$path"
    )" || fail "$method $path 请求失败"
  fi
  response_code="${raw_response##*$'\n'}"
  RESPONSE_BODY="${raw_response%$'\n'*}"
  jq -e . <<<"$RESPONSE_BODY" >/dev/null ||
    fail "$method $path 返回的不是有效 JSON"
  if [[ "$response_code" != "$expected_code" ]]; then
    jq . <<<"$RESPONSE_BODY" >&2
    fail "$method $path 期望 HTTP $expected_code，实际 $response_code"
  fi
}

get_json() {
  local path="$1"
  RESPONSE_BODY="$(
    curl -fsS --connect-timeout 5 --max-time 30 \
      "${AUTH_CURL_ARGS[@]}" "$API_URL$path"
  )" || fail "GET $path 请求失败"
  jq -e . <<<"$RESPONSE_BODY" >/dev/null ||
    fail "GET $path 返回的不是有效 JSON"
}

task_is_terminal() {
  case "$1" in
    success|failed|canceled) return 0 ;;
    *) return 1 ;;
  esac
}

best_effort_wait_terminal() {
  local task_id="$1"
  local deadline=$((SECONDS + 30))
  local body=""
  local status=""
  while (( SECONDS < deadline )); do
    body="$(
      curl -fsS --connect-timeout 2 --max-time 5 \
        "${AUTH_CURL_ARGS[@]}" \
        "$API_URL/task/$task_id/status" 2>/dev/null || true
    )"
    if jq -e . >/dev/null 2>&1 <<<"$body"; then
      status="$(jq -r '.status // ""' <<<"$body")"
      task_is_terminal "$status" && return 0
    fi
    sleep 1
  done
  return 1
}

best_effort_cleanup() {
  local exit_code=$?
  local status_body=""
  local status=""
  local cleanup_response=""
  local cleanup_task=""

  trap - EXIT INT TERM
  if [[ -n "$ACTIVE_TASK_ID" ]]; then
    status_body="$(
      curl -fsS --connect-timeout 2 --max-time 5 \
        "${AUTH_CURL_ARGS[@]}" \
        "$API_URL/task/$ACTIVE_TASK_ID/status" 2>/dev/null || true
    )"
    status="$(jq -r '.status // ""' <<<"$status_body" 2>/dev/null || true)"
    if ! task_is_terminal "$status"; then
      curl -sS --connect-timeout 2 --max-time 5 \
        "${AUTH_CURL_ARGS[@]}" \
        -H 'Content-Type: application/json' -X POST --data '{}' \
        "$API_URL/task/$ACTIVE_TASK_ID/cancel" >/dev/null 2>&1 || true
      best_effort_wait_terminal "$ACTIVE_TASK_ID" || true
    fi
    ACTIVE_TASK_ID=""
  fi

  # A failed test after moving a rotary control must not deliberately leave
  # that control away from its initial detent.  Submit the saved inverse task
  # only after the active task has reached a terminal state.
  if [[ -n "$PENDING_CLEANUP_BODY" ]]; then
    cleanup_response="$(
      curl -fsS --connect-timeout 2 --max-time 10 \
        "${AUTH_CURL_ARGS[@]}" \
        -H 'Content-Type: application/json' -X POST \
        --data "$PENDING_CLEANUP_BODY" \
        "$API_URL/task/operate" 2>/dev/null || true
    )"
    cleanup_task="$(
      jq -r '.task_id // ""' <<<"$cleanup_response" 2>/dev/null || true
    )"
    if [[ -n "$cleanup_task" ]]; then
      best_effort_wait_terminal "$cleanup_task" || true
    fi
  fi

  if [[ -n "$SSE_PID" ]]; then
    kill "$SSE_PID" >/dev/null 2>&1 || true
    wait "$SSE_PID" 2>/dev/null || true
  fi
  if [[ -n "$SSE_FILE" && -f "$SSE_FILE" ]]; then
    rm -f -- "$SSE_FILE"
  fi
  exit "$exit_code"
}
trap best_effort_cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

wait_for_system_ready() {
  local deadline=$((SECONDS + 120))
  local health_body=""
  local controls_body=""
  local controls_raw=""
  local controls_code=""
  while (( SECONDS < deadline )); do
    health_body="$(
      curl -fsS --connect-timeout 2 --max-time 5 \
        "${AUTH_CURL_ARGS[@]}" "$API_URL/health" 2>/dev/null || true
    )"
    controls_raw="$(
      curl -sS --connect-timeout 2 --max-time 5 \
        "${AUTH_CURL_ARGS[@]}" \
        -w $'\n%{http_code}' \
        "$API_URL/cabinets/$CABINET/controls" 2>/dev/null || true
    )"
    controls_code="${controls_raw##*$'\n'}"
    controls_body="${controls_raw%$'\n'*}"
    if [[ "$controls_code" == "401" || "$controls_code" == "403" ]]; then
      jq . <<<"$controls_body" >&2 2>/dev/null || true
      fail "鉴权失败：请用 --token，或设置 XCZS_CONTROL_USERNAME/XCZS_CONTROL_PASSWORD"
    fi
    if jq -e --arg cabinet "$CABINET" '
        .status == "ok" and
        .navigation_available == true and
        .map_available == true and
        (.cabinet_count >= 1)
      ' <<<"$health_body" >/dev/null 2>&1 &&
      jq -e --arg cabinet "$CABINET" \
        --argjson expect_controls "$EXPECTED_CONTROLS" '
        .cabinet == $cabinet and .catalog_received == true and
        .available == true and (.controls | length) == $expect_controls and
        ([.controls[] | select(.valid == true)] | length) == $expect_controls
      ' <<<"$controls_body" >/dev/null 2>&1
    then
      RESPONSE_BODY="$controls_body"
      return
    fi
    sleep 1
  done
  [[ -z "$health_body" ]] || jq . <<<"$health_body" >&2
  [[ -z "$controls_body" ]] || jq . <<<"$controls_body" >&2
  fail "Web/ROS 2 未在 120 秒内确认 ${EXPECTED_CONTROLS} 项柜体目录、状态及 Nav2 可用"
}

start_sse_capture() {
  SSE_FILE="$(mktemp /tmp/xczs-task-events.XXXXXX)"
  curl -sS -N --connect-timeout 5 "${AUTH_CURL_ARGS[@]}" \
    "$API_URL/task/events" \
    >"$SSE_FILE" 2>/dev/null &
  SSE_PID=$!
  sleep 1
  kill -0 "$SSE_PID" >/dev/null 2>&1 || fail "无法连接任务 SSE 事件流"
}

submit_task() {
  local task_type="$1"
  local body="$2"
  request_json POST "/task/$task_type" 202 "$body"
  jq -e --arg type "$task_type" '
    (.task_id | test("^" + $type + "_[0-9]+_[a-z0-9]{6}$")) and
    (.type == $type) and
    (.status == "accepted" or .status == "running")
  ' <<<"$RESPONSE_BODY" >/dev/null || {
    jq . <<<"$RESPONSE_BODY" >&2
    fail "/task/$task_type 未返回合规 task_id/任务状态"
  }
  ACTIVE_TASK_ID="$(jq -r '.task_id' <<<"$RESPONSE_BODY")"
}

wait_for_task() {
  local task_id="$1"
  local expected_status="$2"
  local expected_failure_code="${3:-}"
  local deadline=$((SECONDS + TASK_TIMEOUT))
  local status=""
  local signature=""
  local previous_signature=""

  while (( SECONDS < deadline )); do
    get_json "/task/$task_id/status"
    TASK_BODY="$RESPONSE_BODY"
    status="$(jq -r '.status // ""' <<<"$TASK_BODY")"
    signature="$(
      jq -r '[.status, .phase, (.progress // 0), .message] | @tsv' \
        <<<"$TASK_BODY"
    )"
    if [[ "$signature" != "$previous_signature" ]]; then
      jq -r '
        "  status=\(.status) phase=\(.phase) " +
        "progress=\(((.progress // 0) * 100) | floor)% \(.message)"
      ' <<<"$TASK_BODY"
      previous_signature="$signature"
    fi
    if task_is_terminal "$status"; then
      ACTIVE_TASK_ID=""
      [[ "$status" == "$expected_status" ]] || {
        jq . <<<"$TASK_BODY" >&2
        fail "任务 $task_id 期望 $expected_status，实际 $status"
      }
      if [[ -n "$expected_failure_code" ]]; then
        jq -e --arg code "$expected_failure_code" \
          '.failure_code == $code and
           (.failure_reason | type == "string" and length > 0)' \
          <<<"$TASK_BODY" >/dev/null || {
          jq . <<<"$TASK_BODY" >&2
          fail "任务 $task_id 未返回 $expected_failure_code 结构化失败"
        }
      fi
      return
    fi
    sleep 1
  done
  fail "任务 $task_id 未在 ${TASK_TIMEOUT}s 内完成"
}

navigate_for_control() {
  local control_id="$1"
  local navigation_task_id=""

  if [[ "$CURRENT_STATION_CONTROL" == "$control_id" ]]; then
    return
  fi

  printf '\n[navigate-control] %s -> %s\n' "$CABINET" "$control_id"
  submit_task navigate "$(
    jq -cn --arg cabinet "$CABINET" --arg control "$control_id" \
      '{cabinet:$cabinet, control_id:$control}'
  )"
  navigation_task_id="$ACTIVE_TASK_ID"
  wait_for_task "$navigation_task_id" success
  jq -e --arg cabinet "$CABINET" --arg control "$control_id" \
    --argjson position_tolerance "$NAVIGATION_POSITION_TOLERANCE_M" '
    .request.cabinet == $cabinet and
    .request.control_id == $control and
    .request.station.cabinet == $cabinet and
    .result.cabinet == $cabinet and
    .result.station.cabinet == $cabinet and
    (.result.final_pose.x | numbers) and
    (.result.final_pose.y | numbers) and
    (.result.final_pose.yaw | numbers) and
    .result.error.position_m <= $position_tolerance and
    .result.error.yaw_rad <= 0.25 and
    (.result.duration_seconds >= 0)
  ' <<<"$TASK_BODY" >/dev/null || {
    jq . <<<"$TASK_BODY" >&2
    fail "$control_id 的逐控件导航结果缺少请求标识、工位、终点或误差"
  }
  CURRENT_STATION_CONTROL="$control_id"
  COMPLETED_TASKS=$((COMPLETED_TASKS + 1))
}

cabinet_controls_snapshot() {
  get_json "/cabinets/$CABINET/controls"
  jq -ce --argjson expect_controls "$EXPECTED_CONTROLS" '
    [.controls[] |
      {control_id:.control_id,
       state:.current_state,
       position:.current_position,
       sequence:.transition_sequence,
       valid:.valid,
       in_motion:.in_motion}] |
    sort_by(.control_id) |
    select(
      length == $expect_controls and
      all(.[];
        .valid == true and .in_motion == false and
        (.state | type) == "string" and (.state | length) > 0 and
        (.position | type) == "number" and (.position | isfinite) and
        (.sequence | type) == "number" and (.sequence | isfinite)))
  ' <<<"$RESPONSE_BODY" ||
    fail "$CABINET 无法生成 ${EXPECTED_CONTROLS} 项有效、静止且数值完整的实时状态快照"
}

assert_cabinet_controls_unchanged() {
  local before="$1"
  local excluded_control="${2:-}"
  local after=""

  after="$(cabinet_controls_snapshot)"
  jq -ne --arg excluded "$excluded_control" \
    --argjson before "$before" --argjson after "$after" \
    --argjson expect_controls "$EXPECTED_CONTROLS" '
      ($before | length) == $expect_controls and ($after | length) == $expect_controls and
      all(range(0; $before | length);
        . as $index |
        $before[$index].control_id == $after[$index].control_id and
        ($before[$index].control_id == $excluded or
          (($after[$index].position - $before[$index].position) as $delta |
           $after[$index].state == $before[$index].state and
           $after[$index].sequence == $before[$index].sequence and
           $delta >= -0.0001 and $delta <= 0.0001)))
    ' >/dev/null || {
    jq -n --argjson before "$before" --argjson after "$after" \
      --arg excluded "$excluded_control" \
      '{excluded_control:$excluded, before:$before, after:$after}' >&2
    fail "$CABINET 柜内非目标控件状态发生变化，检测到物理串扰"
  }
}

run_successful_operation() {
  local control_id="$1"
  local request_body="$2"
  local state_before=""
  navigate_for_control "$control_id"
  state_before="$(cabinet_controls_snapshot)"
  printf '\n[operate] %s\n' "$control_id"
  submit_task operate "$request_body"
  local task_id="$ACTIVE_TASK_ID"
  wait_for_task "$task_id" success
  jq -e --arg cabinet "$CABINET" --arg control "$control_id" '
    .request.cabinet == $cabinet and
    .request.control_id == $control and
    .result.cabinet == $cabinet and
    .result.control_id == $control and
    .result.operation_executed == true and
    .result.validation_performed == false and
    (.result.duration_seconds >= 0)
  ' <<<"$TASK_BODY" >/dev/null || {
    jq . <<<"$TASK_BODY" >&2
    fail "$control_id 成功结果缺少柜体、控件或耗时字段"
  }
  assert_cabinet_controls_unchanged "$state_before" "$control_id"
  VALIDATED_OPERABLE_CONTROLS["$control_id"]=1
  COMPLETED_TASKS=$((COMPLETED_TASKS + 1))
}

run_state_round_trip() {
  local control_id="$1"
  local initial_state="$2"
  local target_state="$3"
  [[ -n "$initial_state" && -n "$target_state" ]] || return
  [[ "$initial_state" != "$target_state" ]] || return

  # Only arm the inverse operation after the control-specific station has
  # been reached.  A navigation failure must not trigger an unsafe cleanup
  # manipulation from an unrelated base pose.
  navigate_for_control "$control_id"
  PENDING_CLEANUP_BODY="$(
    jq -cn --arg cabinet "$CABINET" --arg control "$control_id" \
      --arg state "$initial_state" \
      '{cabinet:$cabinet, control_id:$control,
        command:"set_state", target_state:$state}'
  )"
  local outbound
  outbound="$(
    jq -cn --arg cabinet "$CABINET" --arg control "$control_id" \
      --arg state "$target_state" \
      '{cabinet:$cabinet, control_id:$control,
        command:"set_state", target_state:$state}'
  )"
  run_successful_operation "$control_id" "$outbound"
  run_successful_operation "$control_id" "$PENDING_CLEANUP_BODY"
  PENDING_CLEANUP_BODY=""
}

operation_body_for_control() {
  local control_id="$1"
  local requested_command="${2:-auto}"
  local control_type=""
  local current_state=""
  local live_controls_body=""
  local target_position=""
  local target_state=""

  # Re-read retained ROS state immediately before the Goal.  The initial
  # catalog snapshot may be stale after reset or an earlier round trip.
  get_json "/cabinets/$CABINET/controls"
  live_controls_body="$RESPONSE_BODY"
  jq -e --arg id "$control_id" '
    ([.controls[] | select(.control_id == $id)] | length) == 1 and
    (first(.controls[] | select(.control_id == $id)) |
      .valid == true and .in_motion == false)
  ' <<<"$live_controls_body" >/dev/null ||
    fail "$control_id 没有唯一、有效且静止的实时物理状态"
  control_type="$(
    jq -r --arg id "$control_id" '
      .controls[] | select(.control_id == $id) | .control_type
    ' <<<"$live_controls_body"
  )"
  if [[ "$control_type" == "0" ]]; then
    [[ "$requested_command" == "auto" || "$requested_command" == "press" ]] ||
      fail "$control_id 是按钮，不能用于 $requested_command 合同验证"
    jq -cn --arg cabinet "$CABINET" --arg control "$control_id" \
      '{cabinet:$cabinet, control_id:$control, command:"press"}'
    return
  fi
  case "$requested_command" in
    auto|set_state|set_position|toggle) ;;
    *) fail "未知柜体验证命令: $requested_command" ;;
  esac
  current_state="$(
    jq -r --arg id "$control_id" '
      .controls[] | select(.control_id == $id) |
      if (.current_state | type) == "string" then .current_state else "" end
    ' <<<"$live_controls_body"
  )"
  [[ -n "$current_state" ]] ||
    fail "NOT APPLICABLE: $control_id 缺少实时 current_state，无法证明非零位移验证"
  jq -e --arg id "$control_id" --arg current "$current_state" '
    any(.controls[] | select(.control_id == $id) | .state_ids[];
        . == $current)
  ' <<<"$live_controls_body" >/dev/null ||
    fail "NOT APPLICABLE: $control_id 的实时状态 $current_state 不在离散状态目录中"
  target_state="$(
    jq -r --arg id "$control_id" --arg current "$current_state" '
      first(.controls[] | select(.control_id == $id) |
        .state_ids[] | select(. != $current)) // ""
    ' <<<"$live_controls_body"
  )"
  [[ -n "$target_state" ]] ||
    fail "NOT APPLICABLE: $control_id 没有区别于实时状态 $current_state 的有效目标，拒绝伪验证"
  case "$requested_command" in
    auto|set_state)
      jq -cn --arg cabinet "$CABINET" --arg control "$control_id" \
        --arg state "$target_state" \
        '{cabinet:$cabinet, control_id:$control,
          command:"set_state", target_state:$state}'
      ;;
    set_position)
      target_position="$(
        jq -r --arg id "$control_id" --arg target "$target_state" '
          .controls[] | select(.control_id == $id) |
          .state_ids as $ids | ($ids | index($target)) as $index |
          .state_positions[$index] |
          if type == "number" then tostring else "" end
        ' <<<"$live_controls_body"
      )"
      [[ -n "$target_position" ]] ||
        fail "NOT APPLICABLE: $control_id 的目标状态 $target_state 缺少有效 detent 位置"
      jq -cn --arg cabinet "$CABINET" --arg control "$control_id" \
        --argjson position "$target_position" \
        '{cabinet:$cabinet, control_id:$control,
          command:"set_position", target_position:$position}'
      ;;
    toggle)
      jq -cn --arg cabinet "$CABINET" --arg control "$control_id" \
        '{cabinet:$cabinet, control_id:$control, command:"toggle"}'
      ;;
  esac
}

run_unreachable_operation() {
  local control_id="$1"
  local expected_reason="$2"
  local requested_command="${3:-auto}"
  local count_inventory="${4:-true}"
  local effective_command=""
  local request_body=""
  local states_before=""
  local task_id=""

  [[ -n "$expected_reason" ]] ||
    fail "$control_id 未在目录中声明机器人不可操作原因"
  navigate_for_control "$control_id"
  request_body="$(
    operation_body_for_control "$control_id" "$requested_command"
  )"
  effective_command="$(jq -r '.command' <<<"$request_body")"
  states_before="$(cabinet_controls_snapshot)"
  printf '\n[planning-validation] %s %s -> live structured result\n' \
    "$control_id" "$effective_command"
  submit_task operate "$request_body"
  task_id="$ACTIVE_TASK_ID"
  wait_for_task "$task_id" failed
  jq -e --arg cabinet "$CABINET" --arg control "$control_id" \
    --arg reason "$expected_reason" --arg command "$effective_command" '
      .request.cabinet == $cabinet and
      .request.control_id == $control and
      .request.command == $command and
      (.failure_code == "planning_failed" or
       .failure_code == "unreachable") and
      (.failure_reason | type == "string" and length > 0 and
        contains($reason)) and
      .result.cabinet == $cabinet and
      .result.control_id == $control and
      .result.validation_performed == true and
      .result.operation_executed == false and
      (.result.diagnostic_stage | type == "string" and length > 0) and
      (.result.path_fraction | numbers) >= 0 and
      .result.path_fraction <= 1 and
      (.result.required_fraction | numbers) > 0 and
      .result.required_fraction <= 1 and
      (.result.moveit_error_code | numbers) and
      (.result.policy_reason | type == "string" and contains($reason))
    ' <<<"$TASK_BODY" >/dev/null || {
    jq . <<<"$TASK_BODY" >&2
    fail "$control_id 没有返回实时规划阶段、路径比例和具体原因"
  }
  assert_cabinet_controls_unchanged "$states_before"
  EXPECTED_FAILURE_TASKS=$((EXPECTED_FAILURE_TASKS + 1))
  if [[ "$count_inventory" == "true" ]]; then
    UNREACHABLE_TASKS=$((UNREACHABLE_TASKS + 1))
  fi
}

run_unavailable_knob_command_contracts() {
  local control_id="$1"
  local expected_reason="$2"

  [[ -n "$control_id" ]] ||
    fail "NOT APPLICABLE: 目录中没有受限 knob，无法验证 SET_POSITION/TOGGLE 规划合同"
  run_unreachable_operation \
    "$control_id" "$expected_reason" set_position false
  # The previous planning-only result is required to leave physical state
  # unchanged.  The second request still re-reads current_state independently.
  run_unreachable_operation \
    "$control_id" "$expected_reason" toggle false
}

validate_sse_capture() {
  sleep 1
  grep -q '^event: task_accepted$' "$SSE_FILE" ||
    fail "SSE 未观察到 task_accepted"
  grep -q '^event: task_progress$' "$SSE_FILE" ||
    fail "SSE 未观察到 task_progress"
  grep -q '^event: task_completed$' "$SSE_FILE" ||
    fail "SSE 未观察到 task_completed"
}

printf 'XCZS 多柜体 Web 端到端验收\n'
printf '  API: %s\n' "$API_URL"
printf '  Cabinet: %s\n' "$CABINET"
printf '  Independent Nav2 task: %s\n' "$RUN_NAVIGATION"

wait_for_system_ready

get_json /cabinets
CABINETS_BODY="$RESPONSE_BODY"
jq -e --arg cabinet "$CABINET" '
  .count == (.cabinets | length) and .count >= 1 and
  ([.cabinets[].name] | unique | length) == .count and
  ([.cabinets[].namespace] | unique | length) == .count and
  ([.cabinets[].frame_id] | unique | length) == .count and
  any(.cabinets[];
    .name == $cabinet and
    .namespace == ("/xczs/cabinet/" + $cabinet) and
    .frame_id == ($cabinet + "_frame") and
    .navigation_station.cabinet == $cabinet and
    .navigation_station.frame_id == "map")
' <<<"$CABINETS_BODY" >/dev/null || {
  jq . <<<"$CABINETS_BODY" >&2
  fail "/cabinets 未返回 $CABINET 的 namespace、TF 和导航工位"
}

get_json "/cabinets/$CABINET/controls"
CONTROLS_BODY="$RESPONSE_BODY"
jq -e --arg namespace "/xczs/cabinet/$CABINET/" \
  --argjson expect_controls "$EXPECTED_CONTROLS" \
  --argjson expect_buttons "$EXPECTED_BUTTONS" \
  --argjson expect_knobs "$EXPECTED_KNOBS" \
  --argjson expect_switches "$EXPECTED_SWITCHES" \
  --argjson expect_doors "$EXPECTED_DOORS" '
  .catalog_received == true and .available == true and
  (.controls | length) == $expect_controls and
  ([.controls[] | select(.control_type == 0)] | length) == $expect_buttons and
  ([.controls[] | select(.control_type == 1)] | length) == $expect_knobs and
  ([.controls[] | select(.control_type == 2)] | length) == $expect_switches and
  ([.controls[] | select(.control_type == 3)] | length) == $expect_doors and
  all(.controls[];
    (.resolved_state_topic | startswith($namespace)) and
    (.operable == true or
      (.unavailable_reason | type == "string" and length > 0))) and
  all(.controls[] | select(.control_type == 0);
    .default_force == 5 and .min_trigger_force == 4.8 and
    .max_force == 6.4)
' <<<"$CONTROLS_BODY" >/dev/null || {
  jq . <<<"$CONTROLS_BODY" >&2
  fail "控件目录、实例话题、可达性或力度元数据不符合需求"
}

BUTTON_ID="$(
  jq -r '(
    first(.controls[] |
      select(.control_id == "box_10_button_1" and
             .control_type == 0 and .operable == true) |
      .control_id)
    // first(.controls[] |
      select(.control_type == 0 and .operable == true) |
      .control_id)
    // ""
  )' <<<"$CONTROLS_BODY"
)"
UNREACHABLE_ID="$(
  jq -r 'first(.controls[] |
    select(.operable == false) | .control_id) // ""' \
    <<<"$CONTROLS_BODY"
)"
UNREACHABLE_REASON="$(
  jq -r --arg id "$UNREACHABLE_ID" \
    '.controls[] | select(.control_id == $id) | .unavailable_reason' \
    <<<"$CONTROLS_BODY"
)"
UNAVAILABLE_KNOB_ID="$(
  jq -r 'first(.controls[] |
    select(.control_type == 1 and .operable == false) |
    .control_id) // ""' <<<"$CONTROLS_BODY"
)"
UNAVAILABLE_KNOB_REASON="$(
  jq -r --arg id "$UNAVAILABLE_KNOB_ID" '
    first(.controls[] | select(.control_id == $id) |
      .unavailable_reason) // ""
  ' <<<"$CONTROLS_BODY"
)"
UNAVAILABLE_COUNT="$(
  jq '[.controls[] | select(.operable == false)] | length' \
    <<<"$CONTROLS_BODY"
)"
OPERABLE_COUNT="$(
  jq '[.controls[] | select(.operable == true)] | length' \
    <<<"$CONTROLS_BODY"
)"
[[ -n "$BUTTON_ID" ]] || fail "目录中没有可达按钮，无法验证力度"
if [[ -n "$UNREACHABLE_ID" && -z "$UNREACHABLE_REASON" ]]; then
  fail "$UNREACHABLE_ID 没有声明机器人不可操作的具体原因"
fi
if [[ -n "$UNAVAILABLE_KNOB_ID" && -z "$UNAVAILABLE_KNOB_REASON" ]]; then
  fail "$UNAVAILABLE_KNOB_ID 没有声明机器人不可操作的具体原因"
fi

PEER_CABINET="$(
  jq -r --arg selected "$CABINET" '
    first(.cabinets[] | select(.name != $selected) | .name) // ""
  ' <<<"$CABINETS_BODY"
)"
PEER_BUTTON_STATE=""
PEER_BUTTON_SEQUENCE=""
if [[ -n "$PEER_CABINET" ]]; then
  get_json "/cabinets/$PEER_CABINET/controls"
  jq -e --arg cabinet "$PEER_CABINET" --arg control "$BUTTON_ID" \
    --arg namespace "/xczs/cabinet/$PEER_CABINET/" '
      .cabinet == $cabinet and .catalog_received == true and
      any(.controls[];
        .control_id == $control and .valid == true and
        (.resolved_state_topic | startswith($namespace)))
    ' <<<"$RESPONSE_BODY" >/dev/null || {
    jq . <<<"$RESPONSE_BODY" >&2
    fail "同型柜体 $PEER_CABINET 未提供隔离的 $BUTTON_ID 状态话题"
  }
  PEER_BUTTON_STATE="$(
    jq -r --arg id "$BUTTON_ID" '
      .controls[] | select(.control_id == $id) | .current_state
    ' <<<"$RESPONSE_BODY"
  )"
  PEER_BUTTON_SEQUENCE="$(
    jq -r --arg id "$BUTTON_ID" '
      .controls[] | select(.control_id == $id) | .transition_sequence
    ' <<<"$RESPONSE_BODY"
  )"
fi

start_sse_capture

if [[ "$RUN_NAVIGATION" == "true" ]]; then
  # This success-path check validates final pose/error.  Standard Nav2's
  # aborted result does not reliably distinguish a collision-blocked route
  # from another unreachable target, so this script does not claim that
  # failure classification.
  printf '\n[navigate] %s\n' "$CABINET"
  submit_task navigate "$(
    jq -cn --arg cabinet "$CABINET" '{cabinet:$cabinet}'
  )"
  NAVIGATION_TASK_ID="$ACTIVE_TASK_ID"
  wait_for_task "$NAVIGATION_TASK_ID" success
  jq -e --arg cabinet "$CABINET" \
    --argjson position_tolerance "$NAVIGATION_POSITION_TOLERANCE_M" '
    .request.cabinet == $cabinet and
    .result.cabinet == $cabinet and
    (.result.final_pose.x | numbers) and
    (.result.final_pose.y | numbers) and
    (.result.final_pose.yaw | numbers) and
    .result.error.position_m <= $position_tolerance and
    .result.error.yaw_rad <= 0.25 and
    (.result.duration_seconds >= 0)
  ' <<<"$TASK_BODY" >/dev/null || {
    jq . <<<"$TASK_BODY" >&2
    fail "导航任务结果缺少终点、误差或耗时"
  }
  COMPLETED_TASKS=$((COMPLETED_TASKS + 1))
  CURRENT_STATION_CONTROL=""
fi

# Omit force deliberately: the Web API must apply the documented 5 N default.
DEFAULT_FORCE_BODY="$(
  jq -cn --arg cabinet "$CABINET" --arg control "$BUTTON_ID" \
    '{cabinet:$cabinet, control_id:$control, command:"press"}'
)"
run_successful_operation "$BUTTON_ID" "$DEFAULT_FORCE_BODY"
jq -e '
  # The request preserves omission as null so the selected control catalog,
  # rather than the Web gateway, remains the source of the default force.
  .request.force == null and .result.requested_force == 5 and
  .result.button_triggered == true and
  .result.actual_displacement >= 0.006 and
  .result.estimated_force >= 4.8
' <<<"$TASK_BODY" >/dev/null || {
  jq . <<<"$TASK_BODY" >&2
  fail "默认 5 N 操作没有产生达到阈值的真实按钮位移"
}

printf '\n[force] %s -> 4 N structured failure\n' "$BUTTON_ID"
navigate_for_control "$BUTTON_ID"
LOW_FORCE_BODY="$(
  jq -cn --arg cabinet "$CABINET" --arg control "$BUTTON_ID" \
    '{cabinet:$cabinet, control_id:$control, command:"press", force:4}'
)"
submit_task operate "$LOW_FORCE_BODY"
LOW_FORCE_TASK_ID="$ACTIVE_TASK_ID"
wait_for_task "$LOW_FORCE_TASK_ID" failed insufficient_force
jq -e '
  .request.force == 4 and .result.requested_force == 4 and
  .result.button_triggered == false and
  .result.actual_displacement > 0 and
  .result.actual_displacement < 0.006 and
  (.failure_reason | contains("力度不足"))
' <<<"$TASK_BODY" >/dev/null || {
  jq . <<<"$TASK_BODY" >&2
  fail "4 N 任务未返回实际位移、未触发和“力度不足”结果"
}
EXPECTED_FAILURE_TASKS=$((EXPECTED_FAILURE_TASKS + 1))

if [[ "$RUN_EXHAUSTIVE" != "true" && -n "$UNREACHABLE_ID" ]]; then
  run_unreachable_operation "$UNREACHABLE_ID" "$UNREACHABLE_REASON"
fi

if [[ -n "$PEER_CABINET" ]]; then
  get_json "/cabinets/$PEER_CABINET/controls"
  jq -e --arg id "$BUTTON_ID" --arg state "$PEER_BUTTON_STATE" \
    --argjson sequence "$PEER_BUTTON_SEQUENCE" '
      any(.controls[];
        .control_id == $id and .valid == true and
        .current_state == $state and .transition_sequence == $sequence)
    ' <<<"$RESPONSE_BODY" >/dev/null || {
    jq . <<<"$RESPONSE_BODY" >&2
    fail "$CABINET 的同 ID Action 污染了 $PEER_CABINET 的物理状态"
  }
  printf '  PASS: %s 与 %s 的同 ID 控件状态保持隔离\n' \
    "$CABINET" "$PEER_CABINET"
fi

run_representative_rotary_controls() {
  local control_id=""
  local initial_state=""
  local target_state=""
  local control_type
  for control_type in 1 3; do
    control_id="$(
      jq -r --argjson type "$control_type" '
        first(.controls[] |
        select(.control_type == $type and .operable == true and
               .valid == true and (.current_state | length) > 0) |
        .control_id) // ""
      ' <<<"$CONTROLS_BODY"
    )"
    [[ -n "$control_id" ]] || continue
    initial_state="$(
      jq -r --arg id "$control_id" '
        .controls[] | select(.control_id == $id) | .current_state
      ' <<<"$CONTROLS_BODY"
    )"
    target_state="$(
      jq -r --arg id "$control_id" --arg current "$initial_state" '
        first(.controls[] | select(.control_id == $id) |
        .state_ids[] | select(. != $current)) // ""
      ' <<<"$CONTROLS_BODY"
    )"
    run_state_round_trip "$control_id" "$initial_state" "$target_state"
  done
}

run_exhaustive_controls() {
  local control_id=""
  local control_type=""
  local initial_state=""
  local target_state=""
  local row
  mapfile -t rows < <(
    jq -r '.controls[] | select(.operable == true) |
      [.control_id, (.control_type | tostring), .current_state] | @tsv' \
      <<<"$CONTROLS_BODY"
  )
  for row in "${rows[@]}"; do
    IFS=$'\t' read -r control_id control_type initial_state <<<"$row"
    if [[ "$control_type" == "0" ]]; then
      [[ "$control_id" == "$BUTTON_ID" ]] && continue
      run_successful_operation "$control_id" "$(
        jq -cn --arg cabinet "$CABINET" --arg control "$control_id" \
          '{cabinet:$cabinet, control_id:$control, command:"press"}'
      )"
      continue
    fi
    while IFS= read -r target_state; do
      [[ -n "$target_state" && "$target_state" != "$initial_state" ]] ||
        continue
      run_state_round_trip "$control_id" "$initial_state" "$target_state"
    done < <(
      jq -r --arg id "$control_id" '
        .controls[] | select(.control_id == $id) | .state_ids[]
      ' <<<"$CONTROLS_BODY"
    )
  done
  while IFS=$'\t' read -r control_id reason; do
    run_unreachable_operation "$control_id" "$reason"
  done < <(
    jq -r '.controls[] | select(.operable == false) |
      [.control_id, .unavailable_reason] | @tsv' <<<"$CONTROLS_BODY"
  )
}

if [[ "$RUN_EXHAUSTIVE" == "true" ]]; then
  run_exhaustive_controls
  [[ "$UNREACHABLE_TASKS" == "$UNAVAILABLE_COUNT" ]] ||
    fail "全量验收应提交 $UNAVAILABLE_COUNT 个不可达控件，实际 $UNREACHABLE_TASKS 个"
  VALIDATED_OPERABLE_COUNT="${#VALIDATED_OPERABLE_CONTROLS[@]}"
  [[ "$VALIDATED_OPERABLE_COUNT" == "$OPERABLE_COUNT" ]] ||
    fail "全量验收应成功操作 $OPERABLE_COUNT 个可操作控件，实际 $VALIDATED_OPERABLE_COUNT 个"
else
  run_representative_rotary_controls
fi

# SET_STATE alone does not cover the other advertised rotary commands.  Run
# both against one limited knob in representative and exhaustive validation.
run_unavailable_knob_command_contracts \
  "$UNAVAILABLE_KNOB_ID" "$UNAVAILABLE_KNOB_REASON"

if [[ "$RUN_CONTRACT_TESTS" == "true" ]]; then
  printf '\n[contract] global conflict and task cancellation\n'
  CANCEL_CONTROL="$(
    jq -r 'first(.controls[] |
      select((.control_type == 3 or .control_type == 1) and
             .operable == true) | .control_id) // ""' \
      <<<"$CONTROLS_BODY"
  )"
  if [[ -z "$CANCEL_CONTROL" ]]; then
    printf '  NOT APPLICABLE: no operable knob or door for a long-running cancel task; all unavailable controls were still submitted above.\n'
  else
    CANCEL_INITIAL="$(
      jq -r --arg id "$CANCEL_CONTROL" '
        .controls[] | select(.control_id == $id) | .current_state
      ' <<<"$CONTROLS_BODY"
    )"
    CANCEL_TARGET="$(
      jq -r --arg id "$CANCEL_CONTROL" --arg current "$CANCEL_INITIAL" '
        first(.controls[] | select(.control_id == $id) |
        .state_ids[] | select(. != $current)) // ""
      ' <<<"$CONTROLS_BODY"
    )"
    CANCEL_BODY="$(
      jq -cn --arg cabinet "$CABINET" --arg control "$CANCEL_CONTROL" \
        --arg state "$CANCEL_TARGET" \
        '{cabinet:$cabinet, control_id:$control,
          command:"set_state", target_state:$state}'
    )"
    navigate_for_control "$CANCEL_CONTROL"
    PENDING_CLEANUP_BODY="$(
      jq -cn --arg cabinet "$CABINET" --arg control "$CANCEL_CONTROL" \
        --arg state "$CANCEL_INITIAL" \
        '{cabinet:$cabinet, control_id:$control,
          command:"set_state", target_state:$state}'
    )"
    submit_task operate "$CANCEL_BODY"
    CANCEL_TASK_ID="$ACTIVE_TASK_ID"
    request_json POST /task/navigate 409 "$(
      jq -cn --arg cabinet "$CABINET" --arg control "$CANCEL_CONTROL" \
        '{cabinet:$cabinet, control_id:$control}'
    )"
    jq -e --arg active "$CANCEL_TASK_ID" \
      '.details.active_task_id == $active' <<<"$RESPONSE_BODY" >/dev/null ||
      fail "409 并发响应未包含当前活跃 task_id"
    request_json POST "/task/$CANCEL_TASK_ID/cancel" 202 '{}'
    wait_for_task "$CANCEL_TASK_ID" canceled canceled
    # Recovery should restore the initial state.  The pending inverse operation
    # remains armed for the EXIT trap if this confirmation fails.
    sleep 1
    get_json "/cabinets/$CABINET/controls"
    if jq -e --arg id "$CANCEL_CONTROL" --arg state "$CANCEL_INITIAL" '
      any(.controls[];
        .control_id == $id and .valid == true and .in_motion == false and
        .current_state == $state)
    ' <<<"$RESPONSE_BODY" >/dev/null; then
      PENDING_CLEANUP_BODY=""
    else
      run_successful_operation "$CANCEL_CONTROL" "$PENDING_CLEANUP_BODY"
      PENDING_CLEANUP_BODY=""
    fi
  fi
fi

validate_sse_capture
printf '\nPASS: 多柜体 Web 任务验收完成；成功任务=%d；预期失败=%d；力度不足和不可达均按合同返回。\n' \
  "$COMPLETED_TASKS" "$EXPECTED_FAILURE_TASKS"
