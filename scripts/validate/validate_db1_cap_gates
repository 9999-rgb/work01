def _latch_home_status(message: str) -> str:
    """闩锁/电缸 home 证据：只按 operator 文本显式关键词存在性取证。

    取不到就返回 not_verified —— 绝不用 drawer 的 closed 状态推导闩锁。
    """
    lowered = (message or "").lower()
    latchish = any(keyword in lowered for keyword in _LATCH_KEYWORDS)
    homeish = any(keyword in lowered for keyword in _HOME_KEYWORDS)
    if latchish and homeish:
        return "verified_by_operator_text_latch_and_home"
    if latchish:
        return "verified_by_operator_text_latch"
    if homeish:
        return "verified_by_operator_text_home"
    return "not_verified"


def _fetch_controls(api: str, auth: Dict[str, str],
                    cabinet: str) -> List[Dict[str, Any]]:
    response = _request("GET", api, "/cabinets/" + cabinet + "/controls",
                        headers=auth)
    return response.get("controls") or []


def _execute_gate(gate: Dict[str, Any], api: str, auth: Dict[str, str],
                  cabinet: str, drawer: str,
                  drawer_item: Dict[str, Any],
                  baseline: List[Dict[str, Any]],
                  cap: int, index: int, task_timeout: float,
                  track: Optional[Callable[[str], None]],
                  gen_state: Dict[str, Any],
                  closed_expected: float) -> None:
    """执行单门并原地填 gate 条目；失败以异常抛出（异常前字段已尽量填好）。

    调用方负责先 _set_operator_cap(cap) 并标记 guard.mark_param_changed()；
    本函数从提交 operate 任务开始评估。
    """
    gate.update({
        "cap": cap, "sequence": index, "started_at": _now_iso(),
        "status": "running", "task_id": None,
        "catalog_generation": None, "elapsed_s": None,
    })
    started = time.monotonic()
    label = "gate-cap%d-%d" % (cap, index)
    fail_reason: Optional[str] = None

    def record_track(task_id: str) -> None:
        # 接受即登记 task_id（即使后续轮询超时/中断，本门条目的任务 id 也在，
        # 满足 §5.2 #3）；再交给收尾守卫登记活动任务。
        gate["task_id"] = task_id
        if track is not None:
            track(task_id)

    try:
        terminal = _submit_and_wait_terminal(
            api, auth, "operate",
            {"cabinet": cabinet, "control_id": drawer,
             "command": "set_state", "target_state": "open"},
            task_timeout, label, track=record_track)
        result = _require_success(terminal, "gate cap%d" % cap)
        gate["catalog_generation"] = result.get("catalog_generation")

        message = str(result.get("message") or "")
        marker = "debug_stage_cap=%d reached" % cap

        # 本次任务作用域结果必须带本门的封顶标记（§5.2 #3）。
        if marker not in message:
            fail_reason = ("本次任务结果缺少封顶标记 %r（result.message=%r）"
                           % (marker, message[:300]))
        # 本次任务终态物理/恢复/释放证据（§5.2 #6）。
        evidence: Dict[str, Any] = {}
        missing_evidence: List[str] = []
        for flag in EVIDENCE_FLAGS:
            value = result.get(flag)
            if value is True:
                evidence[flag] = True
            elif value is False:
                evidence[flag] = False
                missing_evidence.append(flag)
            else:
                evidence[flag] = None
                missing_evidence.append(flag)
        gate["evidence"] = evidence
        gate["evidence"]["result_message"] = message
        gate["evidence"]["latch_or_home_evidence"] = _latch_home_status(message)
        if fail_reason is None and missing_evidence:
            fail_reason = ("本次任务结果缺少真值终态证据：%s"
                           % ", ".join(missing_evidence))

        # 本次任务请求身份必须与本门目标一致（§5.2 #3 task_id 关联）。
        if fail_reason is None:
            request = terminal.get("request") or {}
            if (request.get("cabinet") != cabinet
                    or request.get("control_id") != drawer):
                fail_reason = ("本次任务请求身份与目标不符：%s" % json.dumps(
                    {key: request.get(key) for key in
                     ("cabinet", "control_id")}, ensure_ascii=False))

        # 场景代次一致性（跨门代次变化说明夹具重生了，基线作废）。
        generation = gate["catalog_generation"]
        if isinstance(generation, bool) or not isinstance(generation, int):
            generation = None
        if generation is not None:
            if gen_state["first"] is None:
                gen_state["first"] = generation
            elif gen_state["first"] != generation:
                fail_reason = ("场景代次从 %s 变为 %s（夹具可能重生）"
                               % (gen_state["first"], generation))

        if fail_reason is None:
            gate["evidence"]["physical_outcome"] = {
                "final_state": result.get("final_state"),
                "final_position": _json_number(result.get("final_position")),
                "peak_position": _json_number(result.get("peak_position")),
                "diagnostic_stage": result.get("diagnostic_stage"),
            }

        # 门后抽屉必须回到 closed 静止 detent（当前有效/in_motion，有限位置）。
        if fail_reason is None:
            controls_now = _fetch_controls(api, auth, cabinet)
            settled_item = control_by_id(controls_now, drawer)
            try:
                require_stationary_and_valid(settled_item, drawer, label)
            except Db1ValidationError as error:
                fail_reason = str(error)
            if fail_reason is None and settled_item.get("current_state") != "closed":
                fail_reason = ("门后 %s 状态为 %s，期望 closed"
                               % (drawer, settled_item.get("current_state")))
            if fail_reason is None:
                try:
                    position = require_position_number(
                        settled_item.get("current_position"),
                        "%s 门后 current_position" % drawer)
                except Db1ValidationError as error:
                    fail_reason = str(error)
                    position = None
                if (fail_reason is None
                        and abs(position - closed_expected) > CLOSED_EPS_M):
                    fail_reason = ("门后 %s 位置 %.4f 超出 closed 带宽 %.3f"
                                   % (drawer, position, CLOSED_EPS_M))
            gate["drawer_after"] = {
                "state": settled_item.get("current_state"),
                "position": _json_number(settled_item.get("current_position")),
                "in_motion": settled_item.get("in_motion"),
                "valid": settled_item.get("valid"),
            }
            if fail_reason is None:
                after = untouched_snapshot(controls_now, drawer)
                try:
                    require_untouched_unchanged(baseline, after, drawer)
                except Db1ValidationError as error:
                    fail_reason = str(error)
    finally:
        # 无论成功/失败/未预期异常，都记录该门耗时（§5.2 #3 每门开始时间）。
        gate["elapsed_s"] = round(time.monotonic() - started, 1)

    if fail_reason is not None:
        gate["status"] = "FAIL"
        raise GateError("cap%d 第 %d 次失败：%s" % (cap, index, fail_reason))
    gate["status"] = "PASS"


def _parse_arguments() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="逐门驱动 db1 AGENT §7.2 分级封顶验收（cap1→cap8）。")
    parser.add_argument("--api", default=os.environ.get("XCZS_CONTROL_API_URL",
                                                        DEFAULT_API))
    parser.add_argument("--token", default=os.environ.get("XCZS_CONTROL_TOKEN", ""))
    parser.add_argument("--username",
                        default=os.environ.get("XCZS_CONTROL_USERNAME", ""))
    parser.add_argument("--password",
                        default=os.environ.get("XCZS_CONTROL_PASSWORD", ""))
    parser.add_argument("--scene", default=DEFAULT_SCENE)
    parser.add_argument("--cabinet", default=DEFAULT_CABINET)
    parser.add_argument("--drawer", default=DEFAULT_DRAWER)
    parser.add_argument("--operator-node", default=DEFAULT_OPERATOR)
    parser.add_argument(
        "--caps",
        default="1,2,2,2,3,3,3,4,5,6,7,8",
        help="门序列，逗号分隔；默认 1,2,2,2,3,3,3,4,5,6,7,8",
    )
    parser.add_argument("--no-navigate", action="store_true",
                        help="跳过 db1 专用导航（已在工位时使用）")
    parser.add_argument("--timeout", type=int, default=360,
                        help="单个任务超时秒数")
    return parser.parse_args()


def main() -> int:
    args = _parse_arguments()
    api = args.api.rstrip("/")
    task_timeout = float(args.timeout)
    scene, cabinet, drawer = args.scene, args.cabinet, args.drawer
    caps = [int(item) for item in args.caps.split(",") if item.strip() != ""]
    if not caps or any(cap < 1 or cap > 8 for cap in caps):
        _log("ERROR: --caps 必须是非空 1..8 的整数序列")
        print(json.dumps({"ok": False, "error": "无效 caps"}, ensure_ascii=False))
        return 1
    summary: Dict[str, Any] = {
        "driver": "validate_db1_cap_gates",
        "scene": scene, "cabinet": cabinet, "drawer": drawer,
        "caps": caps, "gates": [], "ok": False,
        "cleanup": {"param_restored": None,
                    "note": "未进入门序列（无需清理）"},
    }
    return_code = 1
    guard: Optional[_RunGuard] = None
    try:
        auth = _configure_auth(api, args.token, args.username,
                               args.password or os.environ.get("XCZS_ADMIN_PASSWORD", ""))
        _log("[scene] 读取当前活动场景。")
        scenes = _request("GET", api, "/scenes", headers=auth)
        active = scenes.get("active")
        summary["scene_before"] = active
        if active != scene:
            _log("[scene] 活动场景 %s → 显式切换到 %s。" % (active, scene))
            switched = _request("POST", api, "/scene/switch", {"name": scene},
                                headers=auth)
            if switched.get("status") not in ("switched", "unchanged", "reconciled"):
                raise GateError("场景切换失败：%s"
                                % json.dumps(switched, ensure_ascii=False))
        summary["scene_after"] = scene

        catalog = _catalog_ready(api, auth, cabinet, drawer)
        controls = catalog.get("controls") or []
        drawer_item = control_by_id(controls, drawer)
        if drawer_item.get("control_type") != TYPE_DRAWER:
            raise GateError("%s 类型非 drawer" % drawer)
        if drawer_item.get("required_toolset") != "A" or not drawer_item.get("operable"):
            raise GateError("%s 不可操作（toolset=%s operable=%s）"
                            % (drawer, drawer_item.get("required_toolset"),
                               drawer_item.get("operable")))
        summary["catalog_active_toolset"] = catalog.get("catalog_active_toolset")
        _log("[catalog] %s type=drawer operable toolset=A 就绪。" % drawer)

        # §5.2 #1：保存原参数；独占验收要求起始 cap=0，非 0 拒绝（不改动）。
        original_cap = _operator_param_get(args.operator_node)
        summary["debug_stage_cap_before"] = original_cap
        if original_cap != 0:
            raise GateError(
                "独占验收要求 operator debug_stage_cap 起始为 0，实际为 %d；"
                "请先手动复位后再运行。" % original_cap)

        # §5.2 #4：记录非目标控件基线（按 control_id 集合，排除 db1）。
        baseline = untouched_snapshot(controls, drawer)
        require_others_stable(baseline, cabinet)
        _log("[baseline] 已记录 %d 个非目标控件基线。" % len(baseline))

        if not args.no_navigate:
            _log("[navigate] %s -> %s 工位。" % (cabinet, drawer))
            nav = _submit_and_wait_terminal(
                api, auth, "navigate", {"cabinet": cabinet,
                                        "control_id": drawer},
                task_timeout, "navigate")
            result = _require_success(nav, "navigate")
            error = result.get("error") or {}
            summary["first_nav"] = {"ok": True,
                                    "position_error_m": error.get("position_m"),
                                    "yaw_error_rad": error.get("yaw_rad")}
            _log("[navigate] 完成，误差 %.3f m / %.3f rad。"
                 % (error.get("position_m") or 0, error.get("yaw_rad") or 0))
        else:
            summary["first_nav"] = {"ok": True, "skipped": True}
            _log("[navigate] --no-navigate，假定已在工位。")

        # 基线必须是干净静止的 closed（门序列从不真正打开，只做分级动作）。
        baseline_item = control_by_id(_fetch_controls(api, auth, cabinet), drawer)
        require_stationary_and_valid(baseline_item, drawer, "基线")
        if baseline_item.get("current_state") != "closed":
            raise GateError("db1 基线状态 %s，门序列要求 closed；请先归位。"
                            % baseline_item.get("current_state"))
        closed_expected = expected_position_for_state(drawer_item, "closed")
        baseline_pos = require_position_number(
            baseline_item.get("current_position"),
            "db1 基线 current_position")
        if abs(baseline_pos - closed_expected) > CLOSED_EPS_M:
            raise GateError("db1 基线位置 %.4f 超出 closed 带宽 %.3f"
                            % (baseline_pos, CLOSED_EPS_M))
        summary["closed_detent_m"] = closed_expected

        guard = _RunGuard(api, auth, args.operator_node, original_cap)
        gen_state: Dict[str, Any] = {"first": None}
        all_passed = False
        try:
            for index, cap in enumerate(caps, start=1):
                _log("\n[gate %d/%d] debug_stage_cap=%d" % (index, len(caps), cap))
                gate: Dict[str, Any] = {
                    "cap": cap, "sequence": index, "started_at": _now_iso(),
                    "status": "running", "task_id": None,
                    "catalog_generation": None, "elapsed_s": None,
                }
                try:
                    # §5.2 #2 守护：先设门参数并立即登记已改动；门内任何后续
                    # 异常/超时/KeyboardInterrupt 都会由 finally 复原参数。
                    _set_operator_cap(args.operator_node, cap)
                    guard.mark_param_changed()
                    _execute_gate(
                        gate, api, auth, cabinet, drawer,
                        drawer_item, baseline, cap, index,
                        task_timeout, guard.track_task, gen_state,
                        closed_expected)
                    gate["first_fail"] = None
                    summary["gates"].append(gate)
                    _log("[gate %d/%d] PASS (%.1fs)"
                         % (index, len(caps), gate.get("elapsed_s") or 0))
                except KeyboardInterrupt:
                    _log("[gate %d/%d] 收到 KeyboardInterrupt。"
                         % (index, len(caps)))
                    gate["status"] = "FAIL"
                    gate["first_fail"] = "KeyboardInterrupt"
                    summary["gates"].append(gate)
                    summary.setdefault("first_fail_gate", {
                        "cap": cap, "sequence": index,
                        "reason": "KeyboardInterrupt"})
                    raise
                except BaseException as error:
                    reason = _plain(error)
                    gate["status"] = "FAIL"
                    gate["first_fail"] = reason
                    summary["gates"].append(gate)
                    summary.setdefault("first_fail_gate", {
                        "cap": cap, "sequence": index, "reason": reason})
                    _log("[gate %d/%d] FAIL：%s" % (index, len(caps), reason))
                    raise
            all_passed = True
        finally:
            # §5.2 #2：无论成功/失败/超时/KeyboardInterrupt，取消本脚本仍活动
            # 的任务并恢复原参数（guard 只在参数已被读取后创建）。
            if guard is not None:
                cleanup = guard.cleanup_and_restore()
                summary["cleanup"] = cleanup
                _log("[cleanup] %s" % json.dumps(cleanup, ensure_ascii=False))
                if (cleanup.get("param_restored") is not True
                        and all_passed):
                    raise GateError("门序列完成但参数恢复失败：%s"
                                    % (cleanup.get("error") or "未知"))
        summary["ok"] = True
        return_code = 0
    except KeyboardInterrupt:
        summary["ok"] = False
        summary["interrupted"] = True
        _log("KeyboardInterrupt：已进入 cleanup 收尾。")
        return_code = 130
    except (GateError, WebError, Db1ValidationError) as error:
        summary["ok"] = False
        summary["error"] = str(error)
        _log("ERROR: %s" % error)
        return_code = 1
    finally:
        print(json.dumps(summary, ensure_ascii=False, indent=2))
    return return_code


if __name__ == "__main__":
    sys.exit(main())
