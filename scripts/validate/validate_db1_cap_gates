class WebError(Exception):
    def __init__(self, status: int, payload: Dict[str, Any]) -> None:
        super().__init__(
            "HTTP %d: %s" % (status, payload.get("error", json.dumps(payload)))
        )
        self.status = status
        self.payload = payload


class GateError(Exception):
    """门失败（人类可读原因）。"""


def _log(message: str) -> None:
    print(message, file=sys.stderr)


def _now_iso() -> str:
    return datetime.datetime.now().isoformat(timespec="seconds")


def _json_number(value: Any) -> Any:
    """位置数值只允许有限数；NaN/Inf/None 一律转 None，避免输出非法 JSON。"""
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return None
    try:
        number = float(value)
    except (TypeError, ValueError):
        return None
    return number if math.isfinite(number) else None


def _plain(exc: BaseException) -> str:
    return str(exc) or exc.__class__.__name__


def _configure_auth(api: str, token: str, username: str, password: str) -> Dict[str, str]:
    """返回 {Authorization, Content-Type...} 风格最小封装所需头，或去 /auth/login。

    Web 鉴权默认关闭（auth_enabled=False），无令牌时 API 直接返回 200；因此
    token 为空且未提供用户名时不再强行走 /auth/login。
    """
    if token:
        return {"Authorization": "Bearer " + token}
    if password and not username:
        username = "admin"
    if username and not password:
        raise GateError("提供用户名时必须同时提供密码")
    if not username:
        return {}
    payload = _request("POST", api, "/auth/login",
                       {"username": username, "password": password})
    token = payload.get("access_token")
    if not isinstance(token, str) or not token:
        raise GateError("/auth/login 未返回 access_token")
    return {"Authorization": "Bearer " + token}


def _request(
    method: str, api: str, path: str,
    body: Optional[Dict[str, Any]] = None,
    headers: Optional[Dict[str, str]] = None,
) -> Dict[str, Any]:
    payload = None
    request_headers = {"Accept": "application/json"}
    if headers:
        request_headers.update(headers)
    if body is not None:
        request_headers["Content-Type"] = "application/json"
        payload = json.dumps(body).encode("utf-8")
    request = urllib.request.Request(
        api.rstrip("/") + path, data=payload, method=method,
        headers=request_headers,
    )
    try:
        with urllib.request.urlopen(request, timeout=20.0) as response:
            raw = response.read()
    except urllib.error.HTTPError as error:
        detail = error.read().decode("utf-8", "replace")
        try:
            parsed = json.loads(detail)
        except (ValueError, TypeError):
            parsed = {"error": detail or error.reason}
        raise WebError(error.code, parsed) from error
    except urllib.error.URLError as error:
        raise GateError("%s %s 请求失败：%s" % (method, path, error.reason))
    if not raw:
        raise GateError("%s %s 返回空响应" % (method, path))
    try:
        return json.loads(raw.decode("utf-8"))
    except ValueError:
        raise GateError("%s %s 返回的不是有效 JSON" % (method, path))


def _wait_for_id(api: str, auth: Dict[str, str], task_id: str,
                 task_timeout: float, label: str) -> Dict[str, Any]:
    deadline = time.monotonic() + task_timeout
    while True:
        snapshot = _request("GET", api, "/task/" + urllib.parse.quote(task_id)
                            + "/status", headers=auth)
        status = snapshot.get("status")
        if status in TERMINAL_STATUSES:
            return snapshot
        if time.monotonic() > deadline:
            raise GateError("%s 任务 %s 在 %d 秒内未结束（status=%s）"
                            % (label, task_id, int(task_timeout), status))
        time.sleep(POLL_INTERVAL_S)


def _submit_and_wait_terminal(api: str, auth: Dict[str, str], task_type: str,
                              body: Dict[str, Any], task_timeout: float,
                              label: str,
                              track: Optional[Callable[[str], None]] = None,
                              ) -> Dict[str, Any]:
    """提交任务并轮询到终态；409 占用时先等占用任务结束再重试一次。

    ``track`` 为本脚本自行提交的任务 id 回调（供收尾取消），409 占用的他人
    任务不回调。
    """
    accepted = None
    for attempt in (1, 2):
        try:
            accepted = _request("POST", api, "/task/" + task_type, body,
                                headers=auth)
            break
        except WebError as error:
            busy_id = (
                (error.payload.get("details") or {}).get("active_task_id")
                if attempt == 1 else None
            )
            if error.status != 409 or not isinstance(busy_id, str) or not busy_id:
                raise
            _log("[%s] 全局任务被 %s 占用，等待其结束后重试。" % (label, busy_id))
            _wait_for_id(api, auth, busy_id, task_timeout, "preceding")
    if accepted is None:
        raise GateError("%s 两次提交均被全局占用" % label)
    task_id = accepted.get("task_id")
    if not isinstance(task_id, str) or not task_id:
        raise GateError("%s 未返回合规 task_id" % label)
    if track is not None:
        track(task_id)
    return _wait_for_id(api, auth, task_id, task_timeout, label)


def _catalog_ready(api: str, auth: Dict[str, str], cabinet: str,
                   drawer: str) -> Dict[str, Any]:
    deadline = time.monotonic() + CATALOG_READY_TIMEOUT_S
    last_reason = ""
    while True:
        response = _request("GET", api, "/cabinets/" + cabinet + "/controls",
                            headers=auth)
        controls = response.get("controls")
        if (response.get("available") is True and isinstance(controls, list)
                and any(item.get("control_id") == drawer for item in controls)):
            return response
        last_reason = (response.get("catalog_coherence_reason")
                       or "controls 未就绪")
        if time.monotonic() > deadline:
            raise GateError("%s 控件目录 %d 秒内未就绪：%s"
                            % (cabinet, CATALOG_READY_TIMEOUT_S, last_reason))
        time.sleep(POLL_INTERVAL_S)


def _require_success(snapshot: Dict[str, Any], label: str) -> Dict[str, Any]:
    """任务终态必须为 success；否则抛出人类可读原因。返回本次任务 result。"""
    status = snapshot.get("status")
    if status != "success":
        reason = snapshot.get("failure_reason") or snapshot.get("message") or ""
        raise GateError("%s 任务以 %s 结束：%s" % (label, status, reason))
    result = snapshot.get("result")
    return result if isinstance(result, dict) else {}


