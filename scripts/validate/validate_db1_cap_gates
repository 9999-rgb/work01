# operator debug_stage_cap 参数读写（走 ros2 CLI）。
# ---------------------------------------------------------------------------
def _operator_param_get(operator: str) -> int:
    env = dict(os.environ)
    result = subprocess.run(
        ["ros2", "param", "get", operator, "debug_stage_cap"],
        env=env, capture_output=True, text=True, timeout=60,
    )
    if result.returncode != 0:
        raise GateError(
            "ros2 param get %s debug_stage_cap 失败：%s"
            % (operator, (result.stderr or result.stdout).strip()))
    match = re.search(r"[-+]?\d+", result.stdout)
    if match is None:
        raise GateError(
            "ros2 param get 未返回可解析整数（debug_stage_cap）：%s"
            % result.stdout.strip())
    return int(match.group(0))


def _set_operator_cap(operator: str, cap: int) -> None:
    env = dict(os.environ)
    result = subprocess.run(
        ["ros2", "param", "set", operator, "debug_stage_cap", str(cap)],
        env=env, capture_output=True, text=True, timeout=60,
    )
    if result.returncode != 0:
        raise GateError(
            "ros2 param set %s debug_stage_cap=%d 失败：%s"
            % (operator, cap, (result.stderr or result.stdout).strip()))
    if _operator_param_get(operator) != cap:
        raise GateError(
            "ros2 param get 未确认 debug_stage_cap=%d" % cap)
    _log("[param] operator debug_stage_cap=%d 已生效。" % cap)


# ---------------------------------------------------------------------------
# 收尾守卫：取消本脚本仍活动的任务→等待终态→恢复原参数（AGENT §5.2 #2）。
# ---------------------------------------------------------------------------
class _RunGuard:
    """封装本脚本改动过的外部状态（参数 + 自行提交的任务），供 finally 复原。"""

    def __init__(self, api: str, auth: Dict[str, str], operator: str,
                 original_cap: int) -> None:
        self.api = api
        self.auth = auth
        self.operator = operator
        self.original_cap = original_cap
        self.submitted_task_id: Optional[str] = None
        self.param_changed = False
        self.cleanup: Dict[str, Any] = {
            "param_restored": False,
            "param_original": original_cap,
            "active_task_canceled": None,
            "active_task_terminal": None,
            "note": "",
        }

    def track_task(self, task_id: str) -> None:
        self.submitted_task_id = task_id

    def mark_param_changed(self) -> None:
        self.param_changed = True

    def _task_status(self, task_id: str) -> Optional[Dict[str, Any]]:
        return _request("GET", self.api,
                        "/task/" + urllib.parse.quote(task_id) + "/status",
                        headers=self.auth)

    def cleanup_and_restore(self) -> Dict[str, Any]:
        """取消并等待本脚本仍活动的任务；随后恢复原 debug_stage_cap=0。"""
        errors: List[str] = []
        task_id = self.submitted_task_id
        if task_id is not None:
            try:
                snapshot = self._task_status(task_id)
            except BaseException as error:  # noqa: BLE001 - 收尾必须继续
                errors.append("查询任务 %s 状态失败：%s" % (task_id, _plain(error)))
                snapshot = None
            status = (snapshot or {}).get("status")
            if status in TERMINAL_STATUSES:
                self.cleanup["active_task_canceled"] = False
                self.cleanup["active_task_terminal"] = status
                self.cleanup["note"] = "任务已终态，无需取消"
            elif snapshot is not None:
                self.cleanup["note"] = "取消本脚本提交的仍活动任务 %s" % task_id
                try:
                    _request("POST", self.api,
                             "/task/" + urllib.parse.quote(task_id) + "/cancel",
                             headers=self.auth)
                except BaseException as error:  # noqa: BLE001
                    errors.append("取消任务 %s 失败：%s" % (task_id, _plain(error)))
                terminal = None
                deadline = time.monotonic() + CANCEL_SETTLE_TIMEOUT_S
                while time.monotonic() < deadline:
                    try:
                        current = self._task_status(task_id)
                    except BaseException as error:  # noqa: BLE001
                        errors.append("取消后查询 %s 失败：%s"
                                      % (task_id, _plain(error)))
                        break
                    terminal = (current or {}).get("status")
                    if terminal in TERMINAL_STATUSES:
                        break
                    time.sleep(POLL_INTERVAL_S)
                if terminal in TERMINAL_STATUSES:
                    self.cleanup["active_task_canceled"] = True
                    self.cleanup["active_task_terminal"] = terminal
                else:
                    self.cleanup["active_task_canceled"] = False
                    errors.append("取消后任务 %s 在 %d 秒内未达终态"
                                  % (task_id, CANCEL_SETTLE_TIMEOUT_S))
        # 恢复原参数（=0）。只有当本脚本真的改过参数才执行。
        if self.original_cap is not None and self.param_changed:
            try:
                _set_operator_cap(self.operator, self.original_cap)
                self.cleanup["param_restored"] = True
            except BaseException as error:  # noqa: BLE001 - 恢复必须尽量完成
                self.cleanup["param_restored"] = False
                errors.append("恢复 debug_stage_cap=%s 失败：%s"
                              % (self.original_cap, _plain(error)))
        else:
            self.cleanup["param_restored"] = True
            self.cleanup["note"] = (self.cleanup["note"] or "") + (
                "；参数未改动（原值 %s）" % self.original_cap)
        if errors:
            self.cleanup["error"] = "; ".join(errors)
        return dict(self.cleanup)


