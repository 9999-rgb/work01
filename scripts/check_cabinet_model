def active_joint_groups() -> Dict[str, list]:
    """Arms plus the tool groups mounted by the current ``TOOLSET``.

    Inactive tool groups are absent from the per-toolset controllers / SRDF
    files, so controller-name and joint-coverage checks must not require them.
    """
    groups = dict(JOINT_GROUPS)
    for name in TOOLSET_INACTIVE_GROUPS[TOOLSET]:
        del groups[name]
    return groups


def inactive_contact_links() -> frozenset:
    """Contact links of the toolset that is *not* currently mounted."""
    return TOOLSET_TOOL_CONTACT_LINKS["B" if TOOLSET == "A" else "A"]


TYPE_TO_JOINT = {
    "button": "prismatic",
    "knob": "revolute",
    "switch": "revolute",
    "door": "revolute",
}
EXPECTED_COUNTS = {
    "button": 20,
    "knob": 11,
    "switch": 1,
    "door": 1,
}
ABSOLUTE_ROS_NAME_PATTERN = re.compile(
    r"/(?:[A-Za-z_][A-Za-z0-9_]*)(?:/[A-Za-z_][A-Za-z0-9_]*)*"
)


def fail(message: str) -> None:
    raise RuntimeError(message)


def configured_absolute_ros_name(
    parameters: Dict[str, object], parameter_name: str
) -> str:
    value = parameters.get(parameter_name)
    if not isinstance(value, str) or not ABSOLUTE_ROS_NAME_PATTERN.fullmatch(
        value
    ):
        fail(
            f"Robot adapter {parameter_name} must be an absolute ROS name."
        )
    return value


def text(element: ElementTree.Element, name: str) -> str:
    child = element.find(name)
    if child is None or not (child.text or "").strip():
        fail(f"Plugin control is missing <{name}>.")
    return (child.text or "").strip()


def numbers(value: object, field: str) -> list[float]:
    """Parse a numeric YAML/XML list and reject non-finite values."""
    source = value.split() if isinstance(value, str) else value
    if not isinstance(source, (list, tuple)):
        fail(f"{field} must be a numeric list.")
    try:
        result = [float(item) for item in source]
    except (TypeError, ValueError) as error:
        fail(f"{field} contains a non-number: {error}")
    if not all(math.isfinite(item) for item in result):
        fail(f"{field} contains a non-finite number.")
    return result


def close_lists(left: list[float], right: list[float]) -> bool:
    return len(left) == len(right) and all(
        math.isclose(a, b, rel_tol=0.0, abs_tol=1.0e-6)
        for a, b in zip(left, right)
    )


def validate_rotary_adapter_override(
    control_id: str,
    override: Dict[str, object],
    control: Dict[str, object],
    catalog_parameters: Dict[str, object],
) -> None:
    """Validate robot-specific knob pose/roll/release and IK seed calibration."""
    if "tool_roll_offset" in override:
        roll_offset = override["tool_roll_offset"]
        if control.get("type") != "button":
            fail(
                f"Robot adapter {control_id}.tool_roll_offset is only valid "
                "for button controls."
            )
        if (
            isinstance(roll_offset, bool)
            or not isinstance(roll_offset, (int, float))
            or not math.isfinite(float(roll_offset))
            or abs(float(roll_offset)) > math.pi
        ):
            fail(
                f"Robot adapter {control_id}.tool_roll_offset must be "
                "finite and within [-pi, pi]."
            )
    has_roll = "tool_roll_offsets" in override
    has_release = "detent_release_fraction" in override
    has_ready_seed = "ready_joint_seed" in override
    if has_roll or has_release:
        if control.get("type") != "knob":
            fail(
                f"Robot adapter {control_id} rotary calibration is only valid "
                "for knob controls."
            )
        defaults = catalog_parameters.get("knob_defaults", {})
        if not isinstance(defaults, dict):
            defaults = {}
        state_ids = control.get("state_ids", defaults.get("state_ids"))
        if (
            not isinstance(state_ids, list)
            or not state_ids
            or any(not isinstance(value, str) or not value for value in state_ids)
        ):
            fail(f"Control {control_id} must define non-empty knob state_ids.")
        if has_roll:
            raw_offsets = override.get("tool_roll_offsets")
            expected_count = len(state_ids) ** 2
            if (
                not isinstance(raw_offsets, list)
                or len(raw_offsets) != expected_count
                or any(isinstance(value, bool) for value in raw_offsets)
            ):
                fail(
                    f"Robot adapter {control_id}.tool_roll_offsets must contain "
                    f"exactly {expected_count} numeric entries."
                )
            offsets = numbers(
                raw_offsets,
                f"Robot adapter {control_id}.tool_roll_offsets",
            )
            if any(abs(value) > math.pi for value in offsets):
                fail(
                    f"Robot adapter {control_id}.tool_roll_offsets entries must "
                    "be within [-pi, pi]."
                )
        if has_release:
            fraction = override.get("detent_release_fraction")
            if (
                isinstance(fraction, bool)
                or not isinstance(fraction, (int, float))
                or not math.isfinite(float(fraction))
                or float(fraction) <= 0.5
                or float(fraction) > 1.0
            ):
                fail(
                    f"Robot adapter {control_id}.detent_release_fraction must "
                    "be in (0.5, 1.0]."
                )
    # ready_joint_seed pins the free-space target pose onto one IK branch
    # (e.g. the r_arm_4<0 branch that keeps a button approach continuous), so
    # it is valid for any arm-move-group control -- buttons, knobs and
    # switches.
    if has_ready_seed:
        if control.get("type") not in ("button", "knob", "switch"):
            fail(
                f"Robot adapter {control_id}.ready_joint_seed is only valid "
                "for button, knob or switch controls."
            )
        seed = override.get("ready_joint_seed")
        if not isinstance(seed, dict) or set(seed) != {
            "joint_names",
            "positions",
        }:
            fail(
                f"Robot adapter {control_id}.ready_joint_seed must contain "
                "only joint_names and positions."
            )
        joint_names = seed.get("joint_names")
        positions = seed.get("positions")
        if (
            not isinstance(joint_names, list)
            or not joint_names
            or any(not isinstance(name, str) or not name for name in joint_names)
            or len(joint_names) != len(set(joint_names))
            or not isinstance(positions, list)
            or len(positions) != len(joint_names)
        ):
            fail(
                f"Robot adapter {control_id}.ready_joint_seed requires "
                "equal-length unique joint_names and positions."
            )
        numbers(
            positions,
            f"Robot adapter {control_id}.ready_joint_seed.positions",
        )


def load_config() -> Dict[str, object]:
    with CONFIG.open("r", encoding="utf-8") as stream:
        document = yaml.safe_load(stream)
    try:
        parameters = document["/**"]["ros__parameters"]
    except (KeyError, TypeError) as error:
        fail(f"Invalid cabinet parameter file: {error}")
    if not isinstance(parameters, dict):
        fail("Cabinet ros__parameters must be a mapping.")
    return parameters


def load_scene_config() -> Dict[str, object]:
    with SCENE_CONFIG.open("r", encoding="utf-8") as stream:
        document = yaml.safe_load(stream)
    try:
        node_config = document.get("/**/xczs_cabinet_planning_scene")
        if node_config is None:
            node_config = document["xczs_cabinet_planning_scene"]
        parameters = node_config["ros__parameters"]
    except (KeyError, TypeError) as error:
        fail(f"Invalid cabinet scene parameter file: {error}")
    if not isinstance(parameters, dict):
        fail("Cabinet scene ros__parameters must be a mapping.")
    return parameters


def load_robot_adapter_config() -> Dict[str, object]:
    with ROBOT_ADAPTER_CONFIG.open("r", encoding="utf-8") as stream:
        document = yaml.safe_load(stream)
    try:
        common_parameters = document.get("/**", {}).get(
            "ros__parameters", {}
        )
        node_config = document.get("/**/xczs_cabinet_button_operator")
        if node_config is None:
            node_config = document["xczs_cabinet_button_operator"]
        node_parameters = node_config["ros__parameters"]
    except (KeyError, TypeError) as error:
        fail(f"Invalid cabinet robot-adapter parameter file: {error}")
    if not isinstance(common_parameters, dict) or not isinstance(
        node_parameters, dict
    ):
        fail("Cabinet robot-adapter ros__parameters must be a mapping.")
    parameters = dict(common_parameters)
    parameters.update(node_parameters)
    return parameters


def load_lease_coordinator_config() -> Dict[str, object]:
    with ROBOT_ADAPTER_CONFIG.open("r", encoding="utf-8") as stream:
        document = yaml.safe_load(stream)
    try:
        parameters = document["/xczs_operation_lease_coordinator"][
            "ros__parameters"
        ]
    except (KeyError, TypeError) as error:
        fail(f"Invalid operation-lease coordinator parameters: {error}")
    if not isinstance(parameters, dict):
        fail("Operation-lease coordinator parameters must be a mapping.")
    return parameters


def render_xacro(path: Path, *arguments: str) -> str:
    """Expand a Xacro document and return its serialized XML."""
    try:
        result = subprocess.run(
            ["xacro", str(path), *arguments],
            check=True,
            capture_output=True,
            text=True,
        )
    except FileNotFoundError:
        fail("xacro is unavailable; source /opt/ros/humble/setup.bash first.")
    except subprocess.CalledProcessError as error:
        fail(f"xacro failed:\n{error.stderr}")
    return result.stdout


def expand_xacro(path: Path = XACRO) -> ElementTree.Element:
    arguments = (f"cabinet_name:={CABINET_NAME}",) if path == XACRO else ()
    return ElementTree.fromstring(render_xacro(path, *arguments))


def validate_rcl_parameter_value(robot_description: str) -> None:
    """Ensure gazebo_ros2_control can pass this XML through rcl arguments.

    gazebo_ros2_control hands robot_description to rcl as an unquoted
    ``--param robot_description:=<xml>`` override, which rcl parses as YAML.
    XML comments must therefore stay free of YAML-significant text (a ``:``
    followed by space or end-of-line, a leading ``-``, flow ``{ } [ ] ,``
    indicators, etc.) or the controller manager will refuse to start.
    """
    try:
        import rclpy
    except ImportError:
        fail("rclpy is unavailable; source /opt/ros/humble/setup.bash first.")
    try:
        rclpy.init(
            args=[
                "--ros-args",
                "--param",
                f"robot_description:={robot_description}",
            ]
        )
    except Exception as error:
        fail(
            "Expanded robot_description is not a valid rcl parameter value; "
            f"avoid YAML-significant text in XML comments: {error}"
        )
    finally:
        if rclpy.ok():
            rclpy.shutdown()


def convert_urdf_to_sdf(root: ElementTree.Element) -> ElementTree.Element:
    """Convert an expanded robot to SDF for Gazebo-specific checks."""
    try:
        with tempfile.NamedTemporaryFile(suffix=".urdf") as urdf_file:
            ElementTree.ElementTree(root).write(
                urdf_file,
                encoding="utf-8",
                xml_declaration=True,
            )
            urdf_file.flush()
            result = subprocess.run(
                ["gz", "sdf", "-p", urdf_file.name],
                check=True,
                capture_output=True,
                text=True,
            )
    except FileNotFoundError:
        fail("gz is unavailable; install/source Gazebo Classic first.")
    except subprocess.CalledProcessError as error:
        fail(f"URDF-to-SDF conversion failed:\n{error.stderr}")
    return ElementTree.fromstring(result.stdout)


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description=(
            "Statically verify cabinet Xacro, physical joints, plugin and "
            "catalog config. With no overrides it validates the full built-in "
            "contract (cabinet physics + fixed robot stack). Pass --asset to "
            "validate an imported cabinet asset: structural self-consistency "
            "without the built-in frozen counts/geometry or the fixed robot "
            "stack, and without claiming physical closure."
        )
    )
    parser.add_argument(
        "--controls",
        default=str(CONFIG),
        help="cabinet controls YAML (default: built-in cabinet_controls.yaml)",
    )
    parser.add_argument(
        "--scene",
        default=str(SCENE_CONFIG),
        help="cabinet scene YAML (default: built-in cabinet_scene.yaml)",
    )
    parser.add_argument(
        "--adapter",
        default=str(ROBOT_ADAPTER_CONFIG),
        help="cabinet robot-adapter YAML (default: built-in)",
    )
    parser.add_argument(
        "--xacro",
        default=str(XACRO),
        help="cabinet Xacro (default: built-in control_cabinet.urdf.xacro)",
    )
    parser.add_argument(
        "--cabinet-name",
        default=CABINET_NAME,
        help="cabinet instance name used for the structural expansion",
    )
    parser.add_argument(
        "--toolset",
        choices=["A", "B"],
        default="A",
        help="end-effector toolset validated against the fixed robot stack "
        "(A: three-cylinder + two-cylinder; B: rotate-button + rocker)",
    )
    parser.add_argument(
        "--asset",
        action="store_true",
        help="validate an imported cabinet asset (skip built-in frozen physics "
        "and the fixed robot stack)",
    )
    return parser


def validate_cabinet_asset() -> None:
    """Validate an imported cabinet asset (structural self-consistency).

    Accepts an arbitrary control catalog (no frozen 33 / 20+13 counts, no
    built-in door geometry) and verifies that controls, URDF, state plugin and
    the per-cabinet robot-adapter reachability pairing agree with each other.
    Physical closure is *not* asserted here: the asset's own adapter lists
    only controls that passed runtime physical validation in the positive
    ``operable_control_ids`` capability list.  Every unlisted control is
    unavailable with a concrete shared reason.
    """
    parameters = load_config()
    scene_parameters = load_scene_config()
    robot_parameters = load_robot_adapter_config()
    root = expand_xacro(XACRO)

    control_ids = parameters.get("control_ids")
    controls = parameters.get("controls")
    if not isinstance(control_ids, list) or not isinstance(controls, dict):
        fail("control_ids and controls mappings are required.")
    if not control_ids:
        fail("control_ids must be non-empty.")
    if len(control_ids) != len(set(control_ids)):
        fail("control_ids contains duplicates.")
    if set(control_ids) != set(controls):
        fail("control_ids and controls keys differ.")

    # ── positive robot capability contract (fixed gripper x cabinet) ──
    for legacy_field in (
        "unreachable_control_ids",
        "unreachable_control_reason",
    ):
        if legacy_field in robot_parameters:
            fail(
                f"Robot adapter {legacy_field} is fail-open and no longer "
                "supported; use operable_control_ids."
            )
    operable_control_ids = robot_parameters.get("operable_control_ids", [])
    if "operable_control_ids" in robot_parameters and not operable_control_ids:
        fail(
            "Robot adapter must omit operable_control_ids when empty; ROS 2 "
            "cannot infer an empty parameter sequence type."
        )
    if not isinstance(operable_control_ids, list) or any(
        not isinstance(control_id, str) or not control_id.strip()
        for control_id in operable_control_ids
    ):
        fail("Robot adapter operable_control_ids must be a string list.")
    if len(operable_control_ids) != len(set(operable_control_ids)):
        fail("Robot adapter operable_control_ids contains duplicates.")
    adapter_controls = robot_parameters.get("controls", {})
    if not isinstance(adapter_controls, dict):
        fail("Robot adapter controls must be a mapping.")
    unknown_adapter_ids = (
        set(operable_control_ids) | set(adapter_controls)
    ) - set(control_ids)
    if unknown_adapter_ids:
        fail(
            "Robot adapter references unknown controls: "
            + ", ".join(sorted(unknown_adapter_ids))
            + "."
        )
    navigation_frame = str(robot_parameters.get("navigation_frame", ""))
    for control_id, override in adapter_controls.items():
        if not isinstance(override, dict):
            fail(f"Robot adapter override for {control_id} must be a mapping.")
        if "operable" in override:
            fail(
                "Per-control operable flags are not supported; use the "
                "single operable_control_ids allowlist."
            )
        if "unavailable_reason" in override and not str(
            override["unavailable_reason"]
        ).strip():
            fail(f"Robot adapter {control_id}.unavailable_reason is empty.")
        if (
            control_id in operable_control_ids
            and "unavailable_reason" in override
        ):
            fail(
                f"Operable control {control_id} must not declare an "
                "unavailable_reason."
            )
        control_spec = controls.get(control_id)
        if not isinstance(control_spec, dict):
            fail(f"Control {control_id} configuration must be a mapping.")
        validate_rotary_adapter_override(
            control_id, override, control_spec, parameters
        )
        station = override.get("navigation_station")
        if station is None:
            continue
        if not isinstance(station, dict):
            fail(
                f"Robot adapter {control_id}.navigation_station must "
                "be a mapping."
            )
        allowed_station_fields = {
            "local_anchor",
            "outward_axis",
            "standoff",
            "base_yaw_offset",
            "frame_id",
        }
        unknown_station_fields = set(station) - allowed_station_fields
        if unknown_station_fields:
            fail(
                f"Robot adapter {control_id}.navigation_station has "
                "unknown fields: "
                + ", ".join(sorted(unknown_station_fields))
                + "."
            )
        for vector_name in ("local_anchor", "outward_axis"):
            vector = station.get(vector_name)
            if (
                not isinstance(vector, list)
                or len(vector) != 3
                or any(
                    isinstance(value, bool)
                    or not isinstance(value, (int, float))
                    or not math.isfinite(float(value))
                    for value in vector
                )
            ):
                fail(
                    f"Robot adapter {control_id}.navigation_station."
                    f"{vector_name} must contain three finite numbers."
                )
        if sum(
            float(value) * float(value)
            for value in station["outward_axis"]
        ) <= 1.0e-12:
            fail(
                f"Robot adapter {control_id}.navigation_station."
                "outward_axis must not be zero."
            )
        standoff = station.get("standoff")
        if (
            isinstance(standoff, bool)
            or not isinstance(standoff, (int, float))
            or not math.isfinite(float(standoff))
            or float(standoff) <= 0.0
        ):
            fail(
                f"Robot adapter {control_id}.navigation_station."
                "standoff must be a positive finite number."
            )
        yaw_offset = station.get("base_yaw_offset", 0.0)
        if (
            isinstance(yaw_offset, bool)
            or not isinstance(yaw_offset, (int, float))
            or not math.isfinite(float(yaw_offset))
        ):
            fail(
                f"Robot adapter {control_id}.navigation_station."
                "base_yaw_offset must be finite."
            )
        if station.get("frame_id", navigation_frame) != navigation_frame:
            fail(
                f"Robot adapter {control_id}.navigation_station frame "
                "must match navigation_frame."
            )
    if (
        "inoperable_control_reason" in robot_parameters
        or set(operable_control_ids) != set(control_ids)
    ) and not str(robot_parameters.get("inoperable_control_reason", "")).strip():
        fail("Robot adapter inoperable controls require a shared reason.")
    controls_without_station = sorted(
        control_id
        for control_id in control_ids
        if not isinstance(
            adapter_controls.get(control_id, {}).get("navigation_station"),
            dict,
        )
    )
    if controls_without_station:
        fail(
            "Every submitted control requires an explicit robot-adapter "
            "navigation_station: "
            + ", ".join(controls_without_station)
            + "."
        )
    for control_id in sorted(control_ids):
        if controls[control_id].get("type") in {"button", "knob"}:
            outward = numbers(
                adapter_controls[control_id]["navigation_station"][
                    "outward_axis"
                ],
                f"Robot adapter {control_id} navigation outward axis",
            )
            outward_norm = math.sqrt(sum(value * value for value in outward))
            if not close_lists(
                [value / outward_norm for value in outward],
                [0.0, 0.0, 1.0],
            ):
                fail(
                    f"Front control {control_id} navigation station must "
                    "approach the cabinet from its local +Z face."
                )

    grasp_offset = float(parameters.get("grasp_outward_offset", 0.0))
    if not math.isfinite(grasp_offset) or grasp_offset < 0.020:
        fail(
            "Rotary grasp must remain at least 0.020 m outside the "
            "configured control center."
        )
    for timing_field, minimum in (
        ("grasp_release_settle_duration", 0.30),
        ("grasp_attach_settle_duration", 0.10),
    ):
        value = float(parameters.get(timing_field, 0.0))
        if not math.isfinite(value) or value < minimum:
            fail(f"{timing_field} must last at least {minimum} seconds.")

    # ── controls must map onto URDF joints with matching types ───────────
    joints = {joint.attrib["name"]: joint for joint in root.findall("joint")}
    links = {link.attrib["name"]: link for link in root.findall("link")}
    child_to_joint: Dict[str, object] = {}
    control_child_links: Dict[str, str] = {}
    joint_names: list[str] = []
    for control_id in control_ids:
        spec = controls[control_id]
        if not isinstance(spec, dict):
            fail(f"{control_id} configuration is not a mapping.")
        control_type = str(spec.get("type", ""))
        joint_name = str(spec.get("joint_name", ""))
        expected_joint_type = TYPE_TO_JOINT.get(control_type)
        if expected_joint_type is None:
            fail(f"{control_id} has invalid type '{control_type}'.")
        if control_type != "button":
            required_offset = {
                "knob": 0.020,
                "switch": 0.012,
                "door": 0.0145,
            }[control_type]
            configured_offset = float(
                spec.get("grasp_outward_offset", grasp_offset)
            )
            if (
                not math.isfinite(configured_offset)
                or configured_offset < required_offset
            ):
                fail(
                    f"{control_id} grasp offset does not clear its "
                    "physical collision surface."
                )
        joint_names.append(joint_name)
        joint = joints.get(joint_name)
        if joint is None:
            fail(f"{control_id} joint '{joint_name}' is absent from URDF.")
        if joint.attrib.get("type") != expected_joint_type:
            fail(
                f"{control_id} expected {expected_joint_type}, got "
                f"{joint.attrib.get('type')}."
            )
        child = joint.find("child")
        child_name = child.attrib.get("link", "") if child is not None else ""
        control_child_links[child_name] = control_id
        link = links.get(child_name)
        if link is None or link.find("inertial") is None:
            fail(f"{control_id} dynamic child has no inertial element.")
        if link.find("collision") is None:
            fail(f"{control_id} dynamic child has no collision element.")
    for joint in joints.values():
        child = joint.find("child")
        if child is not None:
            child_to_joint[child.attrib.get("link", "")] = joint
    if len(joint_names) != len(set(joint_names)):
        fail("Cabinet control joint names must be non-empty and unique.")
    for control_id in control_ids:
        joint = joints[str(controls[control_id]["joint_name"])]
        parent = joint.find("parent")
        parent_link = (
            parent.attrib.get("link", "") if parent is not None else ""
        )
        derived_parent = ""
        visited = set()
        while parent_link and parent_link not in visited:
            visited.add(parent_link)
            if parent_link in control_child_links:
                derived_parent = control_child_links[parent_link]
                break
            parent_joint = child_to_joint.get(parent_link)
            if parent_joint is None:
                break
            parent_element = parent_joint.find("parent")
            parent_link = (
                parent_element.attrib.get("link", "")
                if parent_element is not None
                else ""
            )
        configured_parent = str(
            controls[control_id].get("parent_control_id", "")
        )
        if configured_parent != derived_parent:
            fail(
                f"{control_id} parent mismatch: config='{configured_parent}', "
                f"URDF='{derived_parent}'."
            )

    # ── state plugin contract (instance-parametric) ──────────────────────
    plugin = next(
        (
            candidate
            for candidate in root.findall(".//plugin")
            if candidate.attrib.get("filename") == "libxczs_cabinet_state.so"
        ),
        None,
    )
    if plugin is None:
        fail("libxczs_cabinet_state.so is absent from expanded URDF.")
    expected_plugin_name = f"xczs_{CABINET_NAME}_state"
    if plugin.attrib.get("name") != expected_plugin_name:
        fail(
            "Cabinet state plugin name must include its instance name; "
            f"expected '{expected_plugin_name}'."
        )
    plugin_namespace = plugin.find("./ros/namespace")
    if plugin_namespace is None or (
        plugin_namespace.text or ""
    ).strip() != CABINET_NAMESPACE:
        fail(
            "Cabinet state-plugin ROS namespace must follow its instance "
            f"(expected '{CABINET_NAMESPACE}')."
        )
    if not math.isclose(
        float(text(plugin, "state_publish_rate")),
        20.0,
        rel_tol=0.0,
        abs_tol=1.0e-9,
    ):
        fail("Cabinet physical state publication must remain at 20 Hz.")
    if text(plugin, "grasp_active_topic") != f"{CABINET_NAMESPACE}/grasp_active":
        fail("Cabinet grasp-active topic must use its canonical name.")
    if text(plugin, "active_control_topic") != f"{CABINET_NAMESPACE}/active_control":
        fail("Cabinet active-control topic must use its canonical name.")
    if plugin.find("grasp_robot_base_link") is not None:
        fail("Cabinet model must not embed a robot-specific base link.")
    alternate_name = "cabinet_contract_peer"
    if alternate_name != CABINET_NAME:
        alternate_root = ElementTree.fromstring(
            render_xacro(XACRO, f"cabinet_name:={alternate_name}")
        )
        alternate_plugin = next(
            (
                candidate
                for candidate in alternate_root.findall(".//plugin")
                if candidate.attrib.get("filename")
                == "libxczs_cabinet_state.so"
            ),
            None,
        )
        if alternate_plugin is None:
            fail("Alternate cabinet expansion has no state plugin.")
        if (
            alternate_plugin.attrib.get("name") != f"xczs_{alternate_name}_state"
            or alternate_plugin.attrib.get("name") == plugin.attrib.get("name")
        ):
            fail("Cabinet instances must expand to unique state-plugin names.")
        alternate_namespace = alternate_plugin.find("./ros/namespace")
        if (
            alternate_namespace is None
            or (alternate_namespace.text or "").strip()
            != f"/xczs/cabinet/{alternate_name}"
        ):
            fail("Cabinet state-plugin ROS namespace must follow its instance.")

    plugin_controls = plugin.findall("control")
    if len(plugin_controls) != len(control_ids):
        fail(
            f"Expected {len(control_ids)} plugin controls, got "
            f"{len(plugin_controls)}."
        )
    plugin_ids: list[str] = []
    state_topics: list[str] = []
    joint_topics: list[str] = []
    for entry in plugin_controls:
        control_id = text(entry, "control_id")
        if control_id not in controls:
            fail(f"Plugin has unknown control ID '{control_id}'.")
        plugin_ids.append(control_id)
        spec = controls[control_id]
        control_type = str(spec["type"])
        defaults = parameters.get(f"{control_type}_defaults", {})
        if not isinstance(defaults, dict):
            defaults = {}
        if text(entry, "control_type") != control_type:
            fail(f"{control_id} plugin/config control types differ.")
        if text(entry, "joint_name") != spec["joint_name"]:
            fail(f"{control_id} plugin/config joint names differ.")
        expected_prefix = f"{CABINET_NAMESPACE}/{control_id}"
        state_topic = text(entry, "state_topic")
        joint_topic = text(entry, "joint_state_topic")
        pressed_topic = text(entry, "pressed_topic")
        if state_topic != f"{expected_prefix}/state":
            fail(f"{control_id} has a noncanonical state topic.")
        if joint_topic != f"{expected_prefix}/joint_states":
            fail(f"{control_id} has a noncanonical joint-state topic.")
        if pressed_topic != f"{expected_prefix}/pressed":
            fail(f"{control_id} has a noncanonical activation topic.")
        state_topics.append(state_topic)
        joint_topics.append(joint_topic)
        expected_states = list(
            spec.get("state_ids", defaults.get("state_ids", []))
        )
        plugin_states = text(entry, "state_ids").split()
        if plugin_states != expected_states:
            fail(f"{control_id} plugin/config state IDs differ.")
        expected_positions = numbers(
            spec.get(
                "state_positions",
                defaults.get("state_positions", []),
            ),
            f"{control_id}.state_positions",
        )
        reset_position = float(entry.findtext("reset_position", default="0.0"))
        if not any(
            math.isclose(
                reset_position,
                position,
                rel_tol=0.0,
                abs_tol=1.0e-6,
            )
            for position in expected_positions
        ):
            fail(f"{control_id} reset position is not a catalog state.")
        graspable = entry.findtext("graspable", default="false").strip()
        expected_graspable = control_type != "button"
        if (graspable.lower() == "true") != expected_graspable:
            fail(f"{control_id} has inconsistent graspability.")
        if control_type == "button":
            press_threshold = float(text(entry, "press_threshold"))
            release_threshold = float(text(entry, "release_threshold"))
            if not math.isclose(
                press_threshold,
                expected_positions[-1],
                rel_tol=0.0,
                abs_tol=1.0e-6,
            ) or not 0.0 <= release_threshold < press_threshold:
                fail(f"{control_id} has invalid press/release thresholds.")
        else:
            detents = numbers(
                text(entry, "detents"),
                f"{control_id}.detents",
            )
            if not close_lists(detents, expected_positions):
                fail(f"{control_id} plugin/config detents differ.")
    if set(plugin_ids) != set(control_ids):
        fail("Plugin and catalog control IDs differ.")
    if len(set(state_topics)) != len(control_ids) or len(set(joint_topics)) != len(
        control_ids
    ):
        fail("Cabinet state or joint-state topics are not unique.")

    # ── scene profile references existing controls ───────────────────────
    door_scene = scene_parameters.get("door")
    switch_scene = scene_parameters.get("switch")
    collision_scene = scene_parameters.get("control_collision")
    if not all(
        isinstance(value, dict)
        for value in (door_scene, switch_scene, collision_scene)
    ):
        fail("Scene profile is missing door, switch or control geometry.")
    scene_selected_ids = [door_scene.get("control_id")]
    if switch_scene.get("control_id"):
        scene_selected_ids.append(switch_scene.get("control_id"))
    if any(
        not isinstance(value, str) or not value.strip()
        for value in scene_selected_ids
    ):
        fail("Scene profile door/switch must select a named control.")
    unknown_scene_ids = set(scene_selected_ids) - set(control_ids)
    if unknown_scene_ids:
        fail(
            "Scene profile references unknown controls: "
            + ", ".join(sorted(str(value) for value in unknown_scene_ids))
            + "."
        )
    switch_parent = switch_scene.get("parent_control_id")
    if switch_parent is not None and switch_parent not in control_ids:
        fail(
            "Scene profile switch parent references an unknown control: "
            f"{switch_parent}."
        )


def main() -> int:
    arguments = _parser().parse_args()
    global CONFIG, SCENE_CONFIG, ROBOT_ADAPTER_CONFIG, XACRO  # noqa: PLW0603
    global CABINET_NAME, CABINET_NAMESPACE, TOOLSET  # noqa: PLW0603
    global ROS2_CONTROLLERS, MOVEIT_CONTROLLERS, JOINT_LIMITS, SRDF  # noqa: PLW0603
    CONFIG = Path(arguments.controls).expanduser()
    SCENE_CONFIG = Path(arguments.scene).expanduser()
    ROBOT_ADAPTER_CONFIG = Path(arguments.adapter).expanduser()
    XACRO = Path(arguments.xacro).expanduser()
    CABINET_NAME = arguments.cabinet_name
    CABINET_NAMESPACE = f"/xczs/cabinet/{CABINET_NAME}"
    TOOLSET = arguments.toolset
    ROS2_CONTROLLERS = ROS2_CONTROLLERS_TOOLSET[TOOLSET]
    MOVEIT_CONTROLLERS = MOVEIT_CONTROLLERS_TOOLSET[TOOLSET]
    JOINT_LIMITS = JOINT_LIMITS_TOOLSET[TOOLSET]
    SRDF = SRDF_TOOLSET[TOOLSET]
    asset_mode = arguments.asset
    try:
        if asset_mode:
            validate_cabinet_asset()
            control_count = len(load_config()["control_ids"])
            print(
                f"Cabinet asset valid: {control_count} controls, "
                "instance-parametric xacro, and a consistent "
                "plugin/adapter/scene contract."
            )
            return 0
        parameters = load_config()
        scene_parameters = load_scene_config()
        robot_parameters = load_robot_adapter_config()
        lease_parameters = load_lease_coordinator_config()
        root = expand_xacro()

        operator_source = CABINET_OPERATOR.read_text(encoding="utf-8")
        navigation_interfaces = {
            "navigation_action": {
                "default": "/navigate_to_pose",
                "is_service": "false",
                "client": (
                    r"rclcpp_action::create_client<NavigateToPose>\("
                    r"\s*this\s*,\s*navigation_action\s*\);"
                ),
            },
            "navigation_mode_service": {
                "default": "/xczs/set_navigation_mode",
                "is_service": "true",
                "client": (
                    r"create_client<std_srvs::srv::SetBool>\("
                    r"\s*navigation_mode_service\s*\);"
                ),
            },
        }
        for parameter_name, interface_contract in navigation_interfaces.items():
            legacy_name = interface_contract["default"]
            declaration_pattern = re.compile(
                r"required_string_parameter\(\s*"
                + re.escape(f'"{parameter_name}"')
                + r"\s*,\s*"
                + re.escape(f'"{legacy_name}"')
                + r"\s*\)"
            )
            if not declaration_pattern.search(operator_source):
                fail(
                    "Cabinet operator must require robot-adapter parameter "
                    f"'{parameter_name}' with its compatible default."
                )
            configured_absolute_ros_name(robot_parameters, parameter_name)
            validation_pattern = re.compile(
                r"require_absolute_ros_name\(\s*"
                + re.escape(parameter_name)
                + r"\s*,\s*"
                + re.escape(f'"{parameter_name}"')
                + r"\s*,\s*"
                + interface_contract["is_service"]
                + r"\s*\)"
            )
            if not validation_pattern.search(operator_source):
                fail(
                    "Cabinet operator must validate robot-adapter parameter "
                    f"'{parameter_name}' as an absolute ROS name."
                )
            hardcoded_client_pattern = re.compile(
                r"create_client(?:<[^;]+?>)?\(\s*(?:this\s*,\s*)?"
                + re.escape(f'"{legacy_name}"')
            )
            if hardcoded_client_pattern.search(operator_source):
                fail(
                    "Cabinet operator must not hard-code Nav2 interface "
                    f"'{legacy_name}' in a client."
                )
            parameter_client_pattern = re.compile(interface_contract["client"])
            if not parameter_client_pattern.search(operator_source):
                fail(
                    "Cabinet operator must construct its Nav2 client from "
                    f"'{parameter_name}'."
                )

        configured_absolute_ros_name(
            robot_parameters, "manual_cmd_vel_topic"
        )
        if not re.search(
            r"required_string_parameter\(\s*"
            r'"manual_cmd_vel_topic"\s*,\s*'
            r'"/xczs/manual_cmd_vel"\s*\)',
            operator_source,
        ) or not re.search(
            r"require_absolute_ros_name\(\s*manual_cmd_vel_topic\s*,\s*"
            r'"manual_cmd_vel_topic"\s*,\s*false\s*\)',
            operator_source,
        ):
            fail(
                "Cabinet operator must consume and validate the shared "
                "manual_cmd_vel_topic."
            )
        if '"manual_base_topic"' in operator_source or not re.search(
            r"create_publisher<geometry_msgs::msg::Twist>\(\s*"
            r"manual_cmd_vel_topic\s*,\s*10\s*\)",
            operator_source,
        ):
            fail(
                "Cabinet operator precision docking must publish through "
                "manual_cmd_vel_topic."
            )

        allow_embedded_navigation = robot_parameters.get(
            "allow_embedded_navigation"
        )
        if allow_embedded_navigation is not False:
            fail(
                "Current robot adapter must disable legacy embedded cabinet "
                "navigation."
            )
        if not re.search(
            r"declare_parameter<bool>\(\s*"
            r'"allow_embedded_navigation"\s*,\s*true\s*\)',
            operator_source,
        ):
            fail(
                "Cabinet operator must retain an explicit legacy-compatible "
                "embedded-navigation switch."
            )
        if not re.search(
            r'navigation is executed\s*"\s*'
            r'"independently by the task layer',
            operator_source,
        ):
            fail(
                "Disabled embedded navigation must return a clear task-layer "
                "reason."
            )
        press_execute_match = re.search(
            r"void execute\(.*?\n  void execute_operate\(",
            operator_source,
            re.DOTALL,
        )
        operate_execute_match = re.search(
            r"void execute_operate\(.*?\n  void publish_operate_feedback\(",
            operator_source,
            re.DOTALL,
        )
        for action_name, execute_match, error_constant in (
            ("Press", press_execute_match, "PressCabinetButton"),
            ("Operate", operate_execute_match, "OperateCabinetControl"),
        ):
            if execute_match is None:
                fail(f"Could not inspect the {action_name} execution path.")
            execute_source = execute_match.group(0)
            gate_position = execute_source.find(
                "embedded_navigation_request_is_supported("
            )
            lease_position = execute_source.find("acquire_operation_lease(")
            if (
                gate_position < 0
                or lease_position < 0
                or gate_position >= lease_position
                or f"{error_constant}::Result::NAVIGATION_FAILED"
                not in execute_source
            ):
                fail(
                    f"{action_name} embedded-navigation rejection must return "
                    "NAVIGATION_FAILED before acquiring the robot lease."
                )

        if "base_link_yaw_offset" in robot_parameters:
            fail(
                "Robot adapter must use navigation_velocity_yaw_offset as "
                "the single frame-rotation source."
            )
        if not re.search(
            r"finite_parameter\(\s*"
            r'"navigation_velocity_yaw_offset"\s*,',
            operator_source,
        ) or not re.search(
            r"navigation_yaw_in_model_frame\(\s*"
            r"tf2::getYaw\(target_rotation\)\s*,\s*"
            r"navigation_velocity_yaw_offset_\s*\)",
            operator_source,
        ):
            fail(
                "Cabinet precision docking must use the shared navigation "
                "velocity yaw offset."
            )
        if not re.search(
            r"parameter_overrides\.count\("
            r'"base_link_yaw_offset"\)',
            operator_source,
        ):
            fail(
                "Cabinet operator must retain a bounded legacy yaw-offset "
                "fallback."
            )

        base_router_source = BASE_COMMAND_ROUTER.read_text(encoding="utf-8")
        base_topic_contracts = {
            "manual_cmd_vel_topic": "/xczs/manual_cmd_vel",
            "navigation_cmd_vel_topic": "/cmd_vel",
            "base_output_topic": "/xczs/cmd_vel",
            "navigation_mode_topic": "/xczs/navigation_mode",
            "navigation_mode_service": "/xczs/set_navigation_mode",
        }
        for parameter_name, compatible_default in base_topic_contracts.items():
            configured_absolute_ros_name(robot_parameters, parameter_name)
            is_service = parameter_name == "navigation_mode_service"
            declaration_pattern = re.compile(
                r"absolute_ros_name_parameter\(\s*"
                + re.escape(f'"{parameter_name}"')
                + r"\s*,\s*"
                + re.escape(f'"{compatible_default}"')
                + r"\s*,\s*"
                + ("true" if is_service else "false")
                + r"\s*\)"
            )
            if not declaration_pattern.search(base_router_source):
                fail(
                    "Base command router must consume and validate adapter "
                    f"parameter '{parameter_name}'."
                )
        for legacy_parameter in (
            "manual_topic",
            "navigation_topic",
            "output_topic",
        ):
            if f'"{legacy_parameter}"' in base_router_source:
                fail(
                    "Base command router still declares legacy parameter "
                    f"'{legacy_parameter}'."
                )
        yaw_offset = robot_parameters.get("navigation_velocity_yaw_offset")
        if (
            isinstance(yaw_offset, bool)
            or not isinstance(yaw_offset, (int, float))
            or not math.isfinite(float(yaw_offset))
        ):
            fail(
                "Robot adapter navigation_velocity_yaw_offset must be finite."
            )
        if not re.search(
            r"finite_parameter\(\s*"
            r'"navigation_velocity_yaw_offset"\s*,',
            base_router_source,
        ) or "rotate_planar_vector(" not in base_router_source:
            fail(
                "Base command router must rotate Nav2 velocity through the "
                "configured yaw offset."
            )
        if (
            "output.linear.x = -sanitized.linear.y" in base_router_source
            or "output.linear.y = sanitized.linear.x" in base_router_source
        ):
            fail("Base command router still hard-codes a 90-degree mapping.")
        for wiring_pattern in (
            r"create_publisher<Twist>\(\s*output_topic\s*,",
            r"create_publisher<std_msgs::msg::Bool>\(\s*"
            r"navigation_mode_topic\s*,",
            r"create_subscription<Twist>\(\s*manual_topic\s*,",
            r"create_subscription<Twist>\(\s*navigation_topic\s*,",
            r"create_service<std_srvs::srv::SetBool>\(\s*"
            r"navigation_mode_service\s*,",
        ):
            if not re.search(wiring_pattern, base_router_source):
                fail("Base command router adapter-topic wiring is incomplete.")

        legacy_router_source = LEGACY_TRAJECTORY_ROUTER.read_text(
            encoding="utf-8"
        )
        group_names_value = robot_parameters.get("manual_joint_group_names")
        groups_value = robot_parameters.get("manual_joint_groups")
        if not isinstance(group_names_value, list) or not group_names_value:
            fail(
                "Robot adapter manual_joint_group_names must be a non-empty "
                "string list."
            )
        if any(
            not isinstance(name, str) or not name.strip()
            for name in group_names_value
        ):
            fail(
                "Robot adapter manual_joint_group_names entries must be "
                "non-empty strings."
            )
        if len(group_names_value) != len(set(group_names_value)):
            fail("Robot adapter manual_joint_group_names contains duplicates.")
        if not isinstance(groups_value, dict):
            fail("Robot adapter manual_joint_groups must be a mapping.")
        if set(groups_value) != set(group_names_value):
            fail(
                "Robot adapter manual_joint_groups keys must match "
                "manual_joint_group_names."
            )
        all_configured_joints: list[str] = []
        for name in group_names_value:
            joints = groups_value[name]
            if (
                not isinstance(joints, list)
                or not joints
                or any(
                    not isinstance(joint, str) or not joint for joint in joints
                )
                or len(joints) != len(set(joints))
            ):
                fail(
                    f"Robot adapter manual_joint_groups.{name} must contain "
                    "unique, nonempty joint names."
                )
            all_configured_joints.extend(joints)
        if len(all_configured_joints) != len(set(all_configured_joints)):
            fail("Robot adapter joint groups must not overlap.")
        if set(all_configured_joints) != {
            joint for joints in JOINT_GROUPS.values() for joint in joints
        }:
            fail(
                "Robot adapter manual_joint_groups must cover exactly the "
                "dual-arm joint topology."
            )
        configured_toolsets = robot_parameters.get(
            "manual_joint_groups_by_toolset"
        )
        expected_toolsets = {
            "A": [
                "left_arm",
                "right_arm",
                "three_cylinder",
                "two_cylinder",
            ],
            "B": [
                "left_arm",
                "right_arm",
                "rocker",
                "rotate_button",
            ],
        }
        if configured_toolsets != expected_toolsets:
            fail(
                "Robot adapter manual_joint_groups_by_toolset must match "
                "the mutually exclusive A/B URDF and controller groups."
            )
        configured_absolute_ros_name(robot_parameters, "controller_namespace")
        if robot_parameters.get("controller_namespace") != "/xczs":
            fail("Robot adapter controller_namespace must be /xczs.")
        for pattern in (
            r'declare_parameter<std::vector<std::string>>\(\s*'
            r'"manual_joint_group_names"\s*,',
            r'absolute_ros_name_parameter\(\s*'
            r'"controller_namespace"\s*,\s*kDefaultControllerNamespace\s*\)',
            r'"manual_joint_groups\."\s*\+\s*group_name',
            r"controller_topic\(\s*namespace_name\s*,\s*group_name\s*\)",
            r"controller_status_topic\(\s*namespace_name\s*,\s*group_name\s*\)",
            r"add_route\(\s*group_name\s*,\s*joints\s*,\s*topic\s*,"
            r"\s*status_topic\s*\)",
            r"validate_groups_are_disjoint\(\)",
            r"extract_trajectory\(\s*input\s*,\s*route\.joints\s*\)",
            r'required_joint_group_parameter\(\s*"arm_joint_names"\s*,'
            r"\s*false\s*\)",
        ):
            if not re.search(pattern, legacy_router_source):
                fail(
                    "Legacy trajectory router must derive its controller "
                    "groups from the N-group adapter schema and retain its "
                    "legacy arm fallback."
                )
        if any(
            f'"{joint_name}"' in legacy_router_source
            for joint_name in all_configured_joints
        ):
            fail("Legacy trajectory router still hard-codes robot joint names.")
        if '"arm_action_status_topic"' in legacy_router_source:
            fail("Legacy trajectory router still declares legacy status keys.")
        if "router_utils_test" not in CONTROL_CMAKE.read_text(
            encoding="utf-8"
        ):
            fail("Router adapter math and joint-group tests are not wired.")

        control_ids = parameters.get("control_ids")
        controls = parameters.get("controls")
        if not isinstance(control_ids, list) or not isinstance(controls, dict):
            fail("control_ids and controls mappings are required.")
        if len(control_ids) != 33 or len(set(control_ids)) != 33:
            fail(f"Expected 33 unique control_ids, got {len(control_ids)}.")
        if set(control_ids) != set(controls):
            fail("control_ids and controls keys differ.")
        for legacy_field in (
            "unreachable_control_ids",
            "unreachable_control_reason",
        ):
            if legacy_field in robot_parameters:
                fail(
                    f"Robot adapter {legacy_field} is fail-open and no "
                    "longer supported; use operable_control_ids."
                )
        operable_control_ids = robot_parameters.get(
            "operable_control_ids", []
        )
        if "operable_control_ids" in robot_parameters and not operable_control_ids:
            fail(
                "Robot adapter must omit operable_control_ids when empty; "
                "ROS 2 cannot infer an empty parameter sequence type."
            )
        if not isinstance(operable_control_ids, list) or any(
            not isinstance(control_id, str) or not control_id.strip()
            for control_id in operable_control_ids
        ):
            fail("Robot adapter operable_control_ids must be a string list.")
        if len(operable_control_ids) != len(set(operable_control_ids)):
            fail("Robot adapter operable_control_ids contains duplicates.")
        adapter_controls = robot_parameters.get("controls", {})
        if not isinstance(adapter_controls, dict):
            fail("Robot adapter controls must be a mapping.")
        unknown_adapter_ids = (
            set(operable_control_ids) | set(adapter_controls)
        ) - set(control_ids)
        if unknown_adapter_ids:
            fail(
                "Robot adapter references unknown controls: "
                + ", ".join(sorted(unknown_adapter_ids))
                + "."
            )
        navigation_frame = str(robot_parameters.get("navigation_frame", ""))
        for control_id, override in adapter_controls.items():
            if not isinstance(override, dict):
                fail(
                    f"Robot adapter override for {control_id} must be a "
                    "mapping."
                )
            if "operable" in override:
                fail(
                    "Per-control operable flags are not supported; use the "
                    "single operable_control_ids allowlist."
                )
            if "unavailable_reason" in override and not str(
                override["unavailable_reason"]
            ).strip():
                fail(
                    f"Robot adapter {control_id}.unavailable_reason is empty."
                )
            if (
                control_id in operable_control_ids
                and "unavailable_reason" in override
            ):
                fail(
                    f"Operable control {control_id} must not declare an "
                    "unavailable_reason."
                )
            control_spec = controls.get(control_id)
            if not isinstance(control_spec, dict):
                fail(f"Control {control_id} configuration must be a mapping.")
            validate_rotary_adapter_override(
                control_id, override, control_spec, parameters
            )
            station = override.get("navigation_station")
            if station is None:
                continue
            if not isinstance(station, dict):
                fail(
                    f"Robot adapter {control_id}.navigation_station must "
                    "be a mapping."
                )
            allowed_station_fields = {
                "local_anchor",
                "outward_axis",
                "standoff",
                "base_yaw_offset",
                "frame_id",
            }
            unknown_station_fields = set(station) - allowed_station_fields
            if unknown_station_fields:
                fail(
                    f"Robot adapter {control_id}.navigation_station has "
                    "unknown fields: "
                    + ", ".join(sorted(unknown_station_fields))
                    + "."
                )
            for vector_name in ("local_anchor", "outward_axis"):
                vector = station.get(vector_name)
                if (
                    not isinstance(vector, list)
                    or len(vector) != 3
                    or any(
                        isinstance(value, bool)
                        or not isinstance(value, (int, float))
                        or not math.isfinite(float(value))
                        for value in vector
                    )
                ):
                    fail(
                        f"Robot adapter {control_id}.navigation_station."
                        f"{vector_name} must contain three finite numbers."
                    )
            if sum(
                float(value) * float(value)
                for value in station["outward_axis"]
            ) <= 1.0e-12:
                fail(
                    f"Robot adapter {control_id}.navigation_station."
                    "outward_axis must not be zero."
                )
            standoff = station.get("standoff")
            if (
                isinstance(standoff, bool)
                or not isinstance(standoff, (int, float))
                or not math.isfinite(float(standoff))
                or float(standoff) <= 0.0
            ):
                fail(
                    f"Robot adapter {control_id}.navigation_station."
                    "standoff must be a positive finite number."
                )
            yaw_offset = station.get("base_yaw_offset", 0.0)
            if (
                isinstance(yaw_offset, bool)
                or not isinstance(yaw_offset, (int, float))
                or not math.isfinite(float(yaw_offset))
            ):
                fail(
                    f"Robot adapter {control_id}.navigation_station."
                    "base_yaw_offset must be finite."
                )
            if station.get("frame_id", "map") != navigation_frame:
                fail(
                    f"Robot adapter {control_id}.navigation_station frame "
                    "must match navigation_frame."
                )
        if (
            "inoperable_control_reason" in robot_parameters
            or set(operable_control_ids) != set(control_ids)
        ) and not str(
            robot_parameters.get("inoperable_control_reason", "")
        ).strip():
            fail("Robot adapter inoperable controls require a shared reason.")
        controls_without_explicit_station = sorted(
            control_id
            for control_id in control_ids
            if not isinstance(
                adapter_controls.get(control_id, {}).get("navigation_station"),
                dict,
            )
        )
        if controls_without_explicit_station:
            fail(
                "Every submitted control requires an explicit robot-adapter "
                "navigation_station: "
                + ", ".join(controls_without_explicit_station)
                + "."
            )
        front_control_ids = {
            control_id
            for control_id in control_ids
            if controls[control_id].get("type") in {"button", "knob"}
        }
        for control_id in sorted(front_control_ids):
            station = adapter_controls[control_id]["navigation_station"]
            anchor = numbers(
                station["local_anchor"],
                f"Robot adapter {control_id} navigation anchor",
            )
            outward = numbers(
                station["outward_axis"],
                f"Robot adapter {control_id} navigation outward axis",
            )
            outward_norm = math.sqrt(sum(value * value for value in outward))
            outward_unit = [value / outward_norm for value in outward]
            if not close_lists(outward_unit, [0.0, 0.0, 1.0]):
                fail(
                    f"Front control {control_id} navigation station must "
                    "approach the cabinet from its local +Z face."
                )
            control_position = numbers(
                controls[control_id].get("local_position"),
                f"controls.{control_id}.local_position",
            )
            # The fixed tools retain the original right-shoulder calibration.
            # box_5_knob keeps its lateral planning calibration, but its base
            # standoff must remain outside the padded chassis footprint.
            shoulder_offset = 0.55 if control_id == "box_5_knob" else 0.35
            expected_anchor = [
                control_position[0] + shoulder_offset,
                1.115,
                0.0,
            ]
            if not close_lists(anchor, expected_anchor):
                fail(
                    f"Front control {control_id} navigation anchor must align "
                    f"local_position.x plus the calibrated {shoulder_offset:.2f} "
                    "m right-shoulder "
                    "offset and retain the common [y, z] anchor."
                )
            if control_id == "box_5_knob" and not math.isclose(
                float(station.get("standoff", 0.0)),
                0.769,
                rel_tol=0.0,
                abs_tol=1.0e-9,
            ):
                fail(
                    "box_5_knob navigation standoff must retain the "
                    "safe 0.769 m planning-only calibration."
                )
        rear_door_station = adapter_controls["cabinet_rear_door"][
            "navigation_station"
        ]
        main_switch_station = adapter_controls["cabinet_main_switch"][
            "navigation_station"
        ]
        for field in ("local_anchor", "outward_axis"):
            if not close_lists(
                numbers(
                    rear_door_station[field],
                    f"cabinet_rear_door.navigation_station.{field}",
                ),
                numbers(
                    main_switch_station[field],
                    f"cabinet_main_switch.navigation_station.{field}",
                ),
            ):
                fail(
                    "The door-mounted cabinet_main_switch must share the "
                    f"rear-door navigation station {field}."
                )
        for field in ("base_yaw_offset",):
            if not math.isclose(
                float(rear_door_station.get(field, 0.0)),
                float(main_switch_station.get(field, 0.0)),
                rel_tol=0.0,
                abs_tol=1.0e-9,
            ):
                fail(
                    "The door-mounted cabinet_main_switch must share the "
                    f"rear-door navigation station {field}."
                )
        # The switch shares the rear-door dock geometry (anchor / outward /
        # frame checked above) but its standoff is intentionally shorter than
        # the rear door's: the Set B rocker arm cannot reach the switch handle
        # from the 0.930 m standoff (its body mounting point sits ~0.094 m
        # beyond the left-arm workspace), so the 0.780 m standoff is pinned and
        # must stay strictly below the rear-door standoff.  The whole approach
        # path at 0.780 m is reachable (verified by staged IK scans).
        if not math.isclose(
            float(main_switch_station.get("standoff", 0.0)),
            0.780,
            rel_tol=0.0,
            abs_tol=1.0e-9,
        ):
            fail(
                "cabinet_main_switch navigation standoff must retain the "
                "calibrated 0.780 m rocker-reach standoff."
            )
        if not (
            float(main_switch_station.get("standoff", 0.0))
            < float(rear_door_station.get("standoff", 0.0))
        ):
            fail(
                "cabinet_main_switch standoff must stay below the rear-door "
                "standoff (rocker reach constraint)."
            )
        if rear_door_station.get("frame_id", navigation_frame) != (
            main_switch_station.get("frame_id", navigation_frame)
        ):
            fail(
                "The door-mounted cabinet_main_switch must share the "
                "rear-door navigation station frame."
            )
        rear_outward = numbers(
            rear_door_station["outward_axis"],
            "cabinet_rear_door.navigation_station.outward_axis",
        )
        rear_outward_norm = math.sqrt(
            sum(value * value for value in rear_outward)
        )
        if not close_lists(
            [value / rear_outward_norm for value in rear_outward],
            [0.0, 0.0, -1.0],
        ):
            fail(
                "Rear door and its main switch must approach from the "
                "cabinet local -Z face."
            )
        joint_names = [str(controls[control_id].get("joint_name", ""))
                       for control_id in control_ids]
        if "" in joint_names or len(set(joint_names)) != len(joint_names):
            fail("Cabinet control joint names must be non-empty and unique.")
        grasp_offset = float(parameters.get("grasp_outward_offset", 0.0))
        if not math.isfinite(grasp_offset) or grasp_offset < 0.020:
            fail(
                "Rotary grasp must remain at least 0.020 m outside the "
                "configured control center."
            )
        release_settle = float(
            parameters.get("grasp_release_settle_duration", 0.0)
        )
        if not math.isfinite(release_settle) or release_settle < 0.30:
            fail("Grasp release settling must last at least 0.30 seconds.")
        attach_settle = float(
            parameters.get("grasp_attach_settle_duration", 0.0)
        )
        if not math.isfinite(attach_settle) or attach_settle < 0.10:
            fail("Grasp attachment settling must last at least 0.10 seconds.")
        cartesian_attempts = parameters.get("cartesian_planning_attempts")
        if (
            not isinstance(cartesian_attempts, int)
            or not 3 <= cartesian_attempts <= 10
        ):
            fail("Cartesian planning attempts must be an integer in [3, 10].")
        cartesian_jump_threshold = float(
            parameters.get("cartesian_jump_threshold", 0.0)
        )
        if (
            not math.isfinite(cartesian_jump_threshold)
            or not 1.0 <= cartesian_jump_threshold <= 10.0
        ):
            fail("Cartesian jump threshold must be in [1, 10].")
        door_segment_waypoints = parameters.get(
            "door_cartesian_segment_waypoints"
        )
        if door_segment_waypoints != 2:
            fail(
                "Door Cartesian segment size must be exactly 2 waypoints."
            )
        motion_planning_attempts = parameters.get("motion_planning_attempts")
        if (
            not isinstance(motion_planning_attempts, int)
            or not 2 <= motion_planning_attempts <= 10
        ):
            fail(
                "Motion planning attempts must be an integer in "
                "[2, 10]."
            )
        door_release_fraction = float(
            parameters.get("door_release_fraction", 0.0)
        )
        if (
            not math.isfinite(door_release_fraction)
            or not 0.52 <= door_release_fraction <= 0.60
        ):
            fail(
                "Door over-center release fraction must be in [0.52, 0.60]."
            )
        door_settle_timeout = float(
            parameters.get("door_settle_timeout", 0.0)
        )
        if not math.isfinite(door_settle_timeout) or door_settle_timeout < 90.0:
            fail("Door physical settling timeout must be at least 90 seconds.")
        door_release_position_timeout = float(
            parameters.get("door_release_position_timeout", 0.0)
        )
        if (
            not math.isfinite(door_release_position_timeout)
            or door_release_position_timeout < 5.0
        ):
            fail("Door physical release-position timeout must be at least 5 s.")
        door_pregrasp_clearance = float(
            parameters.get("door_pregrasp_clearance", 0.0)
        )
        if (
            not math.isfinite(door_pregrasp_clearance)
            or not 0.003 <= door_pregrasp_clearance <= 0.015
        ):
            fail(
                "Door pre-grasp clearance must be in [0.003, 0.015] m."
            )
        door_release_clearance = float(
            parameters.get("door_release_clearance", 0.0)
        )
        if (
            not math.isfinite(door_release_clearance)
            or not 0.28 <= door_release_clearance <= 0.35
        ):
            fail("Door release clearance must be in [0.28, 0.35] m.")
        door_detent_hysteresis = float(
            parameters.get("door_detent_hysteresis", 0.0)
        )
        if (
            not math.isfinite(door_detent_hysteresis)
            or not 0.01 <= door_detent_hysteresis <= 0.04
        ):
            fail(
                "Door action detent hysteresis must be in [0.01, 0.04] rad."
            )
        door_release_position_margin = float(
            parameters.get("door_release_position_margin", 0.0)
        )
        if (
            not math.isfinite(door_release_position_margin)
            or not 0.005 <= door_release_position_margin <= 0.02
        ):
            fail("Door release-position safety margin must be in [0.005, 0.02].")
        takeover_yaw = float(
            robot_parameters.get("navigation_takeover_yaw_tolerance", 0.0)
        )
        if not math.isfinite(takeover_yaw) or not 0.1 <= takeover_yaw <= 0.5:
            fail(
                "Nav2 precision-takeover yaw tolerance must be in "
                "[0.1, 0.5] rad."
            )
        takeover_distance = float(
            robot_parameters.get("navigation_takeover_distance", 0.0)
        )
        # The takeover distance must be at least the navigation handoff margin
        # (NAVIGATION_POSITION_TOLERANCE_M = 1.0 m) so the tight Set B docks
        # (whose Nav2 stops 0.5-0.8 m short, inside the costmap inflation
        # radius) still hand off to the precision docking phase instead of
        # failing navigation.  The upper bound keeps the docking controller
        # from grabbing the base from across the scene.
        if (
            not math.isfinite(takeover_distance)
            or not 1.0 <= takeover_distance <= 2.0
        ):
            fail(
                "Nav2 precision-takeover distance must be in [1.0, 2.0] m "
                "(covering the Nav2 inflation-limited stop for tight docks)."
            )
        takeover_stall_timeout = float(
            robot_parameters.get("navigation_takeover_stall_timeout", 0.0)
        )
        if (
            not math.isfinite(takeover_stall_timeout)
            or not 1.0 <= takeover_stall_timeout <= 10.0
        ):
            fail(
                "Nav2 safe-distance stall timeout must be in [1, 10] s."
            )
        docking_timeout = float(robot_parameters.get("docking_timeout", 0.0))
        if not math.isfinite(docking_timeout) or docking_timeout < 30.0:
            fail("Precision docking timeout must be at least 30 seconds.")
        docking_max_angular_speed = float(
            robot_parameters.get("docking_max_angular_speed", 0.0)
        )
        if (
            not math.isfinite(docking_max_angular_speed)
            or not 0.2 <= docking_max_angular_speed <= 0.6
        ):
            fail(
                "Precision docking angular speed must be in [0.2, 0.6] rad/s."
            )
        for field in (
            "planning_time",
            "goal_position_tolerance",
            "goal_orientation_tolerance",
            "goal_joint_tolerance",
        ):
            value = float(robot_parameters.get(field, 0.0))
            if not math.isfinite(value) or value <= 0.0:
                fail(f"Robot adapter {field} must be positive.")
        for field in (
            "planning_velocity_scale",
            "planning_acceleration_scale",
        ):
            value = float(robot_parameters.get(field, 0.0))
            if not math.isfinite(value) or not math.isclose(
                value, 0.30, rel_tol=0.0, abs_tol=1.0e-9
            ):
                fail(
                    f"Robot adapter {field} must explicitly be 0.30 for "
                    "free-space arm motion."
                )
        for field, member_name in (
            ("cartesian_velocity_scale", "cartesian_velocity_scale_"),
            ("cartesian_acceleration_scale", "cartesian_acceleration_scale_"),
        ):
            value = float(robot_parameters.get(field, 0.08))
            if not math.isfinite(value) or not math.isclose(
                value, 0.08, rel_tol=0.0, abs_tol=1.0e-9
            ):
                fail(
                    f"Robot adapter {field} must remain 0.08 for "
                    "contact-adjacent Cartesian motion."
                )
            if not re.search(
                re.escape(member_name)
                + r'\s*=\s*unit_interval_parameter\(\s*"'
                + re.escape(field)
                + r'"\s*,\s*0\.08\s*\);',
                operator_source,
            ):
                fail(
                    f"Cabinet operator {field} default must remain 0.08."
                )
        if operate_execute_match is None or not re.search(
            r"\{button_poses\.pressed_pose\}\s*,\s*"
            r"cartesian_velocity_scale_\s*\*\s*0\.5\s*,\s*"
            r"cartesian_acceleration_scale_\s*\*\s*0\.5",
            operate_execute_match.group(0),
        ):
            fail(
                "Generic button pressing must retain the half-speed Cartesian "
                "contact profile."
            )
        force_tracking_source = re.search(
            r"void track_button_force\(.*?\n  OperationPoses "
            r"calculate_operation_poses\(",
            operator_source,
            re.DOTALL,
        )
        if force_tracking_source is None or not re.search(
            r"cartesian_velocity_scale_\s*\*\s*0\.35\s*,\s*"
            r"cartesian_acceleration_scale_\s*\*\s*0\.35",
            force_tracking_source.group(0),
        ):
            fail(
                "Button force correction must retain the 0.35 Cartesian "
                "contact scale multiplier."
            )
        planning_attempts = robot_parameters.get("planning_attempts")
        if (
            isinstance(planning_attempts, bool)
            or not isinstance(planning_attempts, int)
            or not 1 <= planning_attempts <= 100
        ):
            fail("Robot adapter planning_attempts must be in [1, 100].")
        lease_service = str(
            robot_parameters.get("operation_lease_service", "")
        )
        lease_duration = float(
            robot_parameters.get("operation_lease_duration", 0.0)
        )
        lease_renew_period = float(
            robot_parameters.get("operation_lease_renew_period", 0.0)
        )
        lease_request_timeout = float(
            robot_parameters.get("operation_lease_request_timeout", 0.0)
        )
        maximum_lease_duration = float(
            lease_parameters.get("maximum_lease_duration", 0.0)
        )
        if lease_service != lease_parameters.get("service_name"):
            fail("Operator and coordinator lease service names differ.")
        if not all(
            math.isfinite(value) and value > 0.0
            for value in (
                lease_duration,
                lease_renew_period,
                lease_request_timeout,
                maximum_lease_duration,
            )
        ):
            fail("Global operation lease timing values must be positive.")
        if (
            lease_renew_period + lease_request_timeout >= lease_duration
            or lease_duration > maximum_lease_duration
            or lease_duration > 5.0
        ):
            fail("Global operation lease timing does not fail safe quickly.")

        type_counts = Counter()
        joints = {joint.attrib["name"]: joint for joint in root.findall("joint")}
        links = {link.attrib["name"]: link for link in root.findall("link")}
        child_to_joint = {}
        control_child_links = {}
        for control_id in control_ids:
            spec = controls[control_id]
            if not isinstance(spec, dict):
                fail(f"{control_id} configuration is not a mapping.")
            control_type = str(spec.get("type", ""))
            joint_name = str(spec.get("joint_name", ""))
            expected_joint_type = TYPE_TO_JOINT.get(control_type)
            if expected_joint_type is None:
                fail(f"{control_id} has invalid type '{control_type}'.")
            if control_type != "button":
                required_offset = {
                    "knob": 0.020,
                    "switch": 0.012,
                    "door": 0.0145,
                }[control_type]
                configured_offset = float(
                    spec.get("grasp_outward_offset", grasp_offset)
                )
                if (
                    not math.isfinite(configured_offset)
                    or configured_offset < required_offset
                ):
                    fail(
                        f"{control_id} grasp offset does not clear its "
                        "physical collision surface."
                    )
            type_counts[control_type] += 1
            joint = joints.get(joint_name)
            if joint is None:
                fail(f"{control_id} joint '{joint_name}' is absent from URDF.")
            if joint.attrib.get("type") != expected_joint_type:
                fail(
                    f"{control_id} expected {expected_joint_type}, got "
                    f"{joint.attrib.get('type')}."
                )
            child = joint.find("child")
            child_name = child.attrib.get("link", "") if child is not None else ""
            control_child_links[child_name] = control_id
            link = links.get(child_name)
            if link is None or link.find("inertial") is None:
                fail(f"{control_id} dynamic child has no inertial element.")
            if link.find("collision") is None:
                fail(f"{control_id} dynamic child has no collision element.")
        for joint in joints.values():
            child = joint.find("child")
            if child is not None:
                child_to_joint[child.attrib.get("link", "")] = joint
        if dict(type_counts) != EXPECTED_COUNTS:
            fail(
                f"Expected type counts {EXPECTED_COUNTS}, got "
                f"{dict(type_counts)}."
            )

        plugin = next(
            (
                candidate
                for candidate in root.findall(".//plugin")
                if candidate.attrib.get("filename")
                == "libxczs_cabinet_state.so"
            ),
            None,
        )
        if plugin is None:
            fail("libxczs_cabinet_state.so is absent from expanded URDF.")
        expected_plugin_name = f"xczs_{CABINET_NAME}_state"
        if plugin.attrib.get("name") != expected_plugin_name:
            fail(
                "Cabinet state plugin name must include its instance name; "
                f"expected '{expected_plugin_name}'."
            )
        alternate_name = "cabinet_contract_peer"
        alternate_root = ElementTree.fromstring(
            render_xacro(XACRO, f"cabinet_name:={alternate_name}")
        )
        alternate_plugin = next(
            (
                candidate
                for candidate in alternate_root.findall(".//plugin")
                if candidate.attrib.get("filename")
                == "libxczs_cabinet_state.so"
            ),
            None,
        )
        if alternate_plugin is None:
            fail("Alternate cabinet expansion has no state plugin.")
        alternate_plugin_name = alternate_plugin.attrib.get("name")
        if (
            alternate_plugin_name != f"xczs_{alternate_name}_state"
            or alternate_plugin_name == plugin.attrib.get("name")
        ):
            fail("Cabinet instances must expand to unique state-plugin names.")
        alternate_ros_namespace = alternate_plugin.find("./ros/namespace")
        if (
            alternate_ros_namespace is None
            or (alternate_ros_namespace.text or "").strip()
            != f"/xczs/cabinet/{alternate_name}"
        ):
            fail("Cabinet state-plugin ROS namespace must follow its instance.")
        if not math.isclose(
            float(text(plugin, "state_publish_rate")),
            20.0,
            rel_tol=0.0,
            abs_tol=1.0e-9,
        ):
            fail("Cabinet physical state publication must remain at 20 Hz.")
        grasp_active_topic = text(plugin, "grasp_active_topic")
        if grasp_active_topic != f"{CABINET_NAMESPACE}/grasp_active":
            fail("Cabinet grasp-active topic must use its canonical name.")
        active_control_topic = text(plugin, "active_control_topic")
        if active_control_topic != f"{CABINET_NAMESPACE}/active_control":
            fail("Cabinet active-control topic must use its canonical name.")
        if plugin.find("grasp_robot_base_link") is not None:
            fail(
                "Cabinet model must not embed a robot-specific base link."
            )
        if not str(robot_parameters.get("docking_base_frame", "")):
            fail("Robot adapter must provide the precision-docking frame.")
        if not str(robot_parameters.get("grasp_brake_link", "")):
            fail("Robot adapter must provide the physical grasp brake link.")
        plugin_controls = plugin.findall("control")
        if len(plugin_controls) != 33:
            fail(f"Expected 33 plugin controls, got {len(plugin_controls)}.")

        plugin_ids = []
        state_topics = []
        joint_topics = []
        for entry in plugin_controls:
            control_id = text(entry, "control_id")
            if control_id not in controls:
                fail(f"Plugin has unknown control ID '{control_id}'.")
            plugin_ids.append(control_id)
            spec = controls[control_id]
            control_type = str(spec["type"])
            defaults = parameters.get(f"{control_type}_defaults", {})
            if not isinstance(defaults, dict):
                defaults = {}
            if text(entry, "control_type") != control_type:
                fail(f"{control_id} plugin/config control types differ.")
            if text(entry, "joint_name") != spec["joint_name"]:
                fail(f"{control_id} plugin/config joint names differ.")
            expected_prefix = f"{CABINET_NAMESPACE}/{control_id}"
            state_topic = text(entry, "state_topic")
            joint_topic = text(entry, "joint_state_topic")
            pressed_topic = text(entry, "pressed_topic")
            if state_topic != f"{expected_prefix}/state":
                fail(f"{control_id} has a noncanonical state topic.")
            if joint_topic != f"{expected_prefix}/joint_states":
                fail(f"{control_id} has a noncanonical joint-state topic.")
            if pressed_topic != f"{expected_prefix}/pressed":
                fail(f"{control_id} has a noncanonical activation topic.")
            state_topics.append(state_topic)
            joint_topics.append(joint_topic)

            expected_states = list(
                spec.get("state_ids", defaults.get("state_ids", []))
            )
            plugin_states = text(entry, "state_ids").split()
            if plugin_states != expected_states:
                fail(f"{control_id} plugin/config state IDs differ.")
            expected_positions = numbers(
                spec.get(
                    "state_positions",
                    defaults.get("state_positions", []),
                ),
                f"{control_id}.state_positions",
            )
            reset_position = float(
                entry.findtext("reset_position", default="0.0")
            )
            if not any(
                math.isclose(
                    reset_position,
                    position,
                    rel_tol=0.0,
                    abs_tol=1.0e-6,
                )
                for position in expected_positions
            ):
                fail(f"{control_id} reset position is not a catalog state.")
            graspable = entry.findtext("graspable", default="false").strip()
            expected_graspable = control_type != "button"
            if (graspable.lower() == "true") != expected_graspable:
                fail(f"{control_id} has inconsistent graspability.")
            if control_type == "button":
                press_threshold = float(text(entry, "press_threshold"))
                release_threshold = float(text(entry, "release_threshold"))
                if not math.isclose(
                    press_threshold,
                    expected_positions[-1],
                    rel_tol=0.0,
                    abs_tol=1.0e-6,
                ) or not 0.0 <= release_threshold < press_threshold:
                    fail(f"{control_id} has invalid press/release thresholds.")
            else:
                detents = numbers(
                    text(entry, "detents"),
                    f"{control_id}.detents",
                )
                if not close_lists(detents, expected_positions):
                    fail(f"{control_id} plugin/config detents differ.")
                actuation_collisions = [
                    collision.text.strip()
                    for collision in entry.findall("actuation_collision")
                    if collision.text and collision.text.strip()
                ]
                if control_type == "switch" and actuation_collisions != [
                    "cabinet_switch_handle_collision"
                ]:
                    fail(
                        "Rear switch actuation must suppress its physical "
                        "handle collision."
                    )
                if control_type == "switch":
                    grasp_stiffness = float(
                        text(entry, "grasp_stiffness")
                    )
                    grasp_damping = float(text(entry, "grasp_damping"))
                    coupling_stiffness = float(
                        text(entry, "grasp_coupling_stiffness")
                    )
                    coupling_damping = float(
                        text(entry, "grasp_coupling_damping")
                    )
                    coupling_max_effort = float(
                        text(entry, "grasp_coupling_max_effort")
                    )
                    if not 0.0 <= grasp_stiffness <= 0.20:
                        fail(
                            "Rear switch grasp preload must not recreate a "
                            "rigid detent loop."
                        )
                    if not 0.05 <= grasp_damping <= 0.50:
                        fail(
                            "Rear switch grasp damping is outside "
                            "[0.05, 0.50]."
                        )
                    if not 1.0 <= coupling_stiffness <= 10.0:
                        fail(
                            "Rear switch compliant coupling stiffness is "
                            "outside [1.0, 10.0]."
                        )
                    if not 0.05 <= coupling_damping <= 1.0:
                        fail(
                            "Rear switch compliant coupling damping is "
                            "outside [0.05, 1.0]."
                        )
                    if not 0.25 <= coupling_max_effort <= 5.0:
                        fail(
                            "Rear switch compliant coupling effort is "
                            "outside [0.25, 5.0]."
                        )
                if control_type == "door":
                    stiffness = float(text(entry, "detent_stiffness"))
                    grasp_stiffness = float(text(entry, "grasp_stiffness"))
                    damping = float(text(entry, "spring_damping"))
                    grasp_damping = float(text(entry, "grasp_damping"))
                    coupling_stiffness = float(
                        text(entry, "grasp_coupling_stiffness")
                    )
                    coupling_damping = float(
                        text(entry, "grasp_coupling_damping")
                    )
                    coupling_max_effort = float(
                        text(entry, "grasp_coupling_max_effort")
                    )
                    hysteresis = float(text(entry, "detent_hysteresis"))
                    if (
                        not 40.0 <= stiffness <= 80.0
                        or not 20.0 <= damping <= 32.0
                    ):
                        fail(
                            "Door closer must remain near critically damped "
                            "for the configured panel inertia."
                        )
                    if not 0.25 <= grasp_stiffness <= 1.5:
                        fail(
                            "Door detent stiffness while physically grasped "
                            "must represent handle-unlatched preload."
                        )
                    if not 1.0 <= grasp_damping <= 3.0:
                        fail(
                            "Door damping while physically grasped must stay "
                            "low enough for arm-guided motion."
                        )
                    if not 60.0 <= coupling_stiffness <= 100.0:
                        fail(
                            "Door compliant grasp stiffness must remain "
                            "consistent with its hinge inertia."
                        )
                    if not 20.0 <= coupling_damping <= 40.0:
                        fail(
                            "Door compliant grasp damping must remain near "
                            "critical damping."
                        )
                    if not 100.0 <= coupling_max_effort <= 180.0:
                        fail(
                            "Door compliant grasp effort must stay below the "
                            "physical hinge effort limit."
                        )
                    if not 0.01 <= hysteresis <= 0.04:
                        fail("Door detent hysteresis must be in [0.01, 0.04].")
                    if not math.isclose(
                        hysteresis,
                        door_detent_hysteresis,
                        rel_tol=0.0,
                        abs_tol=1.0e-9,
                    ):
                        fail("Door plugin/action detent hysteresis values differ.")
                    if actuation_collisions:
                        fail(
                            "Door and mounted-switch collisions must remain "
                            "physical throughout door actuation."
                        )
        if set(plugin_ids) != set(control_ids) or len(set(plugin_ids)) != 33:
            fail("Plugin and catalog control IDs differ or contain duplicates.")
        if len(set(state_topics)) != 33 or len(set(joint_topics)) != 33:
            fail("Cabinet state or joint-state topics are not unique.")

        door_link = links.get("cabinet_rear_door")
        if door_link is None:
            fail("Expanded cabinet is missing the articulated rear-door link.")
        door_collision_names = {
            collision.attrib.get("name", "")
            for collision in door_link.findall("collision")
        }
        if "cabinet_rear_door_collision" not in door_collision_names:
            fail("Rear door must retain its physical panel collision.")
        if "cabinet_switch_base_collision" not in door_collision_names:
            fail("Rear door must retain the physical switch-base collision.")
        switch_handle_link = links.get("cabinet_switch_handle")
        if switch_handle_link is None or switch_handle_link.find(
            "./collision[@name='cabinet_switch_handle_collision']"
        ) is None:
            fail("Rear switch must retain its named physical handle collision.")
        if any("handle" in name for name in door_collision_names):
            fail(
                "Decorative door-handle contacts must stay disabled; the "
                "near-distance grasp constraint provides physical coupling."
            )
        door_visual_box = door_link.find(
            "./visual[@name='cabinet_rear_door_visual']/geometry/box"
        )
        door_collision_box = door_link.find(
            "./collision[@name='cabinet_rear_door_collision']/geometry/box"
        )
        if door_visual_box is None or door_collision_box is None:
            fail("Rear-door visual and collision geometry must remain boxes.")
        door_visual_size = numbers(
            door_visual_box.attrib.get("size"), "rear-door visual size"
        )
        door_collision_size = numbers(
            door_collision_box.attrib.get("size"), "rear-door collision size"
        )
        door_visual_origin = door_link.find(
            "./visual[@name='cabinet_rear_door_visual']/origin"
        )
        door_collision_origin = door_link.find(
            "./collision[@name='cabinet_rear_door_collision']/origin"
        )
        if door_visual_origin is None or door_collision_origin is None:
            fail("Rear-door visual and collision origins must remain explicit.")
        door_visual_xyz = numbers(
            door_visual_origin.attrib.get("xyz"), "rear-door visual origin"
        )
        door_collision_xyz = numbers(
            door_collision_origin.attrib.get("xyz"),
            "rear-door collision origin",
        )
        if (
            len(door_visual_size) != 3
            or len(door_collision_size) != 3
            or len(door_visual_xyz) != 3
            or len(door_collision_xyz) != 3
            or not close_lists(door_visual_size, [0.636, 2.204, 0.010])
            or not close_lists(door_collision_size, [0.634, 2.202, 0.010])
            or not close_lists(door_visual_xyz, [0.321, 1.105, -0.008])
            or not close_lists(door_collision_xyz, [0.321, 1.105, -0.009])
        ):
            fail(
                "Rear-door visual must keep a 3 mm frame reveal and its "
                "physical collision must stay only 1 mm inside that shell."
            )

        # Derive the nearest articulated parent from the URDF link tree.  This
        # catches the rear-door switch case that otherwise plans against its
        # closed-door coordinates after the door moves.
        for control_id in control_ids:
            joint = joints[str(controls[control_id]["joint_name"])]
            parent = joint.find("parent")
            parent_link = (
                parent.attrib.get("link", "") if parent is not None else ""
            )
            derived_parent = ""
            visited = set()
            while parent_link and parent_link not in visited:
                visited.add(parent_link)
                if parent_link in control_child_links:
                    derived_parent = control_child_links[parent_link]
                    break
                parent_joint = child_to_joint.get(parent_link)
                if parent_joint is None:
                    break
                parent_element = parent_joint.find("parent")
                parent_link = (
                    parent_element.attrib.get("link", "")
                    if parent_element is not None
                    else ""
                )
            configured_parent = str(
                controls[control_id].get("parent_control_id", "")
            )
            if configured_parent != derived_parent:
                fail(
                    f"{control_id} parent mismatch: config="
                    f"'{configured_parent}', URDF='{derived_parent}'."
                )

        planning_source = PLANNING_SCENE.read_text(encoding="utf-8")
        front_ids = {
            control_id
            for control_id in control_ids
            if controls[control_id]["type"] in {"button", "knob"}
        }
        if len(front_ids) != 31:
            fail("Shared control profile must contain 31 front controls.")
        door_scene = scene_parameters.get("door")
        switch_scene = scene_parameters.get("switch")
        collision_scene = scene_parameters.get("control_collision")
        if not all(
            isinstance(value, dict)
            for value in (door_scene, switch_scene, collision_scene)
        ):
            fail("Scene profile is missing door, switch or control geometry.")
        if door_scene.get("control_id") != "cabinet_rear_door":
            fail("Scene profile does not select the articulated rear door.")
        if switch_scene.get("control_id") != "cabinet_main_switch":
            fail("Scene profile does not select the rear-door switch.")
        if switch_scene.get("parent_control_id") != door_scene.get("control_id"):
            fail("Scene switch must be parented to the configured door.")
        expected_scene_geometry = {
            "control_collision.button_size": ([0.012, 0.015], collision_scene.get("button_size")),
            "control_collision.knob_size": ([0.046, 0.050], collision_scene.get("knob_size")),
            "door.panel_size": ([0.636, 2.204, 0.011], door_scene.get("panel_size")),
            "door.panel_position": ([0.321, 1.105, -0.0085], door_scene.get("panel_position")),
        }
        for field, (expected, configured) in expected_scene_geometry.items():
            if not close_lists(numbers(configured, field), expected):
                fail(f"{field} differs from the verified cabinet envelope.")
        if not math.isclose(
            float(collision_scene.get("button_center_offset", 0.0)),
            0.0055,
            rel_tol=0.0,
            abs_tol=1.0e-9,
        ):
            fail("Button collision center offset differs from the URDF.")
        if "kControlCollisions" in planning_source:
            fail("Planning scene must not duplicate the YAML control catalog.")
        for scene_requirement in (
            '"control_ids"',
            '"controls." + id + "."',
            "lookupTransform(",
            "require_pose_valid_",
            "objects.push_back(make_door_panel(model, door_position));",
            "objects.push_back(make_door_handle(model, door_position, true));",
            "std::chrono::milliseconds(50)",
        ):
            if scene_requirement not in planning_source:
                fail(
                    "Planning scene must consume the shared catalog and TF, "
                    "retain the door panel, and remove only the active handle."
                )

        prismatic_count = sum(
            joint.attrib.get("type") == "prismatic" for joint in joints.values()
        )
        revolute_count = sum(
            joint.attrib.get("type") == "revolute" for joint in joints.values()
        )
        if prismatic_count != 20 or revolute_count != 13:
            fail(
                "Expanded cabinet must contain 20 prismatic and 13 revolute "
                f"joints; got {prismatic_count} and {revolute_count}."
            )

        robot_description = render_xacro(ROBOT_XACRO, f"toolset:={TOOLSET}")
        validate_rcl_parameter_value(robot_description)
        robot_root = ElementTree.fromstring(robot_description)
        robot_links = {
            link.attrib.get("name", ""): link
            for link in robot_root.findall("link")
        }
        robot_joints = {
            joint.attrib.get("name", ""): joint
            for joint in robot_root.findall("joint")
        }
        child_to_robot_joint = {
            joint.find("child").attrib.get("link", ""): joint
            for joint in robot_joints.values()
            if joint.find("child") is not None
        }

        # Tools mount under the robot's native wrist boss (the model's
        # end-effector interface): each SolidWorks z=0 base face is centred on
        # the boss axis and seated just below the wrist ball tip, so the boss
        # nests into the tool top with no fabricated carrier plate and no
        # lateral offset.  xyz is the measured boss-centred seat in the arm_6
        # link frame; rpy encodes the per-arm downstream orientation (working
        # end pointing away from the wrist).
        expected_tool_mounts = {
            "r_three_cyl_base": (
                "r_arm_6",
                [0.005, 0.0, -0.2185],
                [0.0, 0.0, 0.0],
            ),
            "l_two_cyl_base": (
                "l_arm_6",
                [0.005, 0.0, 0.2185],
                [0.0, math.pi, 0.0],
            ),
            "r_rotbtn_body": (
                "r_arm_6",
                [0.005, 0.0, -0.2185],
                [0.0, math.pi, 0.0],
            ),
            "l_rocker_body": (
                "l_arm_6",
                [0.005, 0.0, 0.2185],
                [0.0, 0.0, 0.0],
            ),
        }
        for carrier_name in ("r_tool_carrier", "l_tool_carrier"):
            if carrier_name in robot_links:
                fail(
                    f"Expanded robot must not contain fabricated carrier "
                    f"plate {carrier_name}; tools mount flush on the native "
                    "wrist flange."
                )
        for tool_name, (wrist_name, expected_xyz, expected_rpy) in (
            expected_tool_mounts.items()
        ):
            if tool_name in inactive_contact_links():
                if tool_name in robot_links:
                    fail(
                        f"Tool link {tool_name} belongs to inactive toolset "
                        f"{'B' if TOOLSET == 'A' else 'A'} but is still "
                        f"mounted in toolset {TOOLSET}."
                    )
                continue
            if tool_name not in robot_links:
                fail(
                    f"Expanded robot is missing tool link {tool_name} for "
                    f"toolset {TOOLSET}."
                )
            mount_joint = child_to_robot_joint.get(tool_name)
            mount_parent = (
                ""
                if mount_joint is None
                or mount_joint.find("parent") is None
                else mount_joint.find("parent").attrib.get("link", "")
            )
            mount_origin = (
                None if mount_joint is None else mount_joint.find("origin")
            )
            if (
                mount_joint is None
                or mount_joint.attrib.get("type") != "fixed"
                or mount_parent != wrist_name
                or mount_origin is None
                or not close_lists(
                    numbers(
                        mount_origin.attrib.get("xyz"),
                        f"{tool_name} mount origin",
                    ),
                    expected_xyz,
                )
                or not close_lists(
                    numbers(
                        mount_origin.attrib.get("rpy"),
                        f"{tool_name} mount orientation",
                    ),
                    expected_rpy,
                )
            ):
                fail(
                    f"{tool_name} must be fixed at the {wrist_name} "
                    f"boss-centred seat below the wrist ball tip "
                    f"(xyz {expected_xyz}, rpy {expected_rpy})."
                )


        # Tool profiles must describe the unchanged fixed hardware.  The
        # three-cylinder's working finger is off-axis, so button/door poses
        # require its complete measured business-point vector rather than a
        # scalar length that would aim the empty tool centre at the panel.
        # These values do not claim physical reachability; unreachable
        # controls remain planning-only until closed-loop validation succeeds.
        expected_tool_profiles = {
            "button": (
                "right_arm",
                "r_three_cyl_base",
                [0.0265, -0.061735, -0.3885],
            ),
            # The knob profile carries the measured jaw-clamp centre (3-D
            # business point) so the pincer jaws, not the body origin, land on
            # the control grasp point.  Validated below via the list branch.
            "knob": ("right_arm", "r_rotbtn_body", [-0.0613, -0.006, 0.1885]),
            # The switch profile likewise carries the rotor-joint centre (3-D
            # business point) in the rocker body frame, so the rotor (not the
            # body origin) lands on the switch handle.
            "switch": ("left_arm", "l_rocker_body", [-0.01, -0.07, 0.2611]),
            "door": (
                "right_arm",
                "r_three_cyl_base",
                [0.0265, -0.061735, -0.3885],
            ),
        }
        if not math.isclose(
            float(
                robot_parameters.get(
                    "tool_tip_calibration_joint_tolerance", float("nan")
                )
            ),
            0.001,
            rel_tol=0.0,
            abs_tol=1.0e-12,
        ):
            fail(
                "Robot adapter tool tip calibration joint tolerance must "
                "remain 0.001."
            )
        tool_profiles = robot_parameters.get("tool_profiles")
        if not isinstance(tool_profiles, dict) or set(tool_profiles) != set(
            expected_tool_profiles
        ):
            fail(
                "Robot adapter tool_profiles must cover exactly button, knob, "
                "switch and door."
            )
        for control_type, (move_group, contact_link, expected_tip) in (
            expected_tool_profiles.items()
        ):
            profile = tool_profiles[control_type]
            if not isinstance(profile, dict):
                fail(f"Robot adapter tool_profiles.{control_type} is invalid.")
            if profile.get("move_group") != move_group:
                fail(
                    f"Robot adapter {control_type} must use MoveIt group "
                    f"{move_group}."
                )
            if profile.get("contact_tool_link") != contact_link:
                fail(
                    f"Robot adapter {control_type} must use the unchanged "
                    f"hardware link {contact_link}."
                )
            if isinstance(expected_tip, list):
                tip_position = numbers(
                    profile.get("tool_tip_position"),
                    f"tool_profiles.{control_type}.tool_tip_position",
                )
                if not close_lists(tip_position, expected_tip):
                    fail(
                        f"Robot adapter {control_type} must retain the "
                        "measured 3-D business point."
                    )
                if "tool_tip_offset" in profile:
                    fail(
                        f"Robot adapter {control_type} must not mix the "
                        "3-D business point with legacy tool_tip_offset."
                    )
                # Only the three-cylinder end-effector pins its calibration
                # joints to the measured zero pose; the pincer knob tool has
                # no such joints.
                if "calibration_joint_names" in profile:
                    if profile.get("calibration_joint_names") != (
                        THREE_CYLINDER_JOINTS
                    ) or not close_lists(
                        numbers(
                            profile.get("calibration_joint_positions"),
                            f"tool_profiles.{control_type}."
                            "calibration_joint_positions",
                        ),
                        [0.0, 0.0, 0.0],
                    ):
                        fail(
                            f"Robot adapter {control_type} must require all "
                            "three cylinder joints at the measured zero pose."
                        )
            else:
                tip_offset = profile.get("tool_tip_offset")
                if (
                    isinstance(tip_offset, bool)
                    or not isinstance(tip_offset, (int, float))
                    or not math.isfinite(float(tip_offset))
                    or not math.isclose(
                        float(tip_offset),
                        expected_tip,
                        rel_tol=0.0,
                        abs_tol=1.0e-12,
                    )
                ):
                    fail(
                        f"Robot adapter {control_type} must retain its "
                        f"calibrated {expected_tip:.3f} m axial tip offset."
                    )
            if profile.get("transport_named_target") != "home":
                fail(
                    f"Robot adapter {control_type} transport target must be home."
                )
            # Pincer tools (knob / switch) carry their jaws/rotor on local +Z,
            # so +Z must face the control (toward_control) and their zero-point
            # grasp probe must use the jaw/rotor carrier.  The door keeps the
            # three-cylinder base as grasp_link but probes the calibrated
            # off-axis finger tip in that link, rather than its distant origin.
            expected_grasp_link = {
                "knob": "r_rotbtn_rotate",
                "switch": "l_rocker_rotor",
            }.get(control_type)
            expected_grasp_point = (
                expected_tip if control_type == "door" else [0.0, 0.0, 0.0]
            )
            grasp_point = numbers(
                profile.get("grasp_point_position", [0.0, 0.0, 0.0]),
                f"tool_profiles.{control_type}.grasp_point_position",
            )
            if not close_lists(grasp_point, expected_grasp_point):
                fail(
                    f"Robot adapter {control_type} grasp probe must be "
                    f"{expected_grasp_point} in grasp_link coordinates."
                )
            if expected_grasp_link is not None:
                if profile.get("grasp_link") != expected_grasp_link:
                    fail(
                        f"Robot adapter {control_type} must probe the grasp "
                        f"distance with grasp_link {expected_grasp_link}."
                    )
                if profile.get("tool_axis_orientation") != "toward_control":
                    fail(
                        f"Robot adapter {control_type} must use "
                        "tool_axis_orientation toward_control (pincer +Z "
                        "faces the control)."
                    )
            else:
                if "grasp_link" in profile or profile.get(
                    "tool_axis_orientation", "along_outward"
                ) != "along_outward":
                    fail(
                        f"Robot adapter {control_type} must keep the legacy "
                        "along_outward axis and no grasp_link override."
                    )
            if contact_link in inactive_contact_links():
                # The inactive toolset's hardware must not be mounted at all
                # (strict exclusivity for the --toolset validation).
                if contact_link in robot_links:
                    fail(
                        f"Tool link {contact_link} belongs to inactive "
                        f"toolset {'B' if TOOLSET == 'A' else 'A'} but is "
                        f"still mounted in toolset {TOOLSET}."
                    )
                continue
            if contact_link not in robot_links:
                fail(
                    f"Expanded robot is missing tool link {contact_link} for "
                    f"toolset {TOOLSET}."
                )
            wrist = "r_arm_6" if contact_link.startswith("r_") else "l_arm_6"
            # Tools mount under the native wrist boss.  Each SolidWorks z=0
            # base face is centred on the boss axis, seated just below the
            # wrist ball tip (measured in the arm_6 link frame), with the
            # working end pointing downstream.  No fabricated carrier plate.
            expected_mounts = {
                "r_three_cyl_base": (
                    "r_arm_6",
                    [0.005, 0.0, -0.2185],
                    [0.0, 0.0, 0.0],
                ),
                "l_two_cyl_base": (
                    "l_arm_6",
                    [0.005, 0.0, 0.2185],
                    [0.0, math.pi, 0.0],
                ),
                "r_rotbtn_body": (
                    "r_arm_6",
                    [0.005, 0.0, -0.2185],
                    [0.0, math.pi, 0.0],
                ),
                "l_rocker_body": (
                    "l_arm_6",
                    [0.005, 0.0, 0.2185],
                    [0.0, 0.0, 0.0],
                ),
            }
            expected_wrist, expected_xyz, expected_rpy = expected_mounts[
                contact_link
            ]
            mount_joint = child_to_robot_joint.get(contact_link)
            mount_parent = (
                ""
                if mount_joint is None or mount_joint.find("parent") is None
                else mount_joint.find("parent").attrib.get("link", "")
            )
            mount_origin = (
                None if mount_joint is None else mount_joint.find("origin")
            )
            if (
                mount_joint is None
                or mount_joint.attrib.get("type") != "fixed"
                or mount_parent != expected_wrist
                or mount_origin is None
                or not close_lists(
                    numbers(
                        mount_origin.attrib.get("xyz"),
                        f"{contact_link} mount origin",
                    ),
                    expected_xyz,
                )
                or not close_lists(
                    numbers(
                        mount_origin.attrib.get("rpy"),
                        f"{contact_link} mount orientation",
                    ),
                    expected_rpy,
                )
            ):
                fail(
                    f"Unchanged tool link {contact_link} must remain fixed at "
                    f"the {expected_wrist} boss-centred seat below the wrist "
                    f"ball tip (xyz {expected_xyz}, rpy {expected_rpy})."
                )


        robot_sensors = {
            sensor.attrib.get("name", ""): sensor
            for sensor in robot_root.findall(".//sensor")
        }
        arm_camera = robot_sensors.get("arm_camera")
        if arm_camera is None or arm_camera.attrib.get("type") != "camera":
            fail("Expanded robot must contain the arm RGB camera sensor.")
        camera_update_rate = float(text(arm_camera, "update_rate"))
        camera_width = int(text(arm_camera, "camera/image/width"))
        camera_height = int(text(arm_camera, "camera/image/height"))
        if (
            not math.isclose(
                camera_update_rate, 15.0, rel_tol=0.0, abs_tol=1.0e-9
            )
            or camera_width != 640
            or camera_height != 640
        ):
            fail("Arm camera performance contract must be 640x640 at 15 Hz.")

        body_lidar = robot_sensors.get("body_lidar")
        if body_lidar is None or body_lidar.attrib.get("type") != "ray":
            fail("Expanded robot must contain the body planar lidar sensor.")
        lidar_update_rate = float(text(body_lidar, "update_rate"))
        lidar_samples = int(text(body_lidar, "ray/scan/horizontal/samples"))
        if not math.isclose(
            lidar_update_rate, 20.0, rel_tol=0.0, abs_tol=1.0e-9
        ) or lidar_samples != 360:
            fail("Body lidar performance contract must be 360 samples at 20 Hz.")

        wheel_links = {
            "l_wheel_0",
            "l_wheel_1",
            "r_wheel_0",
            "r_wheel_1",
        }
        wheel_gazebo = {
            candidate.attrib.get("reference", ""): candidate
            for candidate in robot_root.findall("./gazebo")
            if candidate.attrib.get("reference", "") in wheel_links
        }
        if set(wheel_gazebo) != wheel_links:
            fail("Expanded robot must configure all four wheel contact surfaces.")
        for wheel_name, wheel_contact in wheel_gazebo.items():
            mu1 = float(text(wheel_contact, "mu1"))
            mu2 = float(text(wheel_contact, "mu2"))
            if not math.isclose(
                mu1, 0.10, rel_tol=0.0, abs_tol=1.0e-12
            ) or not math.isclose(mu2, 0.10, rel_tol=0.0, abs_tol=1.0e-12):
                fail(
                    f"{wheel_name} must keep the 0.10 damping surface friction "
                    "when gazebo_ros_planar_move owns holonomic motion."
                )

        planar_move = next(
            (
                candidate
                for candidate in robot_root.findall(".//plugin")
                if candidate.attrib.get("filename")
                == "libgazebo_ros_planar_move.so"
            ),
            None,
        )
        if planar_move is None:
            fail("Gazebo planar-move plugin is absent from the robot URDF.")
        planar_update_rate = float(text(planar_move, "update_rate"))
        planar_publish_rate = float(text(planar_move, "publish_rate"))
        if not math.isclose(
            planar_update_rate, 500.0, rel_tol=0.0, abs_tol=1.0e-9
        ) or not math.isclose(
            planar_publish_rate, 20.0, rel_tol=0.0, abs_tol=1.0e-9
        ):
            fail(
                "Planar mover must update at 500 Hz and publish odometry at "
                "20 Hz."
            )
        updates_per_publish = planar_update_rate / planar_publish_rate
        if not math.isclose(
            updates_per_publish,
            round(updates_per_publish),
            rel_tol=0.0,
            abs_tol=1.0e-9,
        ):
            fail(
                "Planar update rate must be an integer multiple of its odometry "
                "publish rate."
            )

        world_root = ElementTree.parse(SIMULATION_WORLD).getroot()
        physics = world_root.find("./world/physics")
        if physics is None:
            fail("Simulation world is missing its physics profile.")
        if (
            not math.isclose(
                float(text(physics, "max_step_size")),
                0.002,
                rel_tol=0.0,
                abs_tol=1.0e-12,
            )
            or int(text(physics, "real_time_update_rate")) != 500
            or int(text(physics, "ode/solver/iters")) != 80
        ):
            fail(
                "Simulation performance profile must remain at 2 ms, 500 Hz "
                "and 80 ODE solver iterations."
            )
        forbidden_lift_links = {"arm_lift", "arm_lift_mast"}
        robot_links = {
            link.attrib.get("name", "") for link in robot_root.findall("./link")
        }
        if forbidden_lift_links & robot_links:
            fail("Robot URDF still contains an arm-lift link.")
        forbidden_lift_joints = {"body_arm_lift", "body_arm_lift_mast"}
        robot_joints = {
            joint.attrib.get("name", "")
            for joint in robot_root.findall("./joint")
        }
        if forbidden_lift_joints & robot_joints:
            fail("Robot URDF still contains an arm-lift joint.")
        if robot_root.find("./material[@name='guide_steel']") is not None:
            fail("Robot URDF still contains the unused arm-lift material.")
        robot_component_directory = ROBOT_XACRO.parent / "components"
        for component_path in robot_component_directory.glob("*.xacro"):
            component_source = component_path.read_text(encoding="utf-8")
            if (
                "arm_lift" in component_source
                or "guide_steel" in component_source
            ):
                fail(
                    "Robot component source still contains an arm-lift "
                    f"artifact: {component_path.name}."
                )

        gazebo_properties = {
            entry.attrib.get("reference", ""): entry
            for entry in robot_root.findall("./gazebo[@reference]")
        }
        if (forbidden_lift_links | forbidden_lift_joints) & set(
            gazebo_properties
        ):
            fail(
                "Robot Gazebo properties still reference the removed arm lift."
            )

        sdf_root = convert_urdf_to_sdf(robot_root)
        sdf_links = {
            link.attrib.get("name", ""): link
            for link in sdf_root.findall("./model/link")
        }
        if forbidden_lift_links & set(sdf_links):
            fail("Gazebo SDF still contains an arm-lift link.")
        body_sdf = sdf_links.get("body")
        body_gravity = (
            []
            if body_sdf is None
            else [
                (gravity.text or "").strip()
                for gravity in body_sdf.findall("gravity")
            ]
        )
        if body_gravity != ["1"]:
            fail(
                "Gazebo SDF must preserve one gravity=1 setting for body; "
                f"got {body_gravity}."
            )
        for shoulder_name in ("l_arm_0_joint", "r_arm_0_joint"):
            shoulder_joint = robot_root.find(f"./joint[@name='{shoulder_name}']")
            shoulder_parent = (
                None if shoulder_joint is None else shoulder_joint.find("parent")
            )
            if (
                shoulder_parent is None
                or shoulder_parent.attrib.get("link") != "body"
            ):
                fail(
                    f"The dual-arm shoulder '{shoulder_name}' must be mounted "
                    "on body."
                )

        ros2_control_entries = {
            entry.attrib.get("name", ""): entry
            for entry in robot_root.findall(".//ros2_control/joint")
        }
        if forbidden_lift_joints & set(ros2_control_entries):
            fail("ros2_control still exposes a removed arm-lift joint.")
        with INITIAL_POSITIONS.open("r", encoding="utf-8") as stream:
            initial_position_document = yaml.safe_load(stream)
        initial_positions = initial_position_document.get(
            "initial_positions", {}
        )
        arm_joints = LEFT_ARM_JOINTS + RIGHT_ARM_JOINTS
        if not isinstance(initial_positions, dict) or set(
            initial_positions
        ) != set(arm_joints):
            fail(
                "Robot initial_positions.yaml must contain exactly the "
                "fourteen arm joints."
            )
        try:
            initial_positions = {
                joint: float(initial_positions[joint]) for joint in arm_joints
            }
        except (TypeError, ValueError) as error:
            fail(f"Robot initial arm positions must be numeric: {error}")
        if not all(math.isfinite(value) for value in initial_positions.values()):
            fail("Robot initial arm positions must be finite.")
        for joint_name, expected_position in initial_positions.items():
            entry = ros2_control_entries.get(joint_name)
            initial_value = (
                None
                if entry is None
                else entry.find(
                    "./state_interface[@name='position']/"
                    "param[@name='initial_value']"
                )
            )
            try:
                configured_position = float(initial_value.text)
            except (AttributeError, TypeError, ValueError):
                fail(
                    f"ros2_control {joint_name} must expose its spawn-time "
                    "position initial_value."
                )
            if not math.isclose(
                configured_position,
                expected_position,
                rel_tol=0.0,
                abs_tol=1.0e-9,
            ):
                fail(
                    f"ros2_control {joint_name} spawn position differs from "
                    "initial_positions.yaml."
                )
        hold_joints = {
            (entry.text or "").strip()
            for entry in robot_root.findall(".//plugin/hold_joint")
        }
        if forbidden_lift_joints & hold_joints:
            fail(
                "Gazebo planar stabilizer still holds a removed arm-lift joint."
            )
        stabilizer = next(
            (
                candidate
                for candidate in robot_root.findall(".//plugin")
                if candidate.attrib.get("filename")
                == "libxczs_planar_stabilizer.so"
            ),
            None,
        )
        if stabilizer is None:
            fail("Gazebo planar stabilizer plugin is absent.")
        model_plugins = list(robot_root.findall(".//plugin"))
        if model_plugins.index(planar_move) >= model_plugins.index(stabilizer):
            fail(
                "gazebo_ros_planar_move must load before the planar "
                "stabilizer so its WorldUpdateBegin velocity can be sampled."
            )
        if text(stabilizer, "grasp_active_topic") != "/xczs/cabinet/grasp_active":
            fail(
                "Planar stabilizer must consume the aggregated grasp-active "
                "topic."
            )
        if text(stabilizer, "joint_hold_topic") != "/xczs/joint_hold_enabled":
            fail(
                "Planar stabilizer must expose the startup-only joint-hold "
                "topic."
            )
        if text(stabilizer, "cmd_vel_topic") != "/xczs/cmd_vel":
            fail(
                "Planar stabilizer must consume the routed base command so "
                "it can brake the model at rest."
            )
        cmake_source = CONTROL_CMAKE.read_text(encoding="utf-8")
        for lease_build_requirement in (
            '"srv/ManageOperationLease.srv"',
            "add_executable(\n  operation_lease_coordinator",
            "operation_lease_state_test",
        ):
            if lease_build_requirement not in cmake_source:
                fail("Global operation lease build/test wiring is incomplete.")
        stabilizer_dependencies = re.search(
            r"ament_target_dependencies\(\s*xczs_planar_stabilizer(.*?)\)",
            cmake_source,
            re.DOTALL,
        )
        if stabilizer_dependencies is None or not {
            "gazebo_dev",
            "gazebo_ros",
            "geometry_msgs",
            "rclcpp",
            "std_msgs",
        }.issubset(set(stabilizer_dependencies.group(1).split())):
            fail("Planar stabilizer ROS/Gazebo build dependencies are incomplete.")
        stabilizer_source = PLANAR_STABILIZER.read_text(encoding="utf-8")
        if not re.search(
            r"if\s*\(\s*joint_hold_enabled_->load\(\)\s*&&\s*"
            r"!grasp_active_->load\(\)\s*\)\s*\{\s*"
            r"restore_joint_positions\(\);",
            stabilizer_source,
            re.DOTALL,
        ):
            fail(
                "Planar stabilizer must restore joints only during its "
                "startup hold and never while grasping."
            )
        if "joint_hold_subscription_" not in stabilizer_source:
            fail("Planar stabilizer is missing the startup joint-hold subscription.")
        initial_pose_source = (
            ROOT
            / "xczs_inspection_robot_control"
            / "scripts"
            / "verify_initial_pose.py"
        ).read_text(encoding="utf-8")
        if (
            "release_startup_joint_hold" not in initial_pose_source
            or "DEFAULT_JOINT_HOLD_TOPIC" not in initial_pose_source
        ):
            fail(
                "Initial-pose verification must release the startup-only "
                "joint hold after success."
            )
        for stop_lock_requirement in (
            "cmd_vel_subscription_",
            "base_command_moving_",
            "planar_pose_is_locked_",
            "locked_planar_yaw_",
        ):
            if stop_lock_requirement not in stabilizer_source:
                fail(
                    "Planar stabilizer is missing the zero-command pose lock."
                )

        launch_source = CONTROL_LAUNCH.read_text(encoding="utf-8")
        if launch_source.count('executable="operation_lease_coordinator"') != 1:
            fail("Unified launch must start exactly one lease coordinator.")
        for router_executable in (
            "base_command_router",
            "legacy_trajectory_router",
        ):
            router_launch = re.search(
                r'executable=["\']'
                + re.escape(router_executable)
                + r'["\'].*?parameters=\[(.*?)\]\s*,',
                launch_source,
                re.DOTALL,
            )
            if router_launch is None or not re.search(
                r"LaunchConfiguration\(\s*"
                r'["\']cabinet_robot_adapter["\']\s*\)',
                router_launch.group(1),
            ):
                fail(
                    f"Unified launch must pass the robot adapter to "
                    f"{router_executable}."
                )
        if not re.search(
            r"\.planning_pipelines\(\s*"
            r"default_planning_pipeline=[\"']ompl[\"']\s*,\s*"
            r"pipelines=\[[\"']ompl[\"']\]\s*,?\s*\)",
            launch_source,
            re.DOTALL,
        ):
            fail("Unified launch must restrict its MoveIt client to OMPL.")
        moveit_client_builder = re.search(
            r"moveit_client_config\s*=\s*\((.*?)"
            r"\.to_moveit_configs\(\)\s*\)",
            launch_source,
            re.DOTALL,
        )
        if moveit_client_builder is None or not re.search(
            r"\.joint_limits\(\s*file_path\s*=\s*"
            r"moveit_joint_limits\s*\)",
            moveit_client_builder.group(1),
        ):
            fail(
                "Cabinet operator MoveIt client must load the configured "
                "joint_limits file."
            )
        operator_launch = re.search(
            r'executable=["\']cabinet_button_operator["\'].*?'
            r"parameters=\[(.*?)\]\s*,",
            launch_source,
            re.DOTALL,
        )
        if operator_launch is None:
            fail("Unified launch must configure the cabinet operator node.")
        required_client_parameters = (
            "moveit_client_config.robot_description",
            "moveit_client_config.robot_description_semantic",
            "moveit_client_config.robot_description_kinematics",
            "moveit_client_config.joint_limits",
        )
        if not all(
            parameter in operator_launch.group(1)
            for parameter in required_client_parameters
        ):
            fail(
                "Cabinet operator must receive explicit URDF, SRDF, "
                "kinematics and joint-limit parameters."
            )

        with ROS2_CONTROLLERS.open("r", encoding="utf-8") as stream:
            controller_config = yaml.safe_load(stream)
        controller_manager = controller_config["/xczs/controller_manager"][
            "ros__parameters"
        ]
        if "joint_state_broadcaster" not in controller_manager:
            fail("ros2_control must register a joint_state_broadcaster.")
        for group_name, joint_names in active_joint_groups().items():
            controller_name = f"{group_name}_controller"
            if controller_name not in controller_manager:
                fail(f"ros2_control must register {controller_name}.")
            controller_key = f"/xczs/{controller_name}"
            configured_joints = controller_config.get(controller_key, {}).get(
                "ros__parameters", {}
            ).get("joints")
            if configured_joints != joint_names:
                fail(
                    f"ros2_control {controller_name} joint order differs from "
                    "the dual-arm topology."
                )
        for arm_controller in ("left_arm_controller", "right_arm_controller"):
            if controller_config[f"/xczs/{arm_controller}"][
                "ros__parameters"
            ].get("allow_partial_joints_goal") is not False:
                fail(f"{arm_controller} must reject partial joint goals.")

        with MOVEIT_CONTROLLERS.open("r", encoding="utf-8") as stream:
            moveit_controllers = yaml.safe_load(stream)
        moveit_manager = moveit_controllers["moveit_simple_controller_manager"]
        expected_controller_names = [
            f"xczs/{group_name}_controller"
            for group_name in active_joint_groups()
        ]
        if moveit_manager["controller_names"] != expected_controller_names:
            fail("MoveIt controller names differ from the dual-arm controllers.")
        for group_name, joint_names in active_joint_groups().items():
            controller_key = f"xczs/{group_name}_controller"
            if moveit_manager[controller_key]["joints"] != joint_names:
                fail(
                    f"MoveIt controller {controller_key} joint order differs "
                    "from ros2_control."
                )
        with JOINT_LIMITS.open("r", encoding="utf-8") as stream:
            moveit_limits = yaml.safe_load(stream)["joint_limits"]
        if "body_arm_lift" in moveit_limits:
            fail("MoveIt joint limits still contain the removed arm lift.")
        active_robot_joints = {
            joint
            for joints in active_joint_groups().values()
            for joint in joints
        }
        if not active_robot_joints.issubset(moveit_limits):
            fail("MoveIt joint limits do not cover the complete dual-arm robot.")
        with OMPL_PLANNING.open("r", encoding="utf-8") as stream:
            ompl_config = yaml.safe_load(stream)
        expected_projections = {
            "left_arm": "joints(l_arm_0_joint,l_arm_1_joint)",
            "right_arm": "joints(r_arm_0_joint,r_arm_1_joint)",
        }
        for planning_group, projection in expected_projections.items():
            if ompl_config.get(planning_group, {}).get(
                "projection_evaluator"
            ) != projection:
                fail(
                    f"MoveIt OMPL group {planning_group} does not project the "
                    "first two dual-arm joints."
                )

        srdf_root = ElementTree.parse(SRDF).getroot()
        for group_name, joint_names in active_joint_groups().items():
            group = srdf_root.find(f"./group[@name='{group_name}']")
            if group_name in ("left_arm", "right_arm"):
                chain = None if group is None else group.find("chain")
                if (
                    chain is None
                    or chain.attrib.get("base_link") != "body"
                    or chain.attrib.get("tip_link")
                    != f"{group_name[0]}_arm_6"
                ):
                    fail(f"MoveIt {group_name} chain must span body to wrist.")
                continue
            configured_group_joints = {
                (joint.attrib.get("name") if joint is not None else None)
                for joint in ([] if group is None else group.findall("joint"))
            }
            if configured_group_joints != set(joint_names):
                fail(f"MoveIt {group_name} group joints differ from the model.")
        for group_name in ("left_arm", "right_arm"):
            home = srdf_root.find(
                f"./group_state[@name='home'][@group='{group_name}']"
            )
            home_joints = {
                entry.attrib.get("name", ""): float(
                    entry.attrib.get("value", "nan")
                )
                for entry in ([] if home is None else home.findall("joint"))
            }
            if set(home_joints) != set(JOINT_GROUPS[group_name]) or any(
                not math.isclose(
                    home_joints[joint],
                    initial_positions[joint],
                    rel_tol=0.0,
                    abs_tol=1.0e-9,
                )
                for joint in JOINT_GROUPS[group_name]
            ):
                fail(
                    f"MoveIt {group_name} home state must match the shared "
                    "spawn/reset transport pose."
                )
        manual_joint_limits = robot_parameters.get("manual_joint_limits")
        if not isinstance(manual_joint_limits, dict):
            fail("Robot adapter manual_joint_limits must be a mapping.")
        for joint_name, expected_position in initial_positions.items():
            limit = manual_joint_limits.get(joint_name)
            try:
                reset_position = float(limit["default_position"])
            except (KeyError, TypeError, ValueError):
                fail(
                    f"Robot adapter {joint_name} requires a numeric "
                    "default_position."
                )
            if not math.isclose(
                reset_position,
                expected_position,
                rel_tol=0.0,
                abs_tol=1.0e-9,
            ):
                fail(
                    f"Robot adapter {joint_name} reset position differs from "
                    "initial_positions.yaml."
                )
        disabled_pairs = {
            frozenset((entry.attrib.get("link1"), entry.attrib.get("link2")))
            for entry in srdf_root.findall("disable_collisions")
        }
        if any(forbidden_lift_links & pair for pair in disabled_pairs):
            fail("MoveIt SRDF still contains an arm-lift collision exemption.")
        active_wrist_tool_pairs = (
            (
                frozenset(("r_arm_6", "r_three_cyl_base")),
                frozenset(("l_arm_6", "l_two_cyl_base")),
            )
            if TOOLSET == "A"
            else (
                frozenset(("r_arm_6", "r_rotbtn_body")),
                frozenset(("l_arm_6", "l_rocker_body")),
            )
        )
        required_adjacencies = set(active_wrist_tool_pairs)
        if not required_adjacencies.issubset(disabled_pairs):
            fail(
                "MoveIt SRDF must exempt only the directly connected "
                "overlapping wrist-flange/tool pairs."
            )
        if any(inactive_contact_links() & pair for pair in disabled_pairs):
            fail(
                "MoveIt SRDF must not exempt collisions for the inactive "
                "toolset's tool links."
            )
        tool_base_links = {
            "r_three_cyl_base",
            "r_rotbtn_body",
            "l_two_cyl_base",
            "l_rocker_body",
        }
        nonadjacent_forearms = {
            f"{side}_arm_{index}"
            for side in ("r", "l")
            for index in (3, 4, 5)
        }
        if any(
            pair & tool_base_links
            and pair & nonadjacent_forearms
            for pair in disabled_pairs
        ):
            fail(
                "MoveIt SRDF must not hide a tool collision with "
                "arm_3, arm_4 or arm_5; calibrate a collision-free pose."
            )
        # The fortune-cat idle pose folds the right wrist to sub-mm packing
        # against r_arm_4; the verified exemption (02de59c) keeps exactly that
        # one packed pair.  Any other non-adjacent arm_4/arm_6 self-collision
        # exemption hides a real collision and is forbidden.
        forbidden_wrist_exemptions = {frozenset(("l_arm_4", "l_arm_6"))}
        if forbidden_wrist_exemptions & disabled_pairs:
            fail(
                "MoveIt SRDF must not hide the left non-adjacent arm_4/arm_6 "
                "self-collision; calibrate a genuinely collision-free "
                "spawn/home pose."
            )
        right_wrist_exemption = next(
            (
                entry
                for entry in srdf_root.findall("disable_collisions")
                if {
                    entry.attrib.get("link1"),
                    entry.attrib.get("link2"),
                }
                == {"r_arm_4", "r_arm_6"}
            ),
            None,
        )
        if right_wrist_exemption is not None and (
            right_wrist_exemption.attrib.get("reason")
            != "Packed wrist gap in folded idle pose"
        ):
            fail(
                "The right wrist arm_4/arm_6 exemption must keep the verified "
                "'Packed wrist gap in folded idle pose' reason."
            )
        for body_pair in (
            {"body", "l_arm_0"},
            {"body", "r_arm_0"},
        ):
            body_collision = next(
                (
                    entry
                    for entry in srdf_root.findall("disable_collisions")
                    if {
                        entry.attrib.get("link1"),
                        entry.attrib.get("link2"),
                    }
                    == body_pair
                ),
                None,
            )
            if (
                body_collision is None
                or body_collision.attrib.get("reason") != "Adjacent"
            ):
                fail(
                    "MoveIt SRDF must mark body and each shoulder as adjacent "
                    "links."
                )
        legacy_router_source = LEGACY_TRAJECTORY_ROUTER.read_text(
            encoding="utf-8"
        )
        if "body_arm_lift" in legacy_router_source:
            fail(
                "Legacy trajectory routing still exposes the removed arm lift."
            )

        with NAV2_CONFIG.open("r", encoding="utf-8") as stream:
            nav2_config = yaml.safe_load(stream)
        configured_docking_footprint = numbers(
            robot_parameters.get("docking_base_footprint"),
            "Robot adapter docking_base_footprint",
        )
        if (
            len(configured_docking_footprint) < 6
            or len(configured_docking_footprint) % 2 != 0
        ):
            fail(
                "Robot adapter docking_base_footprint must contain at least "
                "three flat [x, y] points."
            )
        configured_docking_padding = float(
            robot_parameters.get("docking_base_footprint_padding", -1.0)
        )
        for costmap_name in ("local_costmap", "global_costmap"):
            costmap_parameters = nav2_config[costmap_name][costmap_name][
                "ros__parameters"
            ]
            nav2_footprint_points = yaml.safe_load(
                costmap_parameters["footprint"]
            )
            nav2_flat_footprint = [
                float(coordinate)
                for point in nav2_footprint_points
                for coordinate in point
            ]
            if not close_lists(
                configured_docking_footprint, nav2_flat_footprint
            ) or not math.isclose(
                configured_docking_padding,
                float(costmap_parameters["footprint_padding"]),
                rel_tol=0.0,
                abs_tol=1.0e-12,
            ):
                fail(
                    "Precision docking footprint and padding must exactly "
                    f"reuse Nav2 {costmap_name}."
                )
        controller_parameters = nav2_config["controller_server"][
            "ros__parameters"
        ]
        controller_frequency = float(
            controller_parameters["controller_frequency"]
        )
        local_costmap_frequency = float(
            nav2_config["local_costmap"]["local_costmap"]["ros__parameters"][
                "update_frequency"
            ]
        )
        smoother_frequency = float(
            nav2_config["velocity_smoother"]["ros__parameters"][
                "smoothing_frequency"
            ]
        )
        if lidar_update_rate < max(
            controller_frequency, local_costmap_frequency
        ):
            fail("Lidar rate must cover every Nav2 control and costmap cycle.")
        if planar_publish_rate < controller_frequency:
            fail("Odometry rate must cover every Nav2 controller cycle.")
        if planar_update_rate < smoother_frequency:
            fail("Planar update rate must cover every smoothed velocity command.")
        if camera_update_rate < 10.0:
            fail("Camera rate must preserve the 10 Hz Web sensor stream.")
        amcl = nav2_config["amcl"]["ros__parameters"]
        if amcl.get("robot_model_type") != "nav2_amcl::OmniMotionModel":
            fail("AMCL must use its omni motion model for the holonomic base.")
        dwb = nav2_config["controller_server"]["ros__parameters"]["FollowPath"]
        if (
            float(dwb.get("min_vel_x", 0.0)) >= 0.0
            or float(dwb.get("min_vel_y", 0.0)) >= 0.0
            or float(dwb.get("max_vel_y", 0.0)) <= 0.0
            or float(dwb.get("acc_lim_y", 0.0)) <= 0.0
            or float(dwb.get("decel_lim_y", 0.0)) >= 0.0
            or int(dwb.get("vy_samples", 0)) < 10
        ):
            fail(
                "Nav2 DWB must sample bidirectional X/Y motion for the "
                "holonomic inspection base."
            )
        smoother = nav2_config["velocity_smoother"]["ros__parameters"]
        max_velocity = smoother.get("max_velocity")
        min_velocity = smoother.get("min_velocity")
        # The holonomic base must keep symmetric bidirectional X/Y limits
        # (equal linear magnitudes) around the fixed yaw limit.  The linear
        # magnitude is tunable; only the X/Y symmetry and yaw bound are part
        # of the contract, so assert those instead of a frozen linear value.
        if (
            not isinstance(max_velocity, (list, tuple))
            or not isinstance(min_velocity, (list, tuple))
            or len(max_velocity) != 3
            or len(min_velocity) != 3
            or float(max_velocity[0]) != float(max_velocity[1])
            or float(min_velocity[0]) != float(min_velocity[1])
            or float(max_velocity[0]) <= 0.0
            or float(min_velocity[0]) >= 0.0
            or float(max_velocity[2]) != 0.60
            or float(min_velocity[2]) != -0.60
        ):
            fail("Nav2 velocity smoother must preserve holonomic X/Y motion.")

        web_node_source = WEB_ROS_NODE.read_text(encoding="utf-8")
        web_source = WEB_MONITOR.read_text(encoding="utf-8")
        for backend_contract in (
            "manual_joints: Sequence[ManualJointConfig]",
            "self._manual_joints = tuple(manual_joints)",
            "joint_names = [joint.name for joint in self._manual_joints]",
            "trajectory.joint_names = joint_names",
        ):
            if backend_contract not in web_node_source:
                fail(
                    "Web backend must build joint commands from the robot "
                    "adapter capability contract."
                )
        if "JOINT_NAMES" in web_node_source:
            fail("Web backend still hard-codes a robot joint order.")
        for monitor_contract in (
            "capabilities.manual_joints",
            "manualGroupOrder = manualJointSpecs",
            "jointNames = manualJointSpecs.map(joint => joint.name)",
            "function buildManualJointGroups",
        ):
            if monitor_contract not in web_source:
                fail(
                    "Web monitor must render joint controls from adapter "
                    "capabilities."
                )
        if "const armJointNames" in web_source:
            fail("Web monitor still hard-codes an arm joint order.")
        if (
            "joint.group === 'arm'" in web_source
            or "joint.group === 'gripper'" in web_source
        ):
            fail("Web monitor still hard-codes manual joint group names.")
        configured_joint_names = all_configured_joints
        if any(
            joint_name in web_node_source or joint_name in web_source
            for joint_name in configured_joint_names
        ):
            fail("Web manual control still embeds robot-specific joint names.")
        if "body_arm_lift" in web_node_source or "body_arm_lift" in web_source:
            fail("Web manual control still exposes the removed arm lift.")
        print(
            "Cabinet model valid: 33 controls, 20 prismatic buttons, "
            "11 knobs, 1 switch, 1 articulated rear door, unique state "
            "topics and per-instance plugin names, a dual-arm MoveIt robot "
            "with four unchanged fixed hardware tools, and the "
            "low-friction supported wheels, 500/20 Hz planar, "
            "640x640@15 Hz camera, 360@20 Hz lidar simulation performance "
            "contract."
        )
        return 0
    except Exception as error:  # noqa: BLE001
        print(f"Cabinet model validation failed: {error}", file=sys.stderr)
        traceback.print_exc()
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
