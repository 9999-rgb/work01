# Dual-arm joint topology: two 7-DOF arms plus four end-effector tool groups.
# Group names must match the adapter's
# ``manual_joint_group_names`` and the ros2_control / MoveIt controller keys.
LEFT_ARM_JOINTS = [f"l_arm_{index}_joint" for index in range(7)]
RIGHT_ARM_JOINTS = [f"r_arm_{index}_joint" for index in range(7)]
THREE_CYLINDER_JOINTS = [
    "r_three_cyl_finger1_joint",
    "r_three_cyl_finger2_joint",
    "r_three_cyl_finger3_joint",
]
TWO_CYLINDER_JOINTS = ["l_two_cyl_finger1_joint", "l_two_cyl_finger2_joint"]
ROCKER_JOINTS = ["l_rocker_rotor_joint"]
ROTATE_BUTTON_JOINTS = [
    "r_rotbtn_rotate_joint",
    "r_rotbtn_jaw1_joint",
    "r_rotbtn_jaw2_joint",
]
JOINT_GROUPS = {
    "left_arm": LEFT_ARM_JOINTS,
    "right_arm": RIGHT_ARM_JOINTS,
    "three_cylinder": THREE_CYLINDER_JOINTS,
    "two_cylinder": TWO_CYLINDER_JOINTS,
    "rocker": ROCKER_JOINTS,
    "rotate_button": ROTATE_BUTTON_JOINTS,
}

# End-effector toolset exclusivity.  Set A mounts the drawer tools
# (three-cylinder right + two-cylinder left); Set B mounts the button
# spinners (rotate-button right + rocker left).  Only one set is ever
# present in the URDF at a time, so every check that inspects tool
# geometry, controllers or SRDF must resolve the active set first.
TOOLSET = "A"
TOOLSET_ACTIVE_GROUPS = {
    "A": ("three_cylinder", "two_cylinder"),
    "B": ("rotate_button", "rocker"),
}
TOOLSET_INACTIVE_GROUPS = {
    "A": ("rotate_button", "rocker"),
    "B": ("three_cylinder", "two_cylinder"),
}
TOOLSET_TOOL_CONTACT_LINKS = {
    "A": frozenset({"r_three_cyl_base", "l_two_cyl_base"}),
    "B": frozenset({"r_rotbtn_body", "l_rocker_body"}),
}
