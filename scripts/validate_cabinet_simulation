#!/usr/bin/env python3
"""Run deterministic end-to-end checks for every simulated cabinet control."""

from __future__ import annotations

import argparse
import math
import sys
import time
from dataclasses import dataclass
from typing import Callable, Dict, Iterable, List, Optional

import rclpy
from rclpy.action import ActionClient
from rclpy.node import Node
from rclpy.qos import DurabilityPolicy
from rclpy.qos import QoSProfile
from rclpy.qos import ReliabilityPolicy
from action_msgs.msg import GoalStatus
from moveit_msgs.msg import PlanningSceneComponents
from moveit_msgs.srv import GetPlanningScene
from std_msgs.msg import String
from std_srvs.srv import Trigger
from xczs_inspection_robot_control.action import OperateCabinetControl
from xczs_inspection_robot_control.msg import CabinetControl
from xczs_inspection_robot_control.msg import CabinetControlCatalog
from xczs_inspection_robot_control.msg import CabinetControlState


EXPECTED_TYPE_COUNTS = {
    CabinetControl.TYPE_BUTTON: 20,
    CabinetControl.TYPE_KNOB: 11,
    CabinetControl.TYPE_SWITCH: 1,
    CabinetControl.TYPE_DOOR: 1,
}


@dataclass(frozen=True)
class Operation:
    control_id: str
    command: int
    target_state: str = ""
    target_position: Optional[float] = None


class CabinetValidator(Node):
    """Discover the catalog, execute actions and retain physical states."""

    def __init__(self) -> None:
        super().__init__("xczs_cabinet_simulation_validator")
        retained = QoSProfile(
            depth=1,
            reliability=ReliabilityPolicy.RELIABLE,
            durability=DurabilityPolicy.TRANSIENT_LOCAL,
        )
        self.catalog: Optional[CabinetControlCatalog] = None
        self.states: Dict[str, CabinetControlState] = {}
        self.state_received_at: Dict[str, float] = {}
        self.active_control: Optional[str] = None
        self.current_goal_handle: Optional[object] = None
        self._state_subscriptions = []
        self.create_subscription(
            CabinetControlCatalog,
            "/xczs/cabinet/control_catalog",
            self._catalog_callback,
            retained,
        )
        self.client = ActionClient(
            self,
            OperateCabinetControl,
            "/xczs/operate_cabinet_control",
        )
        self.reset_client = self.create_client(
            Trigger,
            "/xczs/cabinet/reset_controls",
        )
        self.planning_scene_client = self.create_client(
            GetPlanningScene,
            "/get_planning_scene",
        )
        self.create_subscription(
            String,
            "/xczs/cabinet/active_control",
            self._active_control_callback,
            retained,
        )
        self._retained_qos = retained

    def _catalog_callback(self, message: CabinetControlCatalog) -> None:
        if self.catalog is not None:
            return
        self.catalog = message
        for control in message.controls:
            subscription = self.create_subscription(
                CabinetControlState,
                control.state_topic,
                lambda state, selected_id=control.control_id: (
                    self._state_callback(selected_id, state)
                ),
                self._retained_qos,
            )
            self._state_subscriptions.append(subscription)

    def _state_callback(
        self,
        control_id: str,
        state: CabinetControlState,
    ) -> None:
        if state.control_id == control_id:
            self.states[control_id] = state
            self.state_received_at[control_id] = time.monotonic()

    def _active_control_callback(self, message: String) -> None:
        self.active_control = message.data

    def wait_for_catalog(self, timeout: float) -> CabinetControlCatalog:
        deadline = time.monotonic() + timeout
        while self.catalog is None and time.monotonic() < deadline:
            rclpy.spin_once(self, timeout_sec=0.1)
        if self.catalog is None:
            raise RuntimeError("Timed out waiting for the cabinet catalog.")
        return self.catalog

    def wait_for_all_states(self, timeout: float) -> None:
        assert self.catalog is not None
        expected = {entry.control_id for entry in self.catalog.controls}
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            if all(self._fresh_valid_state(control_id) for control_id in expected):
                return
            rclpy.spin_once(self, timeout_sec=0.1)
        invalid = sorted(
            control_id
            for control_id in expected
            if not self._fresh_valid_state(control_id)
        )
        raise RuntimeError(
            "No fresh valid physical state for: " + ", ".join(invalid)
        )

    def _fresh_valid_state(
        self,
        control_id: str,
        max_age: float = 1.0,
    ) -> bool:
        state = self.states.get(control_id)
        received_at = self.state_received_at.get(control_id)
        return bool(
            state is not None
            and state.valid
            and received_at is not None
            and time.monotonic() - received_at <= max_age
            and math.isfinite(float(state.position))
            and math.isfinite(float(state.velocity))
            and math.isfinite(float(state.effort))
        )

    def _spin_until(self, predicate: Callable[[], bool], timeout: float) -> bool:
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            if predicate():
                return True
            rclpy.spin_once(self, timeout_sec=0.05)
        return bool(predicate())

    def _spin_until_stable(
        self,
        predicate: Callable[[], bool],
        stable_duration: float,
        timeout: float,
    ) -> bool:
        deadline = time.monotonic() + timeout
        stable_since: Optional[float] = None
        while time.monotonic() < deadline:
            if predicate():
                now = time.monotonic()
                if stable_since is None:
                    stable_since = now
                elif now - stable_since >= stable_duration:
                    return True
            else:
                stable_since = None
            rclpy.spin_once(self, timeout_sec=0.05)
        return False

    def _expected_planning_scene_ids(
        self,
        active_control_id: Optional[str] = None,
    ) -> set[str]:
        assert self.catalog is not None
        expected = {
            f"cabinet_control_{control.control_id}"
            for control in self.catalog.controls
        }
        expected.add("control_cabinet_frame")
        door_handle_id = "cabinet_control_cabinet_rear_door_handle"
        expected.add(door_handle_id)
        if active_control_id == "cabinet_rear_door":
            # The active handle opens for grasping, but the articulated panel
            # must remain a collision object throughout the complete action.
            expected.discard(door_handle_id)
        elif active_control_id:
            expected.discard(f"cabinet_control_{active_control_id}")
        return expected

    def _planning_scene_ids(self, timeout: float) -> set[str]:
        if not self.planning_scene_client.wait_for_service(
            timeout_sec=min(timeout, 5.0)
        ):
            raise RuntimeError("MoveIt get_planning_scene service is unavailable.")
        request = GetPlanningScene.Request()
        request.components.components = (
            PlanningSceneComponents.WORLD_OBJECT_NAMES
        )
        future = self.planning_scene_client.call_async(request)
        rclpy.spin_until_future_complete(self, future, timeout_sec=timeout)
        if not future.done() or future.result() is None:
            raise RuntimeError("MoveIt planning-scene query timed out.")
        return {
            collision_object.id
            for collision_object in future.result().scene.world.collision_objects
        }

    def verify_planning_scene(
        self,
        active_control_id: Optional[str],
        timeout: float,
    ) -> None:
        expected = self._expected_planning_scene_ids(active_control_id)
        deadline = time.monotonic() + timeout
        actual: set[str] = set()
        while time.monotonic() < deadline:
            remaining = max(0.1, deadline - time.monotonic())
            actual = self._planning_scene_ids(min(remaining, 2.0))
            if actual == expected:
                return
            rclpy.spin_once(self, timeout_sec=0.05)
        missing = sorted(expected - actual)
        unexpected = sorted(actual - expected)
        raise RuntimeError(
            "MoveIt planning scene does not match the cabinet state; "
            f"missing={missing}, unexpected={unexpected}."
        )

    def _cancel_and_wait(
        self,
        goal_handle: object,
        result_future: object,
        timeout: float,
    ) -> object:
        cancel_future = goal_handle.cancel_goal_async()
        rclpy.spin_until_future_complete(
            self,
            cancel_future,
            timeout_sec=min(timeout, 10.0),
        )
        if not cancel_future.done() or cancel_future.result() is None:
            raise RuntimeError("Action cancellation was not acknowledged.")
        rclpy.spin_until_future_complete(
            self,
            result_future,
            timeout_sec=timeout,
        )
        if not result_future.done() or result_future.result() is None:
            raise RuntimeError("Canceled action did not reach a terminal state.")
        wrapped = result_future.result()
        self.current_goal_handle = None
        if not self._spin_until(
            lambda: self.active_control == "",
            min(timeout, 30.0),
        ):
            raise RuntimeError(
                "Canceled action did not clear the active-control target."
            )
        return wrapped

    def _cancel_after_validation_failure(
        self,
        goal_handle: object,
        result_future: object,
        timeout: float,
        validation_error: Exception,
    ) -> None:
        try:
            self._cancel_and_wait(goal_handle, result_future, timeout)
        except Exception as cleanup_error:  # noqa: BLE001
            raise RuntimeError(
                f"{validation_error} Additionally, accepted-goal cleanup "
                f"failed: {cleanup_error}"
            ) from cleanup_error

    def reset(self, timeout: float, expect_success: bool = True) -> str:
        if not self.reset_client.wait_for_service(
            timeout_sec=min(timeout, 10.0)
        ):
            raise RuntimeError("Cabinet reset service is unavailable.")
        future = self.reset_client.call_async(Trigger.Request())
        rclpy.spin_until_future_complete(self, future, timeout_sec=timeout)
        if not future.done():
            raise RuntimeError("Cabinet reset service timed out.")
        response = future.result()
        if response is None:
            raise RuntimeError("Cabinet reset returned no response.")
        if bool(response.success) != expect_success:
            expectation = "success" if expect_success else "rejection"
            raise RuntimeError(
                f"Expected reset {expectation}, got: {response.message}"
            )
        return str(response.message)

    @staticmethod
    def _default_state(control: CabinetControl) -> tuple[str, float]:
        state_ids = list(control.state_ids)
        positions = list(control.state_positions)
        desired = {
            CabinetControl.TYPE_BUTTON: "released",
            CabinetControl.TYPE_KNOB: "center",
            CabinetControl.TYPE_SWITCH: "off",
            CabinetControl.TYPE_DOOR: "closed",
        }[control.control_type]
        if desired not in state_ids:
            raise RuntimeError(
                f"{control.control_id} does not advertise default '{desired}'."
            )
        index = state_ids.index(desired)
        return desired, float(positions[index])

    def verify_defaults(self, timeout: float) -> None:
        assert self.catalog is not None
        expected = {
            control.control_id: self._default_state(control)
            for control in self.catalog.controls
        }

        def all_default() -> bool:
            for control_id, (state_id, position) in expected.items():
                state = self.states.get(control_id)
                if (
                    state is None
                    or not self._fresh_valid_state(control_id)
                    or state.state_id != state_id
                    or state.in_motion
                    or abs(float(state.position) - position) > 0.035
                ):
                    return False
            return True

        if not self._spin_until_stable(all_default, 0.30, timeout):
            failures = []
            for control_id, (state_id, position) in expected.items():
                state = self.states.get(control_id)
                actual = "missing" if state is None else (
                    f"{state.state_id}@{float(state.position):.4f}, "
                    f"valid={state.valid}, moving={state.in_motion}"
                )
                if (
                    state is None
                    or not self._fresh_valid_state(control_id)
                    or state.state_id != state_id
                    or state.in_motion
                    or abs(float(state.position) - position) > 0.035
                ):
                    failures.append(
                        f"{control_id}={actual}, expected {state_id}@{position:.4f}"
                    )
            raise RuntimeError(
                "Controls did not reach reset defaults: " + "; ".join(failures)
            )

    def snapshot_non_target_controls(
        self,
        target_control_id: str,
    ) -> Dict[str, tuple[str, float, int]]:
        """Capture stable detents so one operation cannot disturb its peers."""
        assert self.catalog is not None
        snapshot: Dict[str, tuple[str, float, int]] = {}
        failures = []
        for control in self.catalog.controls:
            if control.control_id == target_control_id:
                continue
            state = self.states.get(control.control_id)
            state_ids = list(control.state_ids)
            if state is None or state.state_id not in state_ids:
                failures.append(f"{control.control_id}=missing/unknown")
                continue
            position = float(control.state_positions[state_ids.index(state.state_id)])
            if (
                not self._fresh_valid_state(control.control_id)
                or state.in_motion
                or abs(float(state.position) - position) > 0.035
            ):
                failures.append(
                    f"{control.control_id}={state.state_id}@"
                    f"{float(state.position):.4f}, moving={state.in_motion}"
                )
                continue
            snapshot[control.control_id] = (
                str(state.state_id),
                position,
                int(state.transition_sequence),
            )
        if failures:
            raise RuntimeError(
                "Non-target controls were not stable before operation: "
                + "; ".join(failures)
            )
        return snapshot

    def verify_non_target_controls_unchanged(
        self,
        snapshot: Dict[str, tuple[str, float, int]],
        timeout: float,
    ) -> None:
        def unchanged() -> bool:
            for control_id, (state_id, position, sequence) in snapshot.items():
                state = self.states.get(control_id)
                if (
                    state is None
                    or not self._fresh_valid_state(control_id)
                    or state.state_id != state_id
                    or state.in_motion
                    or abs(float(state.position) - position) > 0.035
                    or int(state.transition_sequence) != sequence
                ):
                    return False
            return True

        if self._spin_until_stable(unchanged, 0.30, timeout):
            return
        failures = []
        for control_id, (state_id, position, sequence) in snapshot.items():
            state = self.states.get(control_id)
            actual = "missing" if state is None else (
                f"{state.state_id}@{float(state.position):.4f}, "
                f"moving={state.in_motion}, "
                f"sequence={int(state.transition_sequence)}"
            )
            if (
                state is None
                or not self._fresh_valid_state(control_id)
                or state.state_id != state_id
                or state.in_motion
                or abs(float(state.position) - position) > 0.035
                or int(state.transition_sequence) != sequence
            ):
                failures.append(
                    f"{control_id}={actual}, expected "
                    f"{state_id}@{position:.4f}, sequence={sequence}"
                )
        raise RuntimeError(
            "Cabinet operation disturbed non-target controls: "
            + "; ".join(failures)
        )

    @staticmethod
    def _expected_target(
        control: CabinetControl,
        operation: Operation,
        initial_state: CabinetControlState,
    ) -> tuple[str, float]:
        state_ids = list(control.state_ids)
        positions = [float(value) for value in control.state_positions]
        if control.control_type == CabinetControl.TYPE_BUTTON:
            return "released", positions[0]
        if operation.command == OperateCabinetControl.Goal.COMMAND_SET_STATE:
            index = state_ids.index(operation.target_state)
            return operation.target_state, positions[index]
        if operation.command == OperateCabinetControl.Goal.COMMAND_SET_POSITION:
            assert operation.target_position is not None
            index = min(
                range(len(positions)),
                key=lambda candidate: abs(
                    positions[candidate] - operation.target_position
                ),
            )
            return state_ids[index], positions[index]
        if operation.command == OperateCabinetControl.Goal.COMMAND_TOGGLE:
            if initial_state.state_id in state_ids:
                index = state_ids.index(initial_state.state_id)
            else:
                index = min(
                    range(len(positions)),
                    key=lambda candidate: abs(
                        positions[candidate] - float(initial_state.position)
                    ),
                )
            target_index = (index + 1) % len(state_ids)
            return state_ids[target_index], positions[target_index]
        raise RuntimeError("Cannot resolve the expected operation target.")

    def execute(
        self,
        operation: Operation,
        navigate: bool,
        timeout: float,
    ) -> str:
        if self.current_goal_handle is not None:
            raise RuntimeError(
                "A previous accepted goal has not reached a terminal state."
            )
        if not self.client.wait_for_server(timeout_sec=min(timeout, 15.0)):
            raise RuntimeError("Cabinet action server is unavailable.")

        assert self.catalog is not None
        controls = {
            entry.control_id: entry for entry in self.catalog.controls
        }
        control = controls[operation.control_id]
        initial_state = self.states.get(operation.control_id)
        if initial_state is None or not self._fresh_valid_state(
            operation.control_id
        ):
            raise RuntimeError(
                "No fresh valid physical state before cabinet operation."
            )
        initial_sequence = int(initial_state.transition_sequence)
        non_target_snapshot = self.snapshot_non_target_controls(
            operation.control_id
        )
        expected_state, expected_position = self._expected_target(
            control,
            operation,
            initial_state,
        )

        goal = OperateCabinetControl.Goal()
        goal.control_id = operation.control_id
        goal.command = operation.command
        goal.target_state = operation.target_state
        goal.use_target_position = operation.target_position is not None
        goal.target_position = operation.target_position or 0.0
        goal.navigate_to_staging_pose = navigate

        last_feedback = {"at": 0.0}

        def feedback_callback(message: object) -> None:
            feedback = message.feedback
            now = time.monotonic()
            if now - last_feedback["at"] < 0.5:
                return
            last_feedback["at"] = now
            print(
                f"  phase={int(feedback.phase)} "
                f"progress={float(feedback.progress):.0%} "
                f"state={feedback.current_state or '-'} "
                f"position={float(feedback.current_position):.4f} "
                f"message={feedback.message}"
            )

        send_future = self.client.send_goal_async(
            goal,
            feedback_callback=feedback_callback,
        )
        rclpy.spin_until_future_complete(self, send_future, timeout_sec=timeout)
        if not send_future.done():
            raise RuntimeError("Timed out while sending the action goal.")
        goal_handle = send_future.result()
        if goal_handle is None or not goal_handle.accepted:
            raise RuntimeError("Cabinet operator rejected the action goal.")
        self.current_goal_handle = goal_handle

        result_future = goal_handle.get_result_async()
        try:
            if not self._spin_until(
                lambda: self.active_control == operation.control_id,
                min(timeout, 5.0),
            ):
                raise RuntimeError(
                    "Active-control topic did not expose the accepted action."
                )
            self.verify_planning_scene(
                operation.control_id,
                min(timeout, 5.0),
            )
            rclpy.spin_until_future_complete(
                self,
                result_future,
                timeout_sec=timeout,
            )
        except Exception as validation_error:  # noqa: BLE001
            self._cancel_after_validation_failure(
                goal_handle,
                result_future,
                timeout,
                validation_error,
            )
            raise
        if not result_future.done():
            wrapped = self._cancel_and_wait(
                goal_handle,
                result_future,
                timeout,
            )
            raise RuntimeError(
                "Cabinet operation timed out; cancellation reached terminal "
                f"status {int(wrapped.status)}."
            )
        wrapped = result_future.result()
        self.current_goal_handle = None
        if wrapped is None or wrapped.status != GoalStatus.STATUS_SUCCEEDED:
            status = "missing" if wrapped is None else int(wrapped.status)
            details = ""
            if wrapped is not None and wrapped.result is not None:
                details = (
                    f", error={int(wrapped.result.error_code)}: "
                    f"{wrapped.result.message}"
                )
            raise RuntimeError(
                "Action did not finish with SUCCEEDED status: "
                f"{status}{details}."
            )
        result = wrapped.result
        if not result.success or result.error_code != result.SUCCESS:
            raise RuntimeError(
                f"error={int(result.error_code)}: {result.message}"
            )
        if result.final_state != expected_state:
            raise RuntimeError(
                f"Action result final_state={result.final_state!r}, "
                f"expected {expected_state!r}."
            )
        final_position = float(result.final_position)
        peak_position = float(result.peak_position)
        if not math.isfinite(final_position) or not math.isfinite(peak_position):
            raise RuntimeError("Action result contains a non-finite position.")
        if abs(final_position - expected_position) > 0.035:
            raise RuntimeError(
                f"Action result position={final_position:.4f}, "
                f"expected {expected_position:.4f}."
            )
        if control.control_type == CabinetControl.TYPE_BUTTON and (
            peak_position < float(control.state_positions[-1])
        ):
            raise RuntimeError(
                "Button action reported success without reaching its physical "
                "press threshold."
            )

        def physical_target_reached() -> bool:
            state = self.states.get(operation.control_id)
            if state is None:
                return False
            sequence_valid = True
            if control.control_type == CabinetControl.TYPE_BUTTON:
                sequence_valid = (
                    int(state.transition_sequence) >= initial_sequence + 2
                )
            return (
                self._fresh_valid_state(operation.control_id)
                and state.state_id == expected_state
                and not state.in_motion
                and abs(float(state.position) - expected_position) <= 0.035
                and sequence_valid
            )

        if not self._spin_until_stable(
            physical_target_reached,
            0.30,
            min(timeout, 5.0),
        ):
            state = self.states.get(operation.control_id)
            actual = "missing" if state is None else (
                f"{state.state_id}@{float(state.position):.4f}, "
                f"sequence={int(state.transition_sequence)}"
            )
            raise RuntimeError(
                "Independent physical state did not confirm the action: " +
                actual
            )
        if not self._spin_until(
            lambda: self.active_control == "",
            min(timeout, 5.0),
        ):
            raise RuntimeError(
                "Action completed but the active-control target was not "
                "cleared."
            )
        self.verify_planning_scene(None, min(timeout, 5.0))
        self.verify_non_target_controls_unchanged(
            non_target_snapshot,
            min(timeout, 10.0),
        )
        return str(result.message)

    def verify_invalid_position_rejected(
        self,
        control: CabinetControl,
        timeout: float,
    ) -> None:
        positions = sorted(float(value) for value in control.state_positions)
        if len(positions) < 2:
            raise RuntimeError("Need two detents for rejection validation.")
        target = (positions[0] + positions[1]) / 2.0
        if min(abs(target - value) for value in positions) <= 0.035:
            target = positions[0] + 0.1 * (positions[1] - positions[0])
        goal = OperateCabinetControl.Goal()
        goal.control_id = control.control_id
        goal.command = OperateCabinetControl.Goal.COMMAND_SET_POSITION
        goal.target_position = target
        goal.use_target_position = True
        goal.navigate_to_staging_pose = False
        send_future = self.client.send_goal_async(goal)
        rclpy.spin_until_future_complete(self, send_future, timeout_sec=timeout)
        if not send_future.done():
            raise RuntimeError("Invalid-position rejection timed out.")
        goal_handle = send_future.result()
        if goal_handle is not None and goal_handle.accepted:
            self.current_goal_handle = goal_handle
            result_future = goal_handle.get_result_async()
            self._cancel_and_wait(goal_handle, result_future, timeout)
            raise RuntimeError(
                "Action server accepted a non-detent SET_POSITION goal."
            )

    def verify_cancel_and_reset_interlock(
        self,
        control: CabinetControl,
        navigate: bool,
        timeout: float,
    ) -> None:
        state = self.states[control.control_id]
        state_ids = list(control.state_ids)
        current_index = (
            state_ids.index(state.state_id)
            if state.state_id in state_ids
            else 0
        )
        target_index = (current_index + 1) % len(state_ids)
        goal = OperateCabinetControl.Goal()
        goal.control_id = control.control_id
        goal.command = OperateCabinetControl.Goal.COMMAND_SET_STATE
        goal.target_state = state_ids[target_index]
        goal.navigate_to_staging_pose = navigate
        phase = {"value": -1}

        def feedback_callback(message: object) -> None:
            phase["value"] = int(message.feedback.phase)

        send_future = self.client.send_goal_async(
            goal,
            feedback_callback=feedback_callback,
        )
        rclpy.spin_until_future_complete(self, send_future, timeout_sec=timeout)
        if not send_future.done():
            raise RuntimeError("Cancellation test goal submission timed out.")
        goal_handle = send_future.result()
        if goal_handle is None or not goal_handle.accepted:
            raise RuntimeError("Cancellation test goal was rejected.")
        self.current_goal_handle = goal_handle
        result_future = goal_handle.get_result_async()

        try:
            if not self._spin_until(
                lambda: self.active_control == control.control_id,
                min(timeout, 3.0),
            ):
                raise RuntimeError(
                    "Active-control topic did not expose the goal."
                )
            self.verify_planning_scene(
                control.control_id,
                min(timeout, 5.0),
            )
            rejection = self.reset(timeout, expect_success=False)
            if "active" not in rejection.lower():
                raise RuntimeError(
                    "Reset rejection did not report the active-operation "
                    "interlock."
                )

            reached_manipulation = self._spin_until(
                lambda: (
                    phase["value"]
                    == OperateCabinetControl.Feedback.MANIPULATING
                    or result_future.done()
                ),
                timeout,
            )
            if (
                not reached_manipulation
                or result_future.done()
                or phase["value"]
                != OperateCabinetControl.Feedback.MANIPULATING
            ):
                raise RuntimeError(
                    "Cancellation test did not reach the grasped "
                    "manipulation phase."
                )
        except Exception as validation_error:  # noqa: BLE001
            self._cancel_after_validation_failure(
                goal_handle,
                result_future,
                timeout,
                validation_error,
            )
            raise

        wrapped = self._cancel_and_wait(
            goal_handle,
            result_future,
            timeout,
        )
        if (
            wrapped.status != GoalStatus.STATUS_CANCELED
            or wrapped.result.error_code != wrapped.result.CANCELED
            or wrapped.result.success
        ):
            raise RuntimeError(
                "Canceled operation returned inconsistent action status/result."
            )
        self.verify_planning_scene(None, min(timeout, 5.0))

    def verify_parented_switch(
        self,
        door: CabinetControl,
        switch: CabinetControl,
        navigate: bool,
        timeout: float,
    ) -> None:
        sequence = [
            Operation(
                door.control_id,
                OperateCabinetControl.Goal.COMMAND_SET_STATE,
                target_state="open",
            ),
            Operation(
                switch.control_id,
                OperateCabinetControl.Goal.COMMAND_SET_STATE,
                target_state="on",
            ),
            Operation(
                switch.control_id,
                OperateCabinetControl.Goal.COMMAND_SET_STATE,
                target_state="off",
            ),
            Operation(
                door.control_id,
                OperateCabinetControl.Goal.COMMAND_SET_STATE,
                target_state="closed",
            ),
        ]
        for operation in sequence:
            print(
                "  parent-chain: "
                f"{operation.control_id} -> {operation.target_state}"
            )
            print(
                "    PASS: "
                + self.execute(operation, navigate, timeout)
            )

    def best_effort_cleanup(
        self,
        timeout: float = 10.0,
        reset_controls: bool = True,
    ) -> None:
        goal_handle = self.current_goal_handle
        if goal_handle is not None:
            try:
                cancel_future = goal_handle.cancel_goal_async()
                rclpy.spin_until_future_complete(
                    self,
                    cancel_future,
                    timeout_sec=timeout,
                )
                result_future = goal_handle.get_result_async()
                rclpy.spin_until_future_complete(
                    self,
                    result_future,
                    timeout_sec=timeout,
                )
            except Exception as error:  # noqa: BLE001
                print(
                    f"Cleanup warning: could not cancel active goal: {error}",
                    file=sys.stderr,
                )
            self.current_goal_handle = None
        try:
            if self.active_control:
                self._spin_until(
                    lambda: self.active_control == "",
                    timeout,
                )
            if reset_controls and self.reset_client.service_is_ready():
                self.reset(timeout)
        except Exception as error:  # noqa: BLE001
            print(
                f"Cleanup warning: cabinet reset failed: {error}",
                file=sys.stderr,
            )


def validate_catalog(catalog: CabinetControlCatalog) -> None:
    controls = list(catalog.controls)
    ids = [entry.control_id for entry in controls]
    if len(ids) != 33 or len(set(ids)) != 33:
        raise RuntimeError(
            f"Expected 33 unique controls, received {len(ids)} entries."
        )
    for control_type, expected_count in EXPECTED_TYPE_COUNTS.items():
        actual = sum(
            entry.control_type == control_type for entry in controls
        )
        if actual != expected_count:
            raise RuntimeError(
                f"Control type {control_type}: expected {expected_count}, "
                f"received {actual}."
            )
    for entry in controls:
        if not entry.operable:
            raise RuntimeError(
                f"{entry.control_id} is not operable: "
                f"{entry.unavailable_reason}"
            )
        if not entry.joint_name or not entry.state_topic:
            raise RuntimeError(
                f"{entry.control_id} has incomplete physical metadata."
            )
        if entry.control_type != CabinetControl.TYPE_BUTTON:
            if not entry.state_ids:
                raise RuntimeError(
                    f"{entry.control_id} has no discrete state catalog."
                )
            if len(entry.state_ids) != len(entry.state_positions):
                raise RuntimeError(
                    f"{entry.control_id} state IDs and positions differ."
                )


def selected_controls(
    catalog: CabinetControlCatalog,
    requested_ids: Iterable[str],
) -> List[CabinetControl]:
    by_id = {entry.control_id: entry for entry in catalog.controls}
    requested = list(requested_ids)
    if not requested:
        return list(catalog.controls)
    missing = [control_id for control_id in requested if control_id not in by_id]
    if missing:
        raise RuntimeError("Unknown controls: " + ", ".join(missing))
    return [by_id[control_id] for control_id in requested]


def operations_for(control: CabinetControl, exhaustive: bool) -> List[Operation]:
    if control.control_type == CabinetControl.TYPE_BUTTON:
        return [
            Operation(
                control.control_id,
                OperateCabinetControl.Goal.COMMAND_PRESS,
            )
        ]

    states = list(control.state_ids)
    if control.control_type == CabinetControl.TYPE_KNOB:
        desired = ["right", "left", "center"] if exhaustive else ["right"]
    elif control.control_type == CabinetControl.TYPE_SWITCH:
        desired = ["on", "off"] if exhaustive else ["on"]
    elif control.control_type == CabinetControl.TYPE_DOOR:
        desired = ["open", "closed"] if exhaustive else ["open"]
    else:
        raise RuntimeError(f"Unsupported type for {control.control_id}.")
    for state in desired:
        if state not in states:
            raise RuntimeError(
                f"{control.control_id} does not advertise state '{state}'."
            )
    return [
        Operation(
            control.control_id,
            OperateCabinetControl.Goal.COMMAND_SET_STATE,
            state,
        )
        for state in desired
    ]


def parse_arguments() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--navigate",
        action="store_true",
        help="Run Nav2 staging before every operation.",
    )
    parser.add_argument(
        "--exhaustive",
        action="store_true",
        help="Exercise all knob/switch/door states, returning to defaults.",
    )
    parser.add_argument(
        "--inventory-only",
        action="store_true",
        help="Validate catalog and physical state topics without moving.",
    )
    parser.add_argument(
        "--contract-tests",
        action="store_true",
        help=(
            "Also verify valid/invalid SET_POSITION, TOGGLE, cancellation, "
            "active-target cleanup, reset and the reset/operation interlock."
        ),
    )
    parser.add_argument(
        "--control",
        action="append",
        default=[],
        help="Limit execution to one control ID; repeat for multiple IDs.",
    )
    parser.add_argument("--cycles", type=int, default=1)
    parser.add_argument("--timeout", type=float, default=180.0)
    args = parser.parse_args()
    if args.cycles < 1:
        parser.error("--cycles must be at least 1")
    if args.timeout <= 0.0:
        parser.error("--timeout must be positive")
    return args


def main() -> int:
    args = parse_arguments()
    rclpy.init()
    node = CabinetValidator()
    failures: List[str] = []
    completed = 0
    try:
        catalog = node.wait_for_catalog(args.timeout)
        validate_catalog(catalog)
        node.wait_for_all_states(min(args.timeout, 30.0))
        controls = selected_controls(catalog, args.control)
        print(
            f"Cabinet inventory valid: {len(catalog.controls)} controls; "
            f"{len(node.states)} live physical states."
        )
        node.verify_planning_scene(None, min(args.timeout, 10.0))
        print("MoveIt planning scene valid: 34 cabinet collision objects.")
        if args.inventory_only:
            return 0

        print("Resetting all controls to deterministic defaults...")
        print(f"  PASS: {node.reset(args.timeout)}")
        node.verify_defaults(min(args.timeout, 10.0))

        if args.contract_tests:
            knobs = [
                entry
                for entry in catalog.controls
                if entry.control_type == CabinetControl.TYPE_KNOB
            ]
            doors = [
                entry
                for entry in catalog.controls
                if entry.control_type == CabinetControl.TYPE_DOOR
            ]
            switches = [
                entry
                for entry in catalog.controls
                if entry.control_type == CabinetControl.TYPE_SWITCH
            ]
            if not knobs or not doors or not switches:
                raise RuntimeError(
                    "Contract tests require a knob, switch and door."
                )
            knob = knobs[0]
            print(f"[contract] reject non-detent position: {knob.control_id}")
            node.verify_invalid_position_rejected(knob, args.timeout)
            print("  PASS: invalid SET_POSITION rejected")
            position = float(knob.state_positions[-1])
            print(f"[contract] SET_POSITION: {knob.control_id} -> {position:.4f}")
            print(
                "  PASS: " + node.execute(
                    Operation(
                        knob.control_id,
                        OperateCabinetControl.Goal.COMMAND_SET_POSITION,
                        target_position=position,
                    ),
                    args.navigate,
                    args.timeout,
                )
            )
            print(f"[contract] TOGGLE: {knob.control_id}")
            print(
                "  PASS: " + node.execute(
                    Operation(
                        knob.control_id,
                        OperateCabinetControl.Goal.COMMAND_TOGGLE,
                    ),
                    args.navigate,
                    args.timeout,
                )
            )
            print("[contract] cancellation and reset interlock")
            node.verify_cancel_and_reset_interlock(
                doors[0],
                args.navigate,
                args.timeout,
            )
            print("  PASS: cancel/interlock/active-target cleanup")
            print(f"  PASS: {node.reset(args.timeout)}")
            node.verify_defaults(min(args.timeout, 10.0))
            print("[contract] articulated door -> parented switch chain")
            node.verify_parented_switch(
                doors[0],
                switches[0],
                args.navigate,
                args.timeout,
            )
            print("  PASS: articulated parent geometry and operation chain")
            print(f"  PASS: {node.reset(args.timeout)}")
            node.verify_defaults(min(args.timeout, 10.0))

        for cycle in range(1, args.cycles + 1):
            if cycle > 1:
                print(
                    f"Resetting controls before validation cycle {cycle}..."
                )
                print(f"  PASS: {node.reset(args.timeout)}")
                node.verify_defaults(min(args.timeout, 10.0))
            for control in controls:
                for operation in operations_for(control, args.exhaustive):
                    label = operation.target_state or "press"
                    print(
                        f"[{cycle}/{args.cycles}] "
                        f"{operation.control_id} -> {label}"
                    )
                    try:
                        message = node.execute(
                            operation,
                            args.navigate,
                            args.timeout,
                        )
                        completed += 1
                        print(f"  PASS: {message}")
                    except Exception as error:  # noqa: BLE001
                        failure = (
                            f"{operation.control_id}->{label}: {error}"
                        )
                        failures.append(failure)
                        print(f"  FAIL: {failure}", file=sys.stderr)
        print("Returning all controls to deterministic defaults...")
        print(f"  PASS: {node.reset(args.timeout)}")
        node.verify_defaults(min(args.timeout, 10.0))
        print(f"Completed {completed} operations; failures={len(failures)}.")
        if failures:
            for failure in failures:
                print(f"- {failure}", file=sys.stderr)
            return 1
        return 0
    except Exception as error:  # noqa: BLE001
        print(f"Cabinet validation failed: {error}", file=sys.stderr)
        return 2
    except KeyboardInterrupt:
        print("Cabinet validation interrupted by the user.", file=sys.stderr)
        return 130
    finally:
        if rclpy.ok():
            node.best_effort_cleanup(reset_controls=not args.inventory_only)
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == "__main__":
    raise SystemExit(main())
