<?xml version="1.0"?>
<package format="3">
  <name>xczs_inspection_robot_gazebo</name>
  <version>1.0.0</version>
  <description>
    Gazebo simulation plugins and worlds for the XCZS inspection robot.
  </description>

  <maintainer email="live@example.com">live</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>gazebo_dev</depend>
  <depend>gazebo_ros</depend>
  <depend>geometry_msgs</depend>
  <depend>rcl</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>trajectory_msgs</depend>
  <depend>xczs_inspection_robot_control</depend>
  <depend>xczs_inspection_robot_interfaces</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
