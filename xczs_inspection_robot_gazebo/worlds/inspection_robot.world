<?xml version="1.0"?>
<sdf version="1.7">
  <world name="inspection_robot_world">
    <gravity>0 0 -9.81</gravity>

    <physics name="stable_ode" default="true" type="ode">
      <!--
        500 Hz preserves five physics samples per 100 Hz ros2_control update
        while avoiding the previous 1000 Hz CPU bottleneck. Cabinet contact
        and release behavior remains guarded by physical action validation.
      -->
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>80</iters>
          <sor>1.3</sor>
          <use_dynamic_moi_rescaling>true</use_dynamic_moi_rescaling>
          <friction_model>pyramid_model</friction_model>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>0.2</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- Scene switching teleports the robot through the /set_entity_state
         service provided by the gazebo_ros_state plugin (also /get_entity_state,
         /set_model_state, /set_link_state).  Load it alongside the init/factory/
         force_system plugins injected by gzserver.launch.py. -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
    </plugin>

    <!-- gazebo_ros2_control rewrites the gzserver process-global rcl
         arguments on every robot spawn, injecting a default namespace remap
         to /xczs that truncates the sensor namespaces of every later spawn.
         This guard exposes /xczs/global_args_guard/reset so the toolset
         supervisor can restore a clean default namespace immediately before
         each new robot spawn. -->
    <plugin name="xczs_ros_global_args_guard"
            filename="libxczs_ros_global_args_guard.so">
    </plugin>

    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>
  </world>
</sdf>
