<?xml version="1.0" ?>
<!-- P2 drawer physics acceptance harness.  The drawer cabinet carries one
     bimanual drawer control (test_drawer); the four robot models are fixed
     multi-link probes positioned at the world coordinates each test phase
     needs (link origin == tool tip, local grasp point (0,0,0)). -->
<sdf version="1.6">
  <world name="drawer_p2_world">
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>
<!-- robot_far: everything far away. -->
    <model name="robot_far">
      <gravity>false</gravity>
      <pose>5.0 5.0 0.6 0 0 0</pose>
      <link name="base_link">
        <gravity>false</gravity>
        <inertial><mass>5.0</mass>
          <inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
      </link>
      <link name="left_tool">
        <gravity>false</gravity>
        <pose>0.0 0.0 0.22 0 0 0</pose>
        <inertial><mass>0.5</mass>
          <inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
      </link>
      <link name="right_tool">
        <gravity>false</gravity>
        <pose>0.0 0.4 0.22 0 0 0</pose>
        <inertial><mass>0.5</mass>
          <inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
      </link>
      <joint name="left_fixed" type="fixed"><parent>base_link</parent><child>left_tool</child></joint>
      <joint name="right_fixed" type="fixed"><parent>base_link</parent><child>right_tool</child></joint>
    </model>

    <!-- robot_unlock: right_tool tip at the unlock zone, left tool far. -->
    <model name="robot_unlock">
      <gravity>false</gravity>
      <pose>0.12 0.50 0.60 0 0 0</pose>
      <link name="base_link">
        <gravity>false</gravity>
        <inertial><mass>5.0</mass>
          <inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
      </link>
      <link name="left_tool">
        <gravity>false</gravity>
        <pose>-5.0 0.0 0.22 0 0 0</pose>
        <inertial><mass>0.5</mass>
          <inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
      </link>
      <link name="right_tool">
        <gravity>false</gravity>
        <pose>0.0 0.0 0.22 0 0 0</pose>
        <inertial><mass>0.5</mass>
          <inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
      </link>
      <joint name="left_fixed" type="fixed"><parent>base_link</parent><child>left_tool</child></joint>
      <joint name="right_fixed" type="fixed"><parent>base_link</parent><child>right_tool</child></joint>
    </model>

    <!-- robot_left_only: only the left tool at the left handle. -->
    <model name="robot_left_only">
      <gravity>false</gravity>
      <pose>0.069 0.10 0.60 0 0 0</pose>
      <link name="base_link">
        <gravity>false</gravity>
        <inertial><mass>5.0</mass>
          <inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
      </link>
      <link name="left_tool">
        <gravity>false</gravity>
        <pose>0.0 0.0 0.22 0 0 0</pose>
        <inertial><mass>0.5</mass>
          <inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
      </link>
      <link name="right_tool">
        <gravity>false</gravity>
        <pose>5.0 4.0 0.22 0 0 0</pose>
        <inertial><mass>0.5</mass>
          <inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
      </link>
      <joint name="left_fixed" type="fixed"><parent>base_link</parent><child>left_tool</child></joint>
      <joint name="right_fixed" type="fixed"><parent>base_link</parent><child>right_tool</child></joint>
    </model>

    <!-- robot_both: both tool tips at the closed handle points.
         World: left (0.069,0.10,0.62), right (0.069,0.50,0.62). -->
    <model name="robot_both">
      <gravity>false</gravity>
      <pose>0.069 0.30 0.60 0 0 0</pose>
      <link name="base_link">
        <gravity>false</gravity>
        <inertial><mass>5.0</mass>
          <inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
      </link>
      <link name="left_tool">
        <gravity>false</gravity>
        <pose>0.0 -0.20 0.22 0 0 0</pose>
        <inertial><mass>0.5</mass>
          <inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
      </link>
      <link name="right_tool">
        <gravity>false</gravity>
        <pose>0.0 0.20 0.22 0 0 0</pose>
        <inertial><mass>0.5</mass>
          <inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
      </link>
      <joint name="left_fixed" type="fixed"><parent>base_link</parent><child>left_tool</child></joint>
      <joint name="right_fixed" type="fixed"><parent>base_link</parent><child>right_tool</child></joint>
    </model>
  </world>
</sdf>
