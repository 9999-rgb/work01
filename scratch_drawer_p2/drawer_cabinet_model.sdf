<?xml version="1.0" ?>
<!-- P2 drawer cabinet model, spawned via gz factory after world load (the
     real stack spawns cabinets dynamically; inline-world plugins Load before
     ODE joints exist and would read uninitialized joints).

     Drawer frame origin sits at world (0, 0, 0.5), so the control points are
     expressed in the drawer link frame and map to world z = 0.62:
       left_handle  (0.069, 0.10, 0.12) -> world (0.069, 0.10, 0.62)
       right_handle (0.069, 0.50, 0.12) -> world (0.069, 0.50, 0.62)
       unlock press (0.12,  0.50, 0.12) -> world (0.12,  0.50, 0.62)

     The unlock button cap is a real prismatic link: the physical-press
     contract requires the right tool tip to displace unlock_button_slide
     >= press_threshold, not merely to hover near the press point.  The P2
     world's static robot_unlock probe overlaps the cap and pushes it to its
     limit (0.005 m); the plugin's own spring (spring_stiffness 800 N/m,
     target 0) returns it on release. -->
<sdf version="1.6">
  <model name="drawer_test_cabinet">
    <static>false</static>
    <link name="base">
      <collision name="base_col">
        <geometry><box><size>1.0 0.9 0.4</size></box></geometry>
      </collision>
      <visual name="base_vis">
        <geometry><box><size>1.0 0.9 0.4</size></box></geometry>
      </visual>
      <inertial>
        <mass>100.0</mass>
        <inertia>
          <ixx>10.0</ixx><iyy>10.0</iyy><izz>10.0</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
    </link>
    <link name="drawer">
      <pose>0.0 0.0 0.5 0 0 0</pose>
      <collision name="drawer_col">
        <geometry><box><size>0.7 0.65 0.24</size></box></geometry>
      </collision>
      <visual name="drawer_vis">
        <geometry><box><size>0.7 0.65 0.24</size></box></geometry>
      </visual>
      <inertial>
        <mass>8.0</mass>
        <inertia>
          <ixx>0.5</ixx><iyy>0.3</iyy><izz>0.5</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
    </link>
    <!-- Momentary unlock button cap, mounted on the FIXED base at the press
         point (world 0.12 0.50 0.62 == unlock_press_world while the drawer is
         closed).  Axis -x: the tool pushes it inward to its 5 mm limit.  It is
         deliberately NOT on the drawer: pressing a cap mounted on a spring-
         loaded rail would shove the drawer out of contact and release the
         press, exactly like the real b1p on the fixed handle riser. -->
    <link name="unlock_button_cap">
      <pose>0.12 0.50 0.62 0 0 0</pose>
      <collision name="cap_col">
        <geometry><box><size>0.02 0.02 0.02</size></box></geometry>
      </collision>
      <visual name="cap_vis">
        <geometry><box><size>0.02 0.02 0.02</size></box></geometry>
      </visual>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>1.7e-6</ixx><iyy>1.7e-6</iyy><izz>1.7e-6</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
    </link>
    <joint name="anchor_base" type="fixed">
      <parent>world</parent>
      <child>base</child>
    </joint>
    <joint name="drawer_slide" type="prismatic">
      <parent>base</parent>
      <child>drawer</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit><lower>0</lower><upper>0.3</upper><effort>1000</effort><velocity>10</velocity></limit>
      </axis>
    </joint>
    <joint name="unlock_button_slide" type="prismatic">
      <parent>base</parent>
      <child>unlock_button_cap</child>
      <axis>
        <xyz>-1 0 0</xyz>
        <limit><lower>0</lower><upper>0.005</upper><effort>50</effort><velocity>5</velocity></limit>
        <dynamics><damping>0.1</damping><friction>0.3</friction></dynamics>
      </axis>
    </joint>
    <plugin name="xczs_drawer_p2_state" filename="libxczs_cabinet_state.so">
      <ros>
        <namespace>/xczs/cabinet/test</namespace>
      </ros>
      <state_publish_rate>50.0</state_publish_rate>
      <reset_service>/xczs/cabinet/test/reset_physics</reset_service>
      <grasp_service>/xczs/cabinet/test/grasp</grasp_service>
      <bimanual_grasp_service>/xczs/cabinet/test/bimanual_grasp</bimanual_grasp_service>
      <unlock_service>/xczs/cabinet/test/unlock</unlock_service>
      <grasp_active_topic>/xczs/cabinet/test/grasp_active</grasp_active_topic>
      <active_control_topic>/xczs/cabinet/test/active_control</active_control_topic>
      <operation_heartbeat_topic>/xczs/cabinet/test/operation_heartbeat</operation_heartbeat_topic>
      <operation_fault_topic>/xczs/cabinet/test/operation_fault</operation_fault_topic>
      <grasp_distance_threshold>0.12</grasp_distance_threshold>
      <operation_watchdog_timeout>2.0</operation_watchdog_timeout>
      <control>
        <control_id>test_drawer</control_id>
        <control_type>drawer</control_type>
        <joint_name>drawer_slide</joint_name>
        <joint_state_topic>/xczs/cabinet/test/test_drawer/joint_states</joint_state_topic>
        <pressed_topic>/xczs/cabinet/test/test_drawer/pressed</pressed_topic>
        <state_topic>/xczs/cabinet/test/test_drawer/state</state_topic>
        <state_ids>closed open</state_ids>
        <detents>0.0 0.3</detents>
        <detent_stiffness>12</detent_stiffness>
        <spring_damping>1</spring_damping>
        <detent_hysteresis>0.01</detent_hysteresis>
        <motion_tolerance>0.05</motion_tolerance>
        <reset_position>0.0</reset_position>
        <graspable>true</graspable>
        <grasp_point>0.069 0.10 0.12</grasp_point>
        <right_grasp_point>0.069 0.50 0.12</right_grasp_point>
        <unlock_press_point>0.12 0.50 0.12</unlock_press_point>
        <unlock_distance_threshold>0.1</unlock_distance_threshold>
        <unlock_button_id>test_drawer_unlock_button</unlock_button_id>
        <grasp_contact_threshold>0.02</grasp_contact_threshold>
        <coupling_contact_grace_seconds>0.5</coupling_contact_grace_seconds>
        <drawer_latch_stiffness>500</drawer_latch_stiffness>
      </control>
      <control>
        <control_id>test_drawer_unlock_button</control_id>
        <control_type>button</control_type>
        <joint_name>unlock_button_slide</joint_name>
        <joint_state_topic>/xczs/cabinet/test/test_drawer_unlock_button/joint_states</joint_state_topic>
        <pressed_topic>/xczs/cabinet/test/test_drawer_unlock_button/pressed</pressed_topic>
        <state_topic>/xczs/cabinet/test/test_drawer_unlock_button/state</state_topic>
        <state_ids>released pressed</state_ids>
        <spring_stiffness>800</spring_stiffness>
        <!-- spring_damping 8 + 0.05 kg cap reproduces the proven-stable
             generator button config in the real scene (compliant press,
             clean return).  The harness exercises the physical-press contract
             logic; the real b1p dynamics (0.02 kg) are validated live. -->
        <spring_damping>8</spring_damping>
        <press_threshold>0.0012</press_threshold>
        <release_threshold>0.0006</release_threshold>
        <reset_position>0.0</reset_position>
      </control>
    </plugin>
  </model>
</sdf>
