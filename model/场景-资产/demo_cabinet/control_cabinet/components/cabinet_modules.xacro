<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro
    name="control_cabinet_module"
    params="index body_mesh body_xyz knob_mesh knob_xyz knob_blade_xyz:='0 0.0135 0.018' knob_blade_size:='0.011 0.065 0.036'">
    <xacro:control_cabinet_visual_link
      link_name="box_${index}"
      mesh_name="${body_mesh}"
      urdf_material="cabinet_light_gray"
      gazebo_material="Gazebo/Grey" />
    <xacro:control_cabinet_fixed_joint
      joint_name="cabinet_body_box_${index}"
      parent_link="cabinet_body"
      child_link="box_${index}"
      xyz="${body_xyz}" />

    <xacro:control_cabinet_interactive_knob
      link_name="box_${index}_knob"
      joint_name="box_${index}_box_${index}_knob"
      mesh_name="${knob_mesh}"
      parent_link="cabinet_body"
      xyz="${knob_xyz}"
      blade_xyz="${knob_blade_xyz}"
      blade_size="${knob_blade_size}"
      urdf_material="cabinet_black"
      gazebo_material="Gazebo/Black" />
  </xacro:macro>

  <xacro:macro
    name="control_cabinet_buttons"
    params="index button_1_mesh button_2_mesh button_1_xyz button_2_xyz">
    <xacro:control_cabinet_interactive_button
      link_name="box_${index}_button_1"
      joint_name="box_${index}_box_${index}_button_1"
      mesh_name="${button_1_mesh}"
      parent_link="cabinet_body"
      xyz="${button_1_xyz}"
      urdf_material="cabinet_red"
      gazebo_material="Gazebo/Red" />

    <xacro:control_cabinet_interactive_button
      link_name="box_${index}_button_2"
      joint_name="box_${index}_box_${index}_button_2"
      mesh_name="${button_2_mesh}"
      parent_link="cabinet_body"
      xyz="${button_2_xyz}"
      urdf_material="cabinet_green"
      gazebo_material="Gazebo/Green" />
  </xacro:macro>

  <xacro:macro name="control_cabinet_switch" params="">
    <link name="cabinet_switch_handle">
      <inertial>
        <origin xyz="0 0 0.01" rpy="0 0 0" />
        <mass value="0.15" />
        <inertia
          ixx="8.5e-05" ixy="0" ixz="0"
          iyy="1.0e-05" iyz="0" izz="8.5e-05" />
      </inertial>
      <visual>
        <!-- The exported mesh origin is at one corner of the handle. -->
        <origin xyz="0.01 -0.04 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="${cabinet_mesh_directory}/cabinet_switch_handle.stl" />
        </geometry>
        <material name="cabinet_black" />
      </visual>
      <collision name="cabinet_switch_handle_collision">
        <origin xyz="0 0 0.01" rpy="0 0 0" />
        <geometry>
          <box size="0.020 0.080 0.020" />
        </geometry>
      </collision>
    </link>
    <joint name="cabinet_switch_base_cabinet_switch_handle" type="revolute">
      <origin xyz="0.342 1.680 -0.018" rpy="0 0 0" />
      <parent link="cabinet_rear_door" />
      <child link="cabinet_switch_handle" />
      <axis xyz="0 0 1" />
      <limit lower="0" upper="${cabinet_switch_joint_limit}" effort="10" velocity="1" />
      <dynamics damping="0.08" friction="0.04" />
    </joint>
    <xacro:control_cabinet_gazebo_link
      link_name="cabinet_switch_handle"
      gazebo_material="Gazebo/Black"
      has_collision="true" />
    <gazebo reference="cabinet_switch_base_cabinet_switch_handle">
      <implicitSpringDamper>true</implicitSpringDamper>
      <provideFeedback>true</provideFeedback>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="control_cabinet_modules" params="">
    <xacro:control_cabinet_module
      index="1"
      body_mesh="box_type_a"
      knob_mesh="knob_standard"
      body_xyz="0.005 1.826 0"
      knob_xyz="0.16747 2.05094 0.0295" />
    <xacro:control_cabinet_buttons
      index="1"
      button_1_mesh="button_standard"
      button_2_mesh="button_standard"
      button_1_xyz="0.120 1.876 0.011"
      button_2_xyz="0.170 1.876 0.011" />

    <xacro:control_cabinet_module
      index="2"
      body_mesh="box_2"
      knob_mesh="knob_standard"
      body_xyz="0.334 1.826 0"
      knob_xyz="0.49647 2.05094 0.0295" />
    <xacro:control_cabinet_buttons
      index="2"
      button_1_mesh="button_standard"
      button_2_mesh="button_standard"
      button_1_xyz="0.449 1.876 0.011"
      button_2_xyz="0.499 1.876 0.011" />

    <xacro:control_cabinet_module
      index="3"
      body_mesh="box_type_b"
      knob_mesh="knob_standard"
      body_xyz="0.005 1.497 0"
      knob_xyz="0.16747 1.72194 0.0295" />
    <xacro:control_cabinet_buttons
      index="3"
      button_1_mesh="button_standard"
      button_2_mesh="button_standard"
      button_1_xyz="0.120 1.547 0.011"
      button_2_xyz="0.170 1.547 0.011" />

    <xacro:control_cabinet_module
      index="4"
      body_mesh="box_type_a"
      knob_mesh="knob_standard"
      body_xyz="0.334 1.497 0"
      knob_xyz="0.49647 1.72194 0.0295" />
    <xacro:control_cabinet_buttons
      index="4"
      button_1_mesh="button_standard"
      button_2_mesh="button_standard"
      button_1_xyz="0.449 1.547 0.011"
      button_2_xyz="0.499 1.547 0.011" />

    <xacro:control_cabinet_module
      index="5"
      body_mesh="box_type_b"
      knob_mesh="knob_standard"
      body_xyz="0.005 1.168 0"
      knob_xyz="0.16747 1.39294 0.0295" />
    <xacro:control_cabinet_buttons
      index="5"
      button_1_mesh="button_standard"
      button_2_mesh="button_standard"
      button_1_xyz="0.120 1.218 0.011"
      button_2_xyz="0.170 1.218 0.011" />

    <xacro:control_cabinet_module
      index="6"
      body_mesh="box_type_a"
      knob_mesh="knob_standard"
      body_xyz="0.334 1.168 0"
      knob_xyz="0.49647 1.39294 0.0295" />
    <xacro:control_cabinet_buttons
      index="6"
      button_1_mesh="button_standard"
      button_2_mesh="button_standard"
      button_1_xyz="0.449 1.218 0.011"
      button_2_xyz="0.499 1.218 0.011" />

    <xacro:control_cabinet_module
      index="7"
      body_mesh="box_type_b"
      knob_mesh="knob_standard"
      body_xyz="0.005 0.839 0"
      knob_xyz="0.16747 1.06394 0.0295" />
    <xacro:control_cabinet_buttons
      index="7"
      button_1_mesh="button_standard"
      button_2_mesh="button_standard"
      button_1_xyz="0.120 0.889 0.011"
      button_2_xyz="0.170 0.889 0.011" />

    <xacro:control_cabinet_module
      index="8"
      body_mesh="box_type_a"
      knob_mesh="knob_standard"
      body_xyz="0.334 0.839 0"
      knob_xyz="0.49647 1.06394 0.0295" />
    <xacro:control_cabinet_buttons
      index="8"
      button_1_mesh="button_standard"
      button_2_mesh="button_standard"
      button_1_xyz="0.449 0.889 0.011"
      button_2_xyz="0.499 0.889 0.011" />

    <!-- Box 9 has a knob but no buttons in the source assembly. -->
    <xacro:control_cabinet_module
      index="9"
      body_mesh="box_9"
      knob_mesh="box_9_knob"
      body_xyz="0.005 0.721 0"
      knob_xyz="0.12494 0.774526 0.0295"
      knob_blade_xyz="0.0135 0 0.018"
      knob_blade_size="0.065 0.011 0.036" />

    <xacro:control_cabinet_module
      index="10"
      body_mesh="box_10"
      knob_mesh="knob_standard"
      body_xyz="0.005 0.519 0"
      knob_xyz="0.13547 0.63094 0.0295" />
    <xacro:control_cabinet_buttons
      index="10"
      button_1_mesh="box_10_button_1"
      button_2_mesh="box_10_button_2"
      button_1_xyz="0.492 0.574 0.011"
      button_2_xyz="0.527 0.574 0.011" />

    <xacro:control_cabinet_module
      index="11"
      body_mesh="box_11"
      knob_mesh="box_11_knob"
      body_xyz="0.005 0.322 0"
      knob_xyz="0.13547 0.43394 0.0295" />
    <xacro:control_cabinet_buttons
      index="11"
      button_1_mesh="box_11_button_1"
      button_2_mesh="box_11_button_2"
      button_1_xyz="0.492 0.377 0.011"
      button_2_xyz="0.527 0.377 0.011" />

    <xacro:control_cabinet_switch />
  </xacro:macro>
</robot>
