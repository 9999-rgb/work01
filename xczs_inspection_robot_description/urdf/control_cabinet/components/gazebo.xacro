<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro
    name="control_cabinet_gazebo_link"
    params="link_name gazebo_material has_collision:=false">
    <gazebo reference="${link_name}">
      <material>${gazebo_material}</material>
      <xacro:if value="${has_collision}">
        <mu1>${cabinet_contact_friction}</mu1>
        <mu2>${cabinet_contact_friction}</mu2>
        <kp>${cabinet_contact_kp}</kp>
        <kd>${cabinet_contact_kd}</kd>
        <maxVel>${cabinet_contact_max_velocity}</maxVel>
        <minDepth>${cabinet_contact_min_depth}</minDepth>
      </xacro:if>
    </gazebo>
  </xacro:macro>

  <xacro:macro
    name="control_cabinet_button_plugin"
    params="button_id joint_name">
    <plugin
      name="xczs_cabinet_${button_id}_state"
      filename="libxczs_cabinet_button.so">
      <ros>
        <namespace>/xczs/cabinet/${button_id}</namespace>
      </ros>
      <joint_name>${joint_name}</joint_name>
      <!-- Absolute names avoid Gazebo model-load-order namespace leakage. -->
      <joint_state_topic>/xczs/cabinet/${button_id}/joint_states</joint_state_topic>
      <pressed_topic>/xczs/cabinet/${button_id}/pressed</pressed_topic>
      <spring_stiffness>800.0</spring_stiffness>
      <spring_damping>8.0</spring_damping>
      <press_threshold>0.006</press_threshold>
      <release_threshold>0.003</release_threshold>
      <state_publish_rate>50.0</state_publish_rate>
    </plugin>
  </xacro:macro>

  <xacro:macro name="control_cabinet_gazebo" params="">
    <gazebo>
      <!-- The body is fixed to world; interactive controls remain dynamic. -->
      <static>false</static>
      <selfCollide>false</selfCollide>
      <xacro:control_cabinet_button_plugin
        button_id="box_10_button_1"
        joint_name="box_10_box_10_button_1" />
      <xacro:control_cabinet_button_plugin
        button_id="box_10_button_2"
        joint_name="box_10_box_10_button_2" />
    </gazebo>
  </xacro:macro>
</robot>
