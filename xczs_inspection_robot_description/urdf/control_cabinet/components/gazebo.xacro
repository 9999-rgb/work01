<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro
    name="control_cabinet_gazebo_link"
    params="link_name gazebo_material has_collision:=false">
    <gazebo reference="${link_name}">
      <material>${gazebo_material}</material>
      <xacro:if value="${has_collision}">
        <mu1>${cabinet_contact_friction}</mu1>
        <mu2>${cabinet_contact_friction}</mu2>
        <kp>${cabinet_contact_kp}</kp>
        <kd>${cabinet_contact_kd}</kd>
        <maxVel>${cabinet_contact_max_velocity}</maxVel>
        <minDepth>${cabinet_contact_min_depth}</minDepth>
      </xacro:if>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="control_cabinet_gazebo" params="">
    <gazebo>
      <!-- The body is fixed to world; the selected button remains dynamic. -->
      <static>false</static>
      <selfCollide>false</selfCollide>
      <plugin
        name="xczs_cabinet_button_state"
        filename="libxczs_cabinet_button.so">
        <ros>
          <namespace>/xczs/cabinet/box_10_button_1</namespace>
        </ros>
        <joint_name>box_10_box_10_button_1</joint_name>
        <!-- Absolute names avoid Gazebo model-load-order namespace leakage. -->
        <joint_state_topic>/xczs/cabinet/box_10_button_1/joint_states</joint_state_topic>
        <pressed_topic>/xczs/cabinet/box_10_button_1/pressed</pressed_topic>
        <spring_stiffness>800.0</spring_stiffness>
        <spring_damping>8.0</spring_damping>
        <press_threshold>0.006</press_threshold>
        <release_threshold>0.003</release_threshold>
        <state_publish_rate>50.0</state_publish_rate>
      </plugin>
    </gazebo>
  </xacro:macro>
</robot>
