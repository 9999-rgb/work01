<?xml version="1.0"?>
<!--
  Dual-arm inspection robot - the original single-arm SolidWorks model has been
  replaced by the LinkForge dual-arm export (model/双臂机器人) plus four
  SolidWorks end-effector tools (model/urdf20260817), all converted to xacro.
  The chassis, planar navigation, sensor pipeline and ros2_control conventions
  are reused unchanged.
-->
<robot
  xmlns:xacro="http://www.ros.org/wiki/xacro"
  name="xczs_inspection_robot">

  <xacro:arg
    name="initial_positions_file"
    default="$(find xczs_inspection_robot_description)/config/initial_positions.yaml" />

  <!--
    末端工具套装选择（A / B，默认 A）：
      A - 三个电缸(右) + 两个电缸(左)，用于抽拉柜 / 按钮 / 柜门
      B - 旋转按钮机构(右) + 摇入摇出机构(左)，用于旋钮 / 摇杆开关
    每臂只挂载所选套装的一只工具，另一只不在 URDF 中出现。由
    inspection_robot.launch.py 的 `toolset` 参数通过 xacro 命令与
    MoveItConfigsBuilder 的 mappings 传入。
  -->
  <xacro:arg name="toolset" default="A" />
  <!--
    Gazebo Classic may finish tearing down a replaced model's plugins after
    DeleteEntity has returned.  The runtime toolset supervisor supplies a new
    validated value for every robot child so each Gazebo ROS plugin receives a
    distinct private node name.  This does not affect links, geometry,
    collision, materials, entity name or topic names.
  -->
  <xacro:arg name="gazebo_plugin_instance_id" default="initial" />

  <!-- Shared definitions. -->
  <xacro:include filename="components/properties.xacro" />
  <xacro:include filename="components/materials.xacro" />

  <!-- Robot components. -->
  <xacro:include filename="components/dual_arm_body.xacro" />
  <xacro:include filename="components/dual_arm_manipulator.xacro" />
  <xacro:include filename="components/tools.xacro" />
  <xacro:include filename="components/sensors.xacro" />
  <xacro:include filename="components/ros2_control.xacro" />
  <xacro:include filename="components/gazebo_plugins.xacro" />

  <!-- Component order - body first, then arms, tools, sensors, control, gazebo. -->
  <xacro:xczs_dual_arm_body />
  <xacro:xczs_dual_arm_manipulator />
  <xacro:xczs_dual_arm_cameras />
  <xacro:xczs_tools />
  <xacro:xczs_sensors />
  <xacro:xczs_ros2_control
    initial_positions_file="$(arg initial_positions_file)" />
  <xacro:xczs_gazebo />
</robot>
