      <visual name="visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://xczs_inspection_robot_description/meshes/scenes/electrical_mezzanine/b1.STL</uri></mesh>
        </geometry>
        <material>
          <ambient>0.7 0.73 0.78 1</ambient>
          <diffuse>0.7 0.73 0.78 1</diffuse>
        </material>
      </visual>
      <!-- 2026-09-04 碰撞代理：b1.STL（用户 SW 原版导出，与仿真场景20260831
           逐字节一致）为全扇形退化网格——140 个三角形全部经由六个 ±1m 单元点
           + 单位圆幽灵顶点连接，无任何真实表面三角形。两前把手立板因此无实体
           碰撞：钩爪杆（l_two_cyl_finger2/r_three_cyl_finger1）压贴无物可抵，
           旧几何门读数即源于此。视觉保留原网格（用户资产、不改外观），碰撞改
           为两前把手立板的合同盒（P0 §2.1 与 live 接触封定：x 0.008..0.069
           前缘 0.099 世界、y 0.052..0.068 与 0.638..0.654、z 0.072..0.168，
           均 b1 局部）——抓取点即盒面中心，几何门参考语义精确成立。压贴证据
           为杆电缸 effort ≥8N（AGENT §8.4 fix#3 v2，v1 杆位判据因 rigid 面
           物理不可穿不可达而废止）。cap-2 读数噪声已另由代码侧 fix#21（双侧
           连续在位 ≥0.4s）覆盖。
           [2026-09-06 09-06 A/B 取证] 13:04 一度改回 b1.STL 网格碰撞重跑
           cap5（干净启动#3）：右钩压贴 0N 自由空气直通 0.030 ref —— 纯网格
           无立板面，力证据永不成立，必须保留合同盒。恢复本盒；s42b 时代右杆
           接合偏二态（n1 10.5mm 短/ n2 28.3mm@8.5N 掠边）判为 boot 运气 +
           dock/IK 分支敏感（09-06 12:16-12:38 同 operator 同盒连续 7 次右杆端
           ≤1.5mm），clean-start #4 复核；若再现再按 probe 实测重标 aim
           （adapter 09-04 fix#3 v3-v4/fix#5 注释：aim 随 dock 换 IK 分支）。 -->
      <collision name="collision_plate_l">
        <pose>0.0385 0.060 0.120 0 0 0</pose>
        <geometry>
          <box>
            <size>0.061 0.016 0.096</size>
          </box>
        </geometry>
      </collision>
      <collision name="collision_plate_r">
        <pose>0.0385 0.646 0.120 0 0 0</pose>
        <geometry>
          <box>
            <size>0.061 0.016 0.096</size>
          </box>
        </geometry>
      </collision>
      <!-- 圆形机构 b1r 并入抽屉本体 b1；指示灯 b1p 随下方 visual_p/collision_p
           并入 b1（固定装饰，仅显示，与 s2p/s3p 同范式，非按钮、无行程）。 -->
      <visual name="visual_r">
        <pose>0.03 0.16661 0.12017 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://xczs_inspection_robot_description/meshes/scenes/electrical_mezzanine/b1r.STL</uri></mesh>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.22 1</ambient>
          <diffuse>0.2 0.2 0.22 1</diffuse>
        </material>
      </visual>
