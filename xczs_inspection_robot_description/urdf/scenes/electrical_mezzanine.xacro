<?xml version="1.0" ?>
<sdf xmlns:xacro="http://www.ros.org/wiki/xacro" version="1.6">
  <model name="electrical_mezzanine">
    <static>false</static>
    <link name="dianqiground">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <pose>-5.02456755 4.04372601 2.45617776 0 0 0</pose>
        <mass>8964955.14</mass>
        <inertia>
          <ixx>1.03604648e+09</ixx>
          <ixy>20572265.4</ixy>
          <ixz>1e-09</ixz>
          <iyy>2.01759425e+09</iyy>
          <iyz>1e-09</iyz>
          <izz>3.01707467e+09</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://xczs_inspection_robot_description/meshes/scenes/electrical_mezzanine/dianqiground.STL</uri></mesh>
        </geometry>
        <material>
          <ambient>0.55 0.55 0.58 1</ambient>
          <diffuse>0.55 0.55 0.58 1</diffuse>
        </material>
      </visual>
      <!-- 地面碰撞：SW2URDF 导出的 dianqiground 仅有 visual、无 collision，导致
           整个场景为物理幻影（机器人可穿墙、AMCL 无法自定位）。之前将同一
           37.6K 三角 STL 整体挂为碰撞——但本世界物理引擎是 ODE（非 Bullet），
           巨质量地面（~9e6 kg）锚定世界后再以 trimesh 承接机器人车轮接触，
           会向地面刚体注入 NaN 速度（/get_entity_state xczs_scene_floor 的
           twist 全 NaN），进而使五扇滑门子关节 GetVelocity 全为 .nan：
           可操作预检（structured state 需有限 velocity/effort）持续
           NOT_READY "No fresh state"。改为发电机 fadianground 同款
           box 代理（A3 既定方案）：一块地板 slab 托住机器人（车轮 z≈0 压
           slab 顶面）。墙/设备碰撞暂以视觉为主——夹层 2D 雷达在 2.18m 平面
           天然全 .inf、AMCL 导航本不可用，墙体碰撞不影响任何当前决策；
           如需导航可按地图轮廓补墙盒（见 B3_REPORT）。五扇滑门
           （s1/s2/b1/s3/m1）为子 link 且模型未开 self_collide，与父 slab
           不互撞，门滑轨不受影响。 -->
      <collision name="collision">
        <pose>-5.3 0.2 -0.05 0 0 0</pose>
        <geometry>
          <box>
            <size>53.8 31.4 0.1</size>
          </box>
        </geometry>
      </collision>
    </link>
