    <joint name="ds1" type="prismatic">
      <pose>0 0 0 0 0 0</pose>
      <parent>dianqiground</parent>
      <child>s1</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>0</lower>
          <upper>0.38</upper>
          <effort>100</effort>
          <velocity>1</velocity>
        </limit>
        <!-- slider（与 db1 同 push-push 合同）：upper 0.38 为关门按压
             （release 0.34 + close_offset 0.02 = 0.36）留行程；friction 0.2
             远小于 detent 弹簧刚度，保证释放后弹簧能拉回关闭 detent。 -->
        <dynamics>
          <damping>30</damping>
          <friction>0.2</friction>
        </dynamics>
      </axis>
    </joint>
    
    
    <joint name="ds2" type="prismatic">
      <pose>0 0 0 0 0 0</pose>
      <parent>dianqiground</parent>
      <child>s2</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>0</lower>
          <upper>0.38</upper>
          <effort>100</effort>
          <velocity>1</velocity>
        </limit>
        <!-- slider（与 db1 同 push-push 合同）：upper 0.38 为关门按压
             （release 0.34 + close_offset 0.02 = 0.36）留行程；friction 0.2
             远小于 detent 弹簧刚度，保证释放后弹簧能拉回关闭 detent。 -->
        <dynamics>
          <damping>30</damping>
          <friction>0.2</friction>
        </dynamics>
      </axis>
    </joint>
    
    
