    <joint name="ds1" type="prismatic">
      <pose>0 0 0 0 0 0</pose>
      <parent>dianqiground</parent>
      <child>s1</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>0</lower>
          <upper>0.38</upper>
          <effort>100</effort>
          <velocity>1</velocity>
        </limit>
        <!-- slider（与 db1 同 push-push 合同）：upper 0.38 为关门按压
             （release 0.34 + close_offset 0.02 = 0.36）留行程；friction 0.2
             远小于 detent 弹簧刚度，保证释放后弹簧能拉回关闭 detent。 -->
        <dynamics>
          <damping>30</damping>
          <friction>0.2</friction>
        </dynamics>
      </axis>
    </joint>
    
    
    <joint name="ds2" type="prismatic">
      <pose>0 0 0 0 0 0</pose>
      <parent>dianqiground</parent>
      <child>s2</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>0</lower>
          <upper>0.38</upper>
          <effort>100</effort>
          <velocity>1</velocity>
        </limit>
        <!-- slider（与 db1 同 push-push 合同）：upper 0.38 为关门按压
             （release 0.34 + close_offset 0.02 = 0.36）留行程；friction 0.2
             远小于 detent 弹簧刚度，保证释放后弹簧能拉回关闭 detent。 -->
        <dynamics>
          <damping>30</damping>
          <friction>0.2</friction>
        </dynamics>
      </axis>
    </joint>
    
    
    <joint name="db1" type="prismatic">
      <pose>0 0 0 0 0 0</pose>
      <parent>dianqiground</parent>
      <child>b1</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>0</lower>
          <upper>0.38</upper>
          <effort>100</effort>
          <velocity>1</velocity>
        </limit>
        <!-- db1 为双手抽拉抽屉：关门/开门由双臂固定关节拖拽驱动（非弹簧拉回），
             故无需 slider 那套"弹簧顶过静摩擦"约束；0.2N 摩擦仅保证双臂释放后
             面板停在 detent 处不漂移（open detent 0.3 处无外力，80kg 惯性 +
             0.2N 摩擦 ≈ 静置）。detent 弹簧 12N/m 在双臂拉出/推回时提供
             闩位手感，插件锁止弹簧 500N/m 在解锁前把抽屉钉在关位。 -->
        <dynamics>
          <damping>30</damping>
          <friction>0.2</friction>
        </dynamics>
      </axis>
    </joint>
    
    
    <joint name="ds3" type="prismatic">
      <pose>0 0 0 0 0 0</pose>
      <parent>dianqiground</parent>
      <child>s3</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>0</lower>
          <upper>0.38</upper>
          <effort>100</effort>
          <velocity>1</velocity>
        </limit>
        <!-- slider（与 db1 同 push-push 合同）：upper 0.38 为关门按压
             （release 0.34 + close_offset 0.02 = 0.36）留行程；friction 0.2
             远小于 detent 弹簧刚度，保证释放后弹簧能拉回关闭 detent。 -->
        <dynamics>
          <damping>30</damping>
          <friction>0.2</friction>
        </dynamics>
      </axis>
    </joint>
    
    
    <joint name="dm1" type="prismatic">
      <pose>0 0 0 0 0 0</pose>
      <parent>dianqiground</parent>
      <child>m1</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>0</lower>
          <upper>0.38</upper>
          <effort>100</effort>
          <velocity>1</velocity>
        </limit>
        <!-- slider（与 db1 同 push-push 合同）：upper 0.38 为关门按压
             （release 0.34 + close_offset 0.02 = 0.36）留行程；friction 0.2
             远小于 detent 弹簧刚度，保证释放后弹簧能拉回关闭 detent。 -->
        <dynamics>
          <damping>30</damping>
          <friction>0.2</friction>
        </dynamics>
      </axis>
    </joint>

    <!-- ============================================================
         2026-09-07 db1 支撑版面合同盒（用户裁决：支撑杆应压「左右相邻柜体
         之间的版面」，非插入侧缝空腔自由悬停）。

         实测几何（boot-j work-pose audit + STL 世界 bbox）：db1(b1) 抽屉
         占 y∈[4.047,4.753] z∈[0.832,1.072]；下层东邻为 m1(y∈[4.847,5.553],
         实体 STL 碰撞)，两柜间为 94mm 空隙[4.753,4.847]；西缘(y<4.047)为空
         开放边界（相邻柜未建模实体）。支撑杆端落点 support_L y=4.039 /
         support_R y=4.761 均在无碰撞空腔里——支撑段杆端位置证据「自由伸入缝
         口内 6mm(0.093)」时无物可抵，视觉上末端悬空（用户三番反馈「没碰到柜
         体」即源于此）。

         修复 = 两扇不可见(仅 collision、无 visual、不改外观)的固定版面：
           西  b1_flank_west  y∈[3.800,4.045]  邻 b1 西缘(4.047，留 2mm 滑隙)
           东  b1_flank_east   y∈[4.757,4.845]  b1(4.753) 与 m1(4.847) 柜间
                                            94mm 空隙的中分版面
         两者前脸(最大 x 面)同为 x=0.096，z∈[0.84,1.06] 覆盖杆端 z≈0.952。
         支撑命令端 = 缝口x(0.099) − inset(0.006) = 0.093，比版面前脸再深 3mm
         → 实体跨模型碰撞把杆端顶在前脸 0.096：到达判据(≤6mm 容差)净余 3mm
         通过、补驱门(>6mm 才触发)不误触、8mm 硬门余量 5mm——杆端真实压贴
         版面(非幻影空走)，外观零改动。self_collide 关 → 与抽屉同模型不相撞，
         抽拉/回位零干涉；对机器人(异模型)为真实刚面。五门 <pose> 全零、offset
         放子 link 的夹具约定同样适用——两版面自身 <pose> 即世界位。
         ============================================================ -->
    <link name="b1_flank_west">
      <pose>0.071 3.9225 0.95 0 0 0</pose>
            <!-- 2026-09-11 停用（用户授权"物理参数可调、外观不能动"）：
           位置伺服化后，支撑杆顶到本版面不再"失速停住"，而是硬推穿进去 →
           与版面持续对顶，实测把整条臂激到 30~75mm 振荡。而支撑杆杆尖与钩爪
           前端伸出长度几乎相同，只要前伸到让钩爪进把手空隙，支撑杆必然捅进
           本版面；支撑杆 q 已在下限、无法回缩 —— 属结构性冲突。
           本版面**纯碰撞体、无外观网格**（外观零影响），故停用其 collision。
           link/joint 保留，恢复只需还原下面这段 <collision>。
           注意：operator §7 支撑门的"杆被版面挡停"依据随之失效，若要跑
           支撑段的验收流程，需先恢复本碰撞体。 -->

    </link>
    <!-- 2026-09-11 右爪让位：y 下沿 4.757 → 4.775（pose y 4.801→4.810，
         size y 0.088→0.070）。原下沿与把手立板(y 4.685–4.701)之间只有 56mm
         走廊，而右钩爪本体宽 55.3mm，塞进去只剩 0.35mm 余量 —— 实测右爪有
         246 个顶点嵌进本版面、引发 5.7mm 接触颤振。抬高下沿后右爪本体
         (y 4.7073–4.7626) 有 12mm 余量。**右支撑杆 (y 4.782–4.817) 仍完整
         落在版面上，挡停合同不受影响。** 仅改碰撞体，外观网格未动。 -->
    <link name="b1_flank_east">
      <pose>0.071 4.810 0.95 0 0 0</pose>
            <!-- 2026-09-11 停用（用户授权"物理参数可调、外观不能动"）：
           位置伺服化后，支撑杆顶到本版面不再"失速停住"，而是硬推穿进去 →
           与版面持续对顶，实测把整条臂激到 30~75mm 振荡。而支撑杆杆尖与钩爪
           前端伸出长度几乎相同，只要前伸到让钩爪进把手空隙，支撑杆必然捅进
           本版面；支撑杆 q 已在下限、无法回缩 —— 属结构性冲突。
           本版面**纯碰撞体、无外观网格**（外观零影响），故停用其 collision。
           link/joint 保留，恢复只需还原下面这段 <collision>。
           注意：operator §7 支撑门的"杆被版面挡停"依据随之失效，若要跑
           支撑段的验收流程，需先恢复本碰撞体。 -->

    </link>
    <joint name="b1_flank_west_fix" type="fixed">
      <parent>dianqiground</parent>
      <child>b1_flank_west</child>
    </joint>
    <joint name="b1_flank_east_fix" type="fixed">
      <parent>dianqiground</parent>
      <child>b1_flank_east</child>
    </joint>

    <!-- 电气夹层 3.0 动态化：整模型取消 static，地面经固定关节锚定世界，
         五扇滑门（ds1/ds2/db1/ds3/dm1，prismatic (1,0,0)）保留可动。门为
         push-push 闩锁 slider（B3b live 验证）：开 = 推至 detent 0.3 闩住；
         关 = 推过 release 0.34 触发插件释放 → detent 弹簧把面板拉回关闭
         detent 0。关节 upper 0.38 为关门按压（release + close_offset = 0.36）
         留行程；friction 0.2 远小于 detent 弹簧刚度（12 N/m），保证弹簧能把
         80kg 面板拉回关闭 detent（db1 的 B3b 实测校准，其余四扇同参数）。
         重要：所有夹具关节的 <pose> 必须为 0（位置一律放到子 link 的
         <pose>，与 generator_plant 同构）。live 验证：本 Gazebo Classic 11
         下若把平移偏移放在 prismatic/fixed 关节的 <pose>（子 link 保持
         identity），子 link 会在父原点处生成、关节约束失效——门直接脱离
         坠落（b1 实测掉到世界原点附近翻滚）。offset 放子 link 后五扇门
         均在位、滑轨约束正常。 -->
    <joint name="anchor_dianqiground" type="fixed">
      <parent>world</parent>
      <child>dianqiground</child>
    </joint>
    <plugin name="xczs_electrical_mezzanine_state" filename="libxczs_cabinet_state.so">
      <ros>
        <namespace>/xczs/cabinet/electrical_mezzanine</namespace>
      </ros>
      <state_publish_rate>20.0</state_publish_rate>
      <reset_service>/xczs/cabinet/electrical_mezzanine/reset_physics</reset_service>
      <grasp_service>/xczs/cabinet/electrical_mezzanine/grasp</grasp_service>
      <!-- P3 双手抽拉抽屉合同：bimanual_grasp / unlock 服务由 plugin 在抽屉
           <control> 上按需创建（db1 等 drawer 合同控件）。服务名必须在插件级
           显式声明为夹层命名空间，避免落到共享默认
           /xczs/cabinet/{bimanual_grasp,unlock} 与其它场景冲突。 -->
      <bimanual_grasp_service>/xczs/cabinet/electrical_mezzanine/bimanual_grasp</bimanual_grasp_service>
      <unlock_service>/xczs/cabinet/electrical_mezzanine/unlock</unlock_service>
      <grasp_active_topic>/xczs/cabinet/electrical_mezzanine/grasp_active</grasp_active_topic>
      <active_control_topic>/xczs/cabinet/electrical_mezzanine/active_control</active_control_topic>
      <operation_heartbeat_topic>/xczs/cabinet/electrical_mezzanine/operation_heartbeat</operation_heartbeat_topic>
      <operation_fault_topic>/xczs/cabinet/electrical_mezzanine/operation_fault</operation_fault_topic>
      <grasp_distance_threshold>0.12</grasp_distance_threshold>
      <operation_watchdog_timeout>2.0</operation_watchdog_timeout>
      <!-- ds1/ds2/ds3/dm1 与 db1 同为 push-push 闩锁 slider：release 0.34
           严格高于开门按压物理峰值（B3b 实测 ~0.307~0.332），关门按压越过
           release 触发释放、弹簧拉回关闭 detent。 -->
      <control>
        <control_id>ds1</control_id>
        <control_type>slider</control_type>
        <joint_name>ds1</joint_name>
        <joint_state_topic>/xczs/cabinet/electrical_mezzanine/ds1/joint_states</joint_state_topic>
        <pressed_topic>/xczs/cabinet/electrical_mezzanine/ds1/pressed</pressed_topic>
        <state_topic>/xczs/cabinet/electrical_mezzanine/ds1/state</state_topic>
        <state_ids>closed open</state_ids>
        <detents>0.0 0.3</detents>
        <detent_stiffness>12</detent_stiffness>
        <spring_damping>1</spring_damping>
        <detent_hysteresis>0.01</detent_hysteresis>
        <slider_release_position>0.34</slider_release_position>
        <slider_release_reengage_position>0.13</slider_release_reengage_position>
        <motion_tolerance>0.05</motion_tolerance>
        <reset_position>0.0</reset_position>
        <!-- 正面抽拉：把手/指示灯为固定装饰（用户确认"只是指示灯"），操作改为
             grasp 固定关节附着面板前脸 + 沿滑动轴线性拖拽（operator
             grasp_operated 分支），不再用西侧 push-push。grasp_point 为面板
             s1 前脸中心（面板局部系，s 型面板 bbox x∈[-0.53,0.069] y∈[0,0.29]
             z∈[0,0.26]）。 -->
        <graspable>true</graspable>
        <grasp_point>0.069 0.145 0.13</grasp_point>
      </control>
      <control>
        <control_id>ds2</control_id>
        <control_type>slider</control_type>
        <joint_name>ds2</joint_name>
        <joint_state_topic>/xczs/cabinet/electrical_mezzanine/ds2/joint_states</joint_state_topic>
        <pressed_topic>/xczs/cabinet/electrical_mezzanine/ds2/pressed</pressed_topic>
        <state_topic>/xczs/cabinet/electrical_mezzanine/ds2/state</state_topic>
        <state_ids>closed open</state_ids>
        <detents>0.0 0.3</detents>
        <detent_stiffness>12</detent_stiffness>
        <spring_damping>1</spring_damping>
        <detent_hysteresis>0.01</detent_hysteresis>
        <slider_release_position>0.34</slider_release_position>
        <slider_release_reengage_position>0.13</slider_release_reengage_position>
        <motion_tolerance>0.05</motion_tolerance>
        <reset_position>0.0</reset_position>
        <!-- 正面抽拉（grasp 固定关节 + 线性拖拽），grasp_point = s2 前脸中心。 -->
        <graspable>true</graspable>
        <grasp_point>0.069 0.145 0.13</grasp_point>
      </control>
      <control>
        <control_id>db1</control_id>
        <control_type>drawer</control_type>
        <joint_name>db1</joint_name>
        <joint_state_topic>/xczs/cabinet/electrical_mezzanine/db1/joint_states</joint_state_topic>
        <pressed_topic>/xczs/cabinet/electrical_mezzanine/db1/pressed</pressed_topic>
        <state_topic>/xczs/cabinet/electrical_mezzanine/db1/state</state_topic>
        <state_ids>closed open</state_ids>
        <detents>0.0 0.3</detents>
        <detent_stiffness>12</detent_stiffness>
        <!-- 锁存阻尼 2026-09-02：db1 是 80.6 kg 的欠阻尼体（阻尼 30 N·s/m +
             1 → ζ≈0.077）。每次 fresh spawn / 扰动后它会顶在 0..5.8mm 的
             闩位弹簧上以 ~2s 周期环振 30s+（实测 run1），解锁按压的几何在
             环振面上失去意义——读回低轨位下达深压指令时抽屉又向东弹回，
             帽瞬时被打穿 3mm 行程（cap 峰值 6.37mm，即用户看到的"按钮穿模
             乱跑"）。此处把未被抓握时的阻尼提到 370（+关节 30 → 总 ~400 ≈
             500 N/m × 80.6 kg 的临界阻尼 401），环振 ~2-3s 内衰减，按压落在
             静止抽屉上即干净压入（与已坐定 0.76mm 基线 run2 的 2.89mm 无过
             压一致）。被抓握拖拽时有效阻尼切到 grasp_damping 500，不受影响；
             未解锁释放后 detent 弹簧侧变为过阻尼（无振荡、更稳地停在卡位）。 -->
        <spring_damping>370</spring_damping>
        <detent_hysteresis>0.01</detent_hysteresis>
        <motion_tolerance>0.05</motion_tolerance>
        <reset_position>0.0</reset_position>
        <!-- 双手抽拉（bimanual drawer 合同；把手几何 2026-09-09 用户目视裁决 =
             b1.STL 原生两条竖向立筋把手 + 前脸受力背衬 handle_bar_backing 力墙，
             外加横杆已全部删除；b1p 恢复真实可按解锁按钮）：
             左右钩爪（config B = l_two_cyl_finger1 / r_three_cyl_finger2，端深
             -0.075）自 +X 侧推进，杆端压贴各自竖立筋前脸得力。grasp_point /
             right_grasp_point = 左/右把手抓取锚（b1 局部，世界 (0.099,4.107/4.693,
             0.952)），正是竖立筋中心（L y0.052..0.068、R y0.638..0.654，
             z 0.072..0.168 的 b1 局部中心 0.060/0.646/0.120），压在立筋前脸
             x0.099 = 背衬前缘同一平面。
             解锁（2026-09-09 用户拍板恢复「真实可按按钮」）= b1p 已拆为独立可压
             红帽（link b1p/b1p_anchor + b1p_joint，0..12mm 朝柜内 -X）。右侧解锁
             电机（r_three_cyl_finger3_joint）从同一工作位姿独立伸出，真实端面把
             b1p 按钮真按入（db1_unlock_button pressed 物证，Position ≥0.0035）；
             plugin 解锁门 = 距离（finger3 真实端点距 b1p 外端面中心 ≤
             unlock_distance_threshold）+ 按钮真按下（non-sim 物证）+ 左右钩杆端
             保持（unlock_hold_*，距左右 grasp_point ≤ grasp_contact_threshold）+
             有效租约会话——不再有任何 simulated_linkage / simulation_acceptance。
             P0 几何冻结（世界 == 夹具局部系，b1 根 (0.030,4.047,0.83187)）：b1p
             外端面中心 b1 局部 (0.069,0.646,0.1705) = 世界 (0.099,4.693,1.002)，
             位于 R 竖立筋顶缘上方（立筋中心 z0.952）。grasp/unlock 点均位于抽屉
             子 link b1 局部系（plugin 以 control.link WorldPose 叠加，随抽屉同步
             滑动）。 -->
        <graspable>true</graspable>
        <grasp_point>0.069 0.060 0.120</grasp_point>
        <right_grasp_point>0.069 0.646 0.120</right_grasp_point>
        <unlock_press_point>0.069 0.646 0.1705</unlock_press_point>
        <unlock_distance_threshold>0.010</unlock_distance_threshold>
        <!-- 解锁物证（2026-09-09 恢复真按钮版）：unlock_press_point = b1p 按钮外
             端面中心（b1 局部，世界 (0.099,4.693,1.002)；old §4.4 0.120/§4.2 sim
             废止）。plugin 解锁门 = 机器人模型 unlock_motor_joint（右解锁短级电缸
             r_three_cyl_finger3_joint）实际伸出 ≥ retracted+floor（真行程）+ 该杆
             真实端点到 unlock_press_point 距离 ≤ unlock_distance_threshold（0.010
             ——button 外端面随按压内缩，按压 3.5-6mm 时端点仍距静止面中心 ≤6mm
             故容差取 10mm 覆盖真实压入）+ db1_unlock_button（b1p_joint）Position
             ≥ press_threshold（真按下物证）。 -->
        <unlock_motor_joint>r_three_cyl_finger3_joint</unlock_motor_joint>
        <unlock_retracted_position>0.0</unlock_retracted_position>
        <unlock_extension_floor>0.001</unlock_extension_floor>
        <unlock_extension_ceiling>0.0254</unlock_extension_ceiling>
        <!-- 解锁按钮控制引用（2026-09-09 恢复）：db1 抽屉解锁门指向 b1p 真按钮的
             button 控制（见本 plugin 内 db1_unlock_button），以其 pressed 状态 +
             b1p_joint 位移为真按下物证；不再有 §4.2 simulated_linkage。 -->
        <unlock_button_id>db1_unlock_button</unlock_button_id>
        <!-- [2026-09-09 config B 角色修正] 上两 link 是 009 时代 pre-swap 旧钩名：
             换杆后现役钩 = l_two_cyl_finger1 / r_three_cyl_finger2（端深均 -0.075），
             插件以两钩杆端距左右 grasp_point <= grasp_contact_threshold 独立实测
             （simulated_linkage 放行双物证之一）；旧名指向的是支撑杆（距把手 0.068 m
             必拒）。 -->
        <unlock_hold_left_link>l_two_cyl_finger1</unlock_hold_left_link>
        <unlock_hold_left_point>0 0 -0.075</unlock_hold_left_point>
        <unlock_hold_right_link>r_three_cyl_finger2</unlock_hold_right_link>
        <unlock_hold_right_point>0 0 -0.075</unlock_hold_right_point>
        <!-- 双臂附着接触门：左右工具尖端距各自把手 ≤ grasp_contact_threshold
             才允许附着（收紧 0.12 → 0.02，拒绝探针悬空假附着）；耦合拖拽期间
             任一侧尖端脱离把手超过 coupling_contact_grace_seconds 即中止
             耦合并发 operation_fault（拒虚空拉）。 -->
        <grasp_contact_threshold>0.02</grasp_contact_threshold>
        <coupling_contact_grace_seconds>0.5</coupling_contact_grace_seconds>
        <drawer_latch_stiffness>500</drawer_latch_stiffness>
        <!-- 线性耦合拖拽（bimanual 抓取契约）：不创建硬焊缝，改为在轨道
             关节上施加有界弹簧-阻尼力，让抽屉跟踪两把工具的指令位移。反
             作用力落在柜体轨道上而不是轻工具上，运动学遥移的臂完全按轨迹
             执行，joint_trajectory_controller 不再出现跟踪误差（run8 根
             因修复）。k=20000 N/m / d=500 下跟踪滞后 <1mm，卡滞时滞差有
             界 7.5mm < 指缝半间距 34mm，指爪始终跨住贯通拉杆（端面压贴背衬）。 -->
        <grasp_coupling_stiffness>20000</grasp_coupling_stiffness>
        <grasp_coupling_damping>500</grasp_coupling_damping>
        <grasp_coupling_max_effort>150</grasp_coupling_max_effort>
      </control>
      <!-- db1 解锁按钮：b1p_joint 是 b1p 红帽可压行程（0..12mm 朝柜内 -X，轴位移
           = 相对平齐位的压入深度）。它是 db1 抽屉 <unlock_button_id> 指向的按钮
           控制，负责施加 800 N/m 回位弹簧（006 活验参数：隐式弹簧阻尼见文件尾
           <gazebo reference="b1p_joint">）并产出 pressed 物证；本身不可抓取、
           不参与 operable/任务目录（006 语义）。press_threshold 3.5mm 高于静态
           摩擦平衡 0.375mm 与任何残余微动——真实按压须把帽按入 ≥3.5mm 才判
           pressed（杜绝「接近即解锁」）；release_threshold 0.6mm 保证松手回弹
           （平衡点 0.375mm）后真实释放。 -->
      <control>
        <control_id>db1_unlock_button</control_id>
        <control_type>button</control_type>
        <joint_name>b1p_joint</joint_name>
        <joint_state_topic>/xczs/cabinet/electrical_mezzanine/db1_unlock_button/joint_states</joint_state_topic>
        <pressed_topic>/xczs/cabinet/electrical_mezzanine/db1_unlock_button/pressed</pressed_topic>
        <state_topic>/xczs/cabinet/electrical_mezzanine/db1_unlock_button/state</state_topic>
        <state_ids>released pressed</state_ids>
        <spring_stiffness>800</spring_stiffness>
        <spring_damping>30</spring_damping>
        <press_threshold>0.0035</press_threshold>
        <release_threshold>0.0006</release_threshold>
        <reset_position>0.0</reset_position>
        <graspable>false</graspable>
      </control>
      <control>
        <control_id>ds3</control_id>
        <control_type>slider</control_type>
        <joint_name>ds3</joint_name>
        <joint_state_topic>/xczs/cabinet/electrical_mezzanine/ds3/joint_states</joint_state_topic>
        <pressed_topic>/xczs/cabinet/electrical_mezzanine/ds3/pressed</pressed_topic>
        <state_topic>/xczs/cabinet/electrical_mezzanine/ds3/state</state_topic>
        <state_ids>closed open</state_ids>
        <detents>0.0 0.3</detents>
        <detent_stiffness>12</detent_stiffness>
        <spring_damping>1</spring_damping>
        <detent_hysteresis>0.01</detent_hysteresis>
        <slider_release_position>0.34</slider_release_position>
        <slider_release_reengage_position>0.13</slider_release_reengage_position>
        <motion_tolerance>0.05</motion_tolerance>
        <reset_position>0.0</reset_position>
        <!-- 正面抽拉（grasp 固定关节 + 线性拖拽），grasp_point = s3 前脸中心。 -->
        <graspable>true</graspable>
        <grasp_point>0.069 0.145 0.13</grasp_point>
      </control>
      <control>
        <control_id>dm1</control_id>
        <control_type>slider</control_type>
        <joint_name>dm1</joint_name>
        <joint_state_topic>/xczs/cabinet/electrical_mezzanine/dm1/joint_states</joint_state_topic>
        <pressed_topic>/xczs/cabinet/electrical_mezzanine/dm1/pressed</pressed_topic>
        <state_topic>/xczs/cabinet/electrical_mezzanine/dm1/state</state_topic>
        <state_ids>closed open</state_ids>
        <detents>0.0 0.3</detents>
        <detent_stiffness>12</detent_stiffness>
        <spring_damping>1</spring_damping>
        <detent_hysteresis>0.01</detent_hysteresis>
        <slider_release_position>0.34</slider_release_position>
        <slider_release_reengage_position>0.13</slider_release_reengage_position>
        <motion_tolerance>0.05</motion_tolerance>
        <reset_position>0.0</reset_position>
        <!-- 正面抽拉（grasp 固定关节 + 线性拖拽），grasp_point = m1 前脸中心
             （m 型面板 bbox y∈[0,0.706] z∈[0,0.12]）。 -->
        <graspable>true</graspable>
        <grasp_point>0.069 0.353 0.06</grasp_point>
      </control>
    </plugin>
  </model>
  <!-- b1p_joint：implicit spring damper 开启（006 活验）。弹簧刚度/阻尼由插件
       db1_unlock_button button 控制经 joint SetParam 施加（800 N/m 回位）。 -->
  <gazebo reference="b1p_joint">
    <implicitSpringDamper>true</implicitSpringDamper>
    <provideFeedback>true</provideFeedback>
  </gazebo>
</sdf>
