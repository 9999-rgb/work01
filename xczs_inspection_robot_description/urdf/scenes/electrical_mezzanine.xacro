        <geometry>
          <mesh>
            <uri>model://xczs_inspection_robot_description/meshes/scenes/electrical_mezzanine/b1.STL</uri></mesh>
        </geometry>
        <material>
          <ambient>0.7 0.73 0.78 1</ambient>
          <diffuse>0.7 0.73 0.78 1</diffuse>
        </material>
      </visual>
      <!-- 真实把手 = b1.STL 原生两竖向立筋（2026-09-09 用户目视裁决：删去外加
           横杆/短横杆，把手就是这两条本来就有的竖立筋）。背景订正：b1.STL（SW
           原版导出 20260831，与场景逐字节一致）是 140 个真实表面的封闭抽屉盒
           （非早期注释所记"全扇形退化"）——前脸 x=0.069（= 世界 0.099）处渲染
           两条 16mm 宽 × 96mm 高竖向立筋，L y 0.052..0.068（世界 4.099..4.115，
           中心 4.107）、R y 0.638..0.654（世界 4.685..4.701，中心 4.693）、
           z 0.072..0.168（世界 0.904..1.000，中心 0.952）——中心恰为 grasp 锚点
           b1 局部 (0.069, 0.060/0.646, 0.120) = 世界 (0.099, 4.107/4.693, 0.952)。
           换型史：齐平鳍盒（017b f32d6bd）→ 通长拉杆（017c 133c21c+d8bf814）
           → 纯平背衬（017d 2365fad）→ 两段短横杆（未提交，用户目视否决横杆本身）
           → 本次：把手 = 原生竖立筋，外加几何一律不加。
           碰撞体见下方 fix#25：不再是通长受力墙，而是与 STL 逐点一致的
           两条空心立筋（前板+背板），立筋自带的 53mm 通孔在物理中真实存在。 -->
      <!-- fix#25（2026-09-10 用户裁决「把手后有一大块空隙」取证后重建）：
           旧 handle_bar_backing 是一块 0.680×0.096×0.010 的**通长受力墙**
           （局部 x0.059..0.069、y0.013..0.693、z0.072..0.168），把整个把手带
           连同立筋自带的通孔一起抹成平墙。后果：钩爪在物理里「没有东西可绕」
           —— 侧面(±y)任何 y 位置、x∈[0.089,0.099] 的横向扫入都被这堵墙挡住，
           只能正面顶前脸，正是用户反复否掉的形态。
           b1.STL 射线解算（140 面全解析 + 逐点 raycast）实测真实几何：
            法兰前板 x0.061..0.069（世界 0.091..0.099，8mm 厚）
            背板垫板 x0.000..0.008（世界 0.030..0.038，z0.080..0.160）
            中间空腔 x0.008..0.061（世界 0.038..0.091，53mm 深），
            沿 ±y 打射线穿过立筋中心**一个面都没有** —— 真正的左右通透孔
            （53×80mm），即用户截图里那个洞。
           故拆除通长墙，改为与 STL 逐点一致的两条空心立筋（左右各前板+背板）。
           前脸面仍 x0.069（世界 0.099）＝ grasp/support/unlock 合同面零改动；
           通孔在物理中真实存在，钩爪可自外侧(y<4.099)伸入孔内后内收卡住
           孔内前壁（世界 x0.091 的 -X 向面）再拉开。纯碰撞、无显示。 -->
      <collision name="handle_riser_l">
        <pose>0.004 0.060 0.120 0 0 0</pose>
        <geometry>
          <box>
            <size>0.008 0.016 0.080</size>
          </box>
        </geometry>
      </collision>
      <collision name="handle_riser_r">
        <pose>0.004 0.646 0.120 0 0 0</pose>
        <geometry>
          <box>
            <size>0.008 0.016 0.080</size>
          </box>
        </geometry>
      </collision>
      <collision name="handle_flange_l">
        <pose>0.065 0.060 0.120 0 0 0</pose>
        <geometry>
          <box>
            <size>0.008 0.016 0.096</size>
          </box>
        </geometry>
      </collision>
      <collision name="handle_flange_r">
        <pose>0.065 0.646 0.120 0 0 0</pose>
        <geometry>
          <box>
            <size>0.008 0.016 0.096</size>
          </box>
        </geometry>
      </collision>
      <!-- 外加短横杆已删除（2026-09-09 用户目视裁决）——把手即上方所述两条原生
           竖向立筋，见 link b1.STL visual 前脸立筋与 fix#25 的空心立筋碰撞体。 -->
      <!-- 圆形机构 b1r（固定装饰）并入抽屉本体 b1。指示灯 b1p 已恢复为独立的
           可下压解锁按钮（link b1p / b1p_anchor / b1p_joint，见 b1 link 之后），
           2026-09-09 用户拍板废弃 2026-09-03 §3「固定指示灯」语义。 -->
      <visual name="visual_r">
        <pose>0.03 0.16661 0.12017 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://xczs_inspection_robot_description/meshes/scenes/electrical_mezzanine/b1r.STL</uri></mesh>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.22 1</ambient>
          <diffuse>0.2 0.2 0.22 1</diffuse>
        </material>
      </visual>
      <collision name="collision_r">
        <pose>0.03 0.16661 0.12017 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://xczs_inspection_robot_description/meshes/scenes/electrical_mezzanine/b1r.STL</uri>
          </mesh>
        </geometry>
      </collision>
    </link>

    <!-- b1p：右把手上方红色按钮恢复为「真实可按解锁按钮」（2026-09-09 用户拍板，
         废弃 2026-09-03 AGENT §3「固定指示灯」语义，恢复 2026-09-02 006 可压结构）。
         db1 解锁 = 机器人右侧解锁短杆（r_three_cyl_finger3）从 +X 侧把按钮真按入
         （b1p_joint 位移即物证，plugin 读 Position），simulated_linkage 仿真近似
         撤除。结构沿用 006 双保险：
         ① cap 挂同质量小锚 b1p_anchor（0.05kg，固定焊在抽屉 b1 把手位）——cap:
           parent 惯性比 1:1，避免 80.6kg b1 上 160:1 质量比让 quick solver 解不动
           prismatic（帽曾 ±0.2m 世界振荡）；
         ② 碰撞用 box 代理（13×16×5mm）：b1p.STL bbox 顶缘与前脸线接触会让 ODE
           spawn 产生错误冲量、帽被瞬间打飞 1e9 级联整场（006 实测）；box 整体上移
           1mm（底 z0.169 > riser 顶缘 0.168）静止零接触，mesh 仅作显示。
         世界位（关位 q0）：b1 根 (0.03,4.047,0.83187) + b1 局部 (0.069,0.638,0.168)
         = 世界 (0.099,4.685,0.9999)（前脸面 x0.099 = 按钮外端面，y4.685，z1.000）。
         行程 0..12mm（cap 厚 13mm，压入 12mm 仍不穿）；轴 -X = 朝柜体内压入，q =
         帽相对平齐位的压入深度；0.0035 以上判真按入（见 db1_unlock_button 阈值）。
         b1p 位于 R 竖立筋（z0.072..0.168）顶缘之上、同贴前脸面，无外加横杆。 -->
    <link name="b1p">
      <pose>0.099 4.685 0.9999 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.05</mass>
        <inertia>
          <ixx>1e-5</ixx>
          <iyy>1e-5</iyy>
          <izz>1e-5</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://xczs_inspection_robot_description/meshes/scenes/electrical_mezzanine/b1p.STL</uri></mesh>
        </geometry>
        <material>
          <ambient>0.85 0.04 0.04 1</ambient>
          <diffuse>0.85 0.04 0.04 1</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <pose>-0.0065 0.008 0.0035 0 0 0</pose>
        <geometry>
          <box>
            <size>0.013 0.016 0.005</size>
          </box>
        </geometry>
      </collision>
    </link>
    <!-- b1p_anchor：b1p 的专用承载锚（0.05kg 小球惯性，无视觉/碰撞，纯承载关节），
         固定焊在 b1 把手位，b1p 再以 pose(0,0,0) 的 prismatic 挂锚。
         pose 约定（父体 = 可动抽屉 b1，与 006 活验逐字节一致）：子 link 自身
         <pose> 写「绝对关位」模型系坐标 (0.099,4.685,0.9999) = b1 关位
         (0.03,4.047,0.83187) ⊕ b1 局部 (0.069,0.638,0.168)，令固定关节约束在
         关位与子 link 声明位精确一致、spawn 零弹跳；b1 滑动时锚随关节刚性跟随。
         注意与「631 行夹具约定」的区别：那是子 link 直挂固定 dianqiground 的
         情形（关节 pose 全零、偏移放子 link <pose>）；可动父体情形必须把 b1
         局部偏移放进固定关节 <pose>（见 006/3e8838d，活验），两者不可混用。 -->
    <link name="b1p_anchor">
      <pose>0.099 4.685 0.9999 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.05</mass>
        <inertia>
          <ixx>1e-5</ixx>
          <iyy>1e-5</iyy>
          <izz>1e-5</izz>
        </inertia>
      </inertial>
    </link>
    <joint name="b1p_anchor_joint" type="fixed">
      <!-- 偏移在固定关节 <pose>（b1 局部 0.069,0.638,0.168），非子 link——见上注。 -->
      <pose>0.069 0.638 0.168 0 0 0</pose>
      <parent>b1</parent>
      <child>b1p_anchor</child>
    </joint>
    <joint name="b1p_joint" type="prismatic">
      <pose>0 0 0 0 0 0</pose>
      <parent>b1p_anchor</parent>
      <child>b1p</child>
      <axis>
        <xyz>-1 0 0</xyz>
        <limit>
          <lower>0</lower>
          <upper>0.012</upper>
          <effort>100</effort>
          <velocity>1</velocity>
        </limit>
        <dynamics>
          <!-- 摩擦（ODE fMax，N）必须低于按压阈值处的弹簧回弹力（800 N/m × ~1mm
               = 0.8N），否则松手后帽卡在压入位、pressed 永久为真。0.3N → 复位
               平衡点 0.375mm，帽真实回弹至平齐。弹簧 800 N/m / 阻尼 30 由插件
               db1_unlock_button button 控制施加（006 活验参数），gazebo
               implicitSpringDamper 见文件尾 <gazebo reference="b1p_joint">。 -->
          <damping>0.1</damping>
          <friction>0.3</friction>
        </dynamics>
      </axis>
    </joint>

    <link name="s3">
      <pose>0.03 5.236 1.385 0 0 0</pose>
      <inertial>
        <pose>-0.259058262 0.145066061 0.129850452 0 0 0</pose>
        <mass>29.8437528</mass>
        <inertia>
          <ixx>0.282842434</ixx>
          <ixy>3.17555136e-06</ixy>
          <ixz>3.03662099e-05</ixz>
          <iyy>0.844050169</iyy>
          <iyz>1e-09</iyz>
          <izz>0.879388162</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://xczs_inspection_robot_description/meshes/scenes/electrical_mezzanine/s3.STL</uri></mesh>
        </geometry>
