      </inertial>
      <visual name="visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://xczs_inspection_robot_description/meshes/scenes/electrical_mezzanine/b1.STL</uri></mesh>
        </geometry>
        <material>
          <ambient>0.7 0.73 0.78 1</ambient>
          <diffuse>0.7 0.73 0.78 1</diffuse>
        </material>
      </visual>
      <!-- 2026-09-09 把手几何换型（用户拍板：横向贯通拉杆；017b 灰板已废、下废）。
           背景：b1.STL（SW 原版导出 20260831，与场景逐字节一致）为全扇形退化网格
           ——140 个三角形全部经由六个 ±1m 单元点 + 单位圆幽灵顶点连接，无真实表面。
           两前把手原先只靠两块「齐平前脸 x0.099 的碰撞合同盒」压贴得力（2026-09-04
           P0 §2.1 live 封定：x 0.008..0.069 前缘 0.099 世界、y 0.052..0.068 与
           0.638..0.654、z 0.072..0.168，b1 局部；抓取点即盒面中心）。017b 加仅显示
           灰板后用户指出「平齐板子钩爪没法钩住」。09-09 实测（离线确定性扫掠：STL
           顶点 vs Ø16 圆柱+0.6mm 膨胀，细扫 0.5mm；与活验互证到 1mm）：两钩叉缝
           **不以杆轴为心**——L 缝 v_y 15.4..34.6mm、R 缝 10.3..31.7mm（净 ~19/21mm，
           缝全在杆轴上侧 10-37mm；旧「c-c 40/净缝 28、绕轴心对称」假设被 5 次活验
           撞杆反证）。杆心落 z0.952 时两钩都以叉实体撞杆前弧（探针 L 堵死 x0.1146..
           0.1148 = 扫掠 0.1156）。插件抓握门（grasp_contact_threshold 0.02，3D，锚
           grasp_point z0.952）把钩尖锁在 ~0.952±19mm → aim 下移进叉缝带不可行 →
           拉杆上移 +24mm（杆带 z 0.968..0.984 进两叉缝）——每侧各留真跨杆窗：
           L aim z [0.950,0.952]（现 aim 0.9513 原样罩住）、R aim z [0.953,0.957]。
           换型 = 下两元素：
             a. handle_bar_backing（collision-only 受力墙，兼前脸碰撞）：前缘仍
                x0.099（原合同面——grasp/handle/support/unlock 点值全部零改动，
                插件门语义不变），y 4.060..4.740（两端距侧缝 ~21mm，不挡支撑入缝），
                z 0.904..1.000（覆盖两叉全 z 带 0.926..0.978）——叉指端面压贴得力
                ≥8N 照旧成立；
             b. handle_bar（visual + collision 贯通拉杆）：Ø16 圆杆、轴沿世界 y、
                杆背与背衬前缘齐平（杆背 x0.099、前凸至 x0.115），杆带 z 0.968..
                0.984（心 0.976，上移 24mm 缘起见上）在两叉缝带内、上下余量 ±1..
                2mm（0.5mm 细扫窗）：上叉跨杆顶、下叉穿杆底，拉杆在两叉之间被吞住；
                叉尖仍压贴前脸合同面 x0.099 → ≥8N 力证照旧（grasp/handle/support/
                unlock 点值全部零改动，插件门语义不变）。
           受力墙与拉杆同属 b1 link，无自碰撞；红帽 b1p 底 z1.000 在杆顶 0.984 上方
           ~16mm、解锁指 z1.030 在杆顶上方 ~46mm，均不干涉。
           还原此换型 = 删除下两元素，恢复旧注释所述的碰撞合同盒。 -->
      <collision name="handle_bar_backing">
        <pose>0.064 0.353 0.120 0 0 0</pose>
        <geometry>
          <box>
            <size>0.010 0.680 0.096</size>
          </box>
        </geometry>
      </collision>
      <collision name="handle_bar">
        <pose>0.077 0.353 0.144 1.57079632679 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.008</radius>
            <length>0.680</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="visual_handle_bar">
        <pose>0.077 0.353 0.144 1.57079632679 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.008</radius>
            <length>0.680</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.62 0.64 0.68 1</ambient>
          <diffuse>0.62 0.64 0.68 1</diffuse>
        </material>
      </visual>
      <!-- 圆形机构 b1r 并入抽屉本体 b1；指示灯 b1p 随下方 visual_p/collision_p
           并入 b1（固定装饰，仅显示，与 s2p/s3p 同范式，非按钮、无行程）。 -->
      <visual name="visual_r">
        <pose>0.03 0.16661 0.12017 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://xczs_inspection_robot_description/meshes/scenes/electrical_mezzanine/b1r.STL</uri></mesh>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.22 1</ambient>
          <diffuse>0.2 0.2 0.22 1</diffuse>
        </material>
      </visual>
      <collision name="collision_r">
        <pose>0.03 0.16661 0.12017 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://xczs_inspection_robot_description/meshes/scenes/electrical_mezzanine/b1r.STL</uri>
          </mesh>
        </geometry>
      </collision>
      <!-- 指示灯 b1p：右把手顶部红色指示帽，固定装饰并入 b1 本体（仅显示）。
           2026-09-02 曾拆为可下压解锁按钮 b1p_joint，2026-09-03 AGENT §3 撤销该
           语义——b1p 无行程、不进 operable、不产出解锁物证。世界位姿不变：
           b1 局部 (0.069,0.638,0.168) = 世界 (0.099,4.685,1.000)。 -->
      <visual name="visual_p">
        <pose>0.069 0.638 0.168 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://xczs_inspection_robot_description/meshes/scenes/electrical_mezzanine/b1p.STL</uri></mesh>
        </geometry>
        <material>
          <ambient>0.85 0.04 0.04 1</ambient>
          <diffuse>0.85 0.04 0.04 1</diffuse>
        </material>
      </visual>
      <collision name="collision_p">
        <pose>0.069 0.638 0.168 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://xczs_inspection_robot_description/meshes/scenes/electrical_mezzanine/b1p.STL</uri>
          </mesh>
        </geometry>
      </collision>
    </link>

