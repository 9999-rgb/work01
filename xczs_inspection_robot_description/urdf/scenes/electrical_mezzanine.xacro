      <!-- 圆形机构 b1r（固定装饰）并入抽屉本体 b1。指示灯 b1p 已拆为独立的
           可下压解锁按钮（b1p link + b1p_joint，见下），不再并入本 link。 -->
      <visual name="visual_r">
        <pose>0.03 0.16661 0.12017 0 0 0</pose>
        <geometry>
