          </mesh>
        </geometry>
      </collision>
      <!-- 圆形机构 s1r（固定装饰）与指示灯 s1p（仅显示）原为固定关节子体；
           Gazebo Classic 11 下带偏置的 fixed 关节不焊接（子体在模型原点附近
           散落坠落，见实测），故并入抽屉本体 s1 作为附加 visual/collision。
           外观与相对位置完全不变（同一 STL、同一偏移），物理外观无改动。 -->
      <visual name="visual_r">
        <pose>0.02 0.145 0.16828 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://xczs_inspection_robot_description/meshes/scenes/electrical_mezzanine/s1r.STL</uri></mesh>
