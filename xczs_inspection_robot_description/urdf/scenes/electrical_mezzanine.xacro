    <!-- b1p：右把手上的红色指示帽改为可下压解锁按钮（用户确认，2026-09-02）。
         STL 外观不变；沿抽屉局部 -X（朝柜体内部）滑入 0..3mm，弹簧复位。
         右电缸探针从东侧真实压入其正面触发解锁；plugin 以
         db1_unlock_button button 控制的关节位移作为解锁的物证。 -->
    <link name="b1p">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.02</mass>
        <inertia>
          <ixx>1e-6</ixx>
          <iyy>1e-6</iyy>
          <izz>1e-6</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <pose>0.069 0.638 0.168 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://xczs_inspection_robot_description/meshes/scenes/electrical_mezzanine/b1p.STL</uri></mesh>
        </geometry>
        <material>
          <ambient>0.85 0.04 0.04 1</ambient>
          <diffuse>0.85 0.04 0.04 1</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <pose>0.069 0.638 0.168 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://xczs_inspection_robot_description/meshes/scenes/electrical_mezzanine/b1p.STL</uri>
          </mesh>
        </geometry>
      </collision>
    </link>
    <joint name="b1p_joint" type="prismatic">
      <pose>0 0 0 0 0 0</pose>
      <parent>b1</parent>
      <child>b1p</child>
      <axis>
        <!-- -X = 压入柜体方向；position 0 = 未按压（与右 riser 前缘平齐），
             position 3mm = 被右电缸探针完全压入。 -->
        <xyz>-1 0 0</xyz>
        <limit>
          <lower>0</lower>
          <upper>0.003</upper>
          <effort>100</effort>
          <velocity>1</velocity>
        </limit>
        <dynamics>
          <!-- 摩擦（ODE fMax，单位 N）必须低于按压阈值处的弹簧回弹力
               （800 N/m × 1.2mm = 0.96N），否则松手后帽卡在 ~1.25mm——
               高于 press_threshold，pressed 永久为真，后续解锁只靠接近就
               通过（假解锁复现）。0.3N → 复位平衡点 0.375mm，低于
               release_threshold 0.6mm，帽真实回弹到未按压位。 -->
          <damping>0.1</damping>
          <friction>0.3</friction>
        </dynamics>
      </axis>
    </joint>
    
    
