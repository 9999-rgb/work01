    <link name="b1">
      <pose>0.03 4.047 0.831870606 0 0 0</pose>
      <inertial>
        <pose>-0.262953262 0.353026977 0.119993047 0 0 0</pose>
        <mass>80.6316496</mass>
        <inertia>
          <ixx>3.49966593</ixx>
