    <plugin name="xczs_generator_plant_state" filename="libxczs_cabinet_state.so">
      <ros>
        <namespace>/xczs/cabinet/generator_plant</namespace>
      </ros>
      <state_publish_rate>20.0</state_publish_rate>
      <reset_service>/xczs/cabinet/generator_plant/reset_physics</reset_service>
      <grasp_service>/xczs/cabinet/generator_plant/grasp</grasp_service>
      <grasp_active_topic>/xczs/cabinet/generator_plant/grasp_active</grasp_active_topic>
      <active_control_topic>/xczs/cabinet/generator_plant/active_control</active_control_topic>
      <operation_heartbeat_topic>/xczs/cabinet/generator_plant/operation_heartbeat</operation_heartbeat_topic>
      <operation_fault_topic>/xczs/cabinet/generator_plant/operation_fault</operation_fault_topic>
      <grasp_distance_threshold>0.003</grasp_distance_threshold>
      <!-- 夹爪闭合与实体业务点同时通过后才允许建立旋转耦合。 -->
      <grasp_contact_links>r_rotbtn_jaw1 r_rotbtn_jaw2</grasp_contact_links>
      <grasp_joint><name>r_rotbtn_rotate_joint</name><position>0</position><tolerance>0.01</tolerance></grasp_joint>
      <grasp_joint><name>r_rotbtn_jaw1_joint</name><position>0.003</position><tolerance>0.0032</tolerance></grasp_joint>
      <grasp_joint><name>r_rotbtn_jaw2_joint</name><position>0.003</position><tolerance>0.0032</tolerance></grasp_joint>
      <operation_watchdog_timeout>2.0</operation_watchdog_timeout>
      <control>
        <control_id>frb</control_id>
        <control_type>switch</control_type>
        <joint_name>frb</joint_name>
        <joint_state_topic>/xczs/cabinet/generator_plant/frb/joint_states</joint_state_topic>
        <pressed_topic>/xczs/cabinet/generator_plant/frb/pressed</pressed_topic>
        <state_topic>/xczs/cabinet/generator_plant/frb/state</state_topic>
        <continuous_rotation>true</continuous_rotation>
        <state_ids>stopped running</state_ids>
        <detents>0 1</detents>
        <detent_stiffness>0</detent_stiffness>
        <!-- 转动惯量为 1e-5；避免显式阻尼在 2 ms 物理步长下发散。 -->
        <spring_damping>0.0001</spring_damping>
        <grasp_stiffness>0</grasp_stiffness>
        <grasp_damping>0</grasp_damping>
        <grasp_coupling_stiffness>0.1</grasp_coupling_stiffness>
        <grasp_coupling_damping>0.001</grasp_coupling_damping>
        <grasp_coupling_max_effort>0.01</grasp_coupling_max_effort>
        <motion_tolerance>0.05</motion_tolerance>
        <reset_position>0</reset_position>
        <graspable>true</graspable>
        <!-- 插入确认后由单轴柔性力矩传动，避免与运动学转子的网格接触重复约束。 -->
        <actuation_collision>rotatebutton::collision</actuation_collision>
        <actuation_collision_restore_delay>0.2</actuation_collision_restore_delay>
        <actuation_collision_restore_distance>0.05</actuation_collision_restore_distance>
        <grasp_point>0 -0.001 0</grasp_point>
      </control>
      <control>
        <control_id>fbutton1</control_id>
        <control_type>button</control_type>
        <joint_name>fbutton1</joint_name>
        <joint_state_topic>/xczs/cabinet/generator_plant/fbutton1/joint_states</joint_state_topic>
        <pressed_topic>/xczs/cabinet/generator_plant/fbutton1/pressed</pressed_topic>
        <state_topic>/xczs/cabinet/generator_plant/fbutton1/state</state_topic>
        <state_ids>released pressed</state_ids>
        <spring_stiffness>800</spring_stiffness>
        <spring_damping>8</spring_damping>
        <press_threshold>0.003</press_threshold>
        <release_threshold>0.001</release_threshold>
        <reset_position>0</reset_position>
        <graspable>false</graspable>
      </control>
      <control>
        <control_id>fbutton2</control_id>
        <control_type>button</control_type>
        <joint_name>fbutton2</joint_name>
        <joint_state_topic>/xczs/cabinet/generator_plant/fbutton2/joint_states</joint_state_topic>
        <pressed_topic>/xczs/cabinet/generator_plant/fbutton2/pressed</pressed_topic>
