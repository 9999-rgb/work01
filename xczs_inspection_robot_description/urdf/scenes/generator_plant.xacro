      <control>
        <control_id>fr135_knob</control_id>
        <grasp_contact_target>r1351</grasp_contact_target>
        <control_type>knob</control_type>
        <joint_name>fr135</joint_name>
        <joint_state_topic>/xczs/cabinet/generator_plant/fr135_knob/joint_states</joint_state_topic>
        <pressed_topic>/xczs/cabinet/generator_plant/fr135_knob/pressed</pressed_topic>
        <state_topic>/xczs/cabinet/generator_plant/fr135_knob/state</state_topic>
        <state_ids>center turned</state_ids>
        <detents>0.0 0.7853981633974483</detents>
        <detent_stiffness>0.6</detent_stiffness>
        <spring_damping>0.005</spring_damping>
        <grasp_stiffness>0</grasp_stiffness>
        <grasp_damping>0</grasp_damping>
        <!-- 夹持方板后通过有界力矩跟随，不直接写旋钮位置。
             旋钮总转动惯量约 2e-5 kg m²，仿真步长 2 ms；过大的显式
             弹簧/阻尼会产生数值振荡。采用 5 Nm/rad、0.005 Nms/rad，
             配合 0.02 Nm 轴摩擦，静态滞后约 0.004 rad。
             旋转期间校验双侧接触；压入超过 1 mm 持续 10 ms 或瞬时超过 2 mm 则停止。 -->
        <grasp_coupling_stiffness>5</grasp_coupling_stiffness>
        <grasp_coupling_damping>0.005</grasp_coupling_damping>
        <grasp_coupling_max_effort>0.2</grasp_coupling_max_effort>
        <!-- 旋钮物理静止位由重力+干摩擦决定（死区约 0.056 rad，fr135 因按钮
             偏心质心偏到 0.0558）。motion_tolerance 放宽到 0.08：既认可旋钮
             的天然落位（in_motion 不再误报），又不影响 0/45° 两档判定。
             按钮仍用 press/release_threshold，与此无关。 -->
        <motion_tolerance>0.08</motion_tolerance>
        <reset_position>0.0</reset_position>
        <graspable>true</graspable>
        <grasp_point>0 0.004 0</grasp_point>
      </control>
