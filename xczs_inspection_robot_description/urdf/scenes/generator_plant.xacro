          <izz>1e-05</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://xczs_inspection_robot_description/meshes/scenes/generator_plant/rotatebutton.STL</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://xczs_inspection_robot_description/meshes/scenes/generator_plant/rotatebutton.STL</uri>
          </mesh>
        </geometry>
        <!-- 配合网格有约 0.05 mm 离散误差，限制微小接触的纠正速度。 -->
        <surface>
          <contact><ode><kp>100000</kp><kd>10</kd><max_vel>0.01</max_vel><min_depth>0.0001</min_depth></ode></contact>
        </surface>
      </collision>
    </link>
    <joint name="frb" type="revolute">
      <pose>0 0 0 0 0 0</pose>
      <!-- 固定柜体的插口直接锚定世界，避免超大父质量导致接触求解发散。 -->
      <parent>world</parent>
      <child>rotatebutton</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e+12</lower>
          <upper>1e+12</upper>
          <effort>100</effort>
          <velocity>1</velocity>
