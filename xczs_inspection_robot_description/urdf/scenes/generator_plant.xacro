        </geometry>
        <!-- 发电机层着色约定（2026-09-14 用户要求「能操控的东西上颜色」）——
             只改 <material>，几何/惯性/碰撞一律不动。
             可视主体是六块 34.6mm 方板（r*51，操控对象），每块一色便于逐一指认：
               fr135_button   r1351  红   0.85 0.05 0.05
               fr2222_button  r2221  橙   1.00 0.45 0.05
               fr4332_button  r4331  黄   0.95 0.85 0.10
               fr12452_button r12451 绿   0.10 0.70 0.20
               fr20422_button r20421 青   0.10 0.72 0.92
               fr25452_button r25451 紫   0.55 0.25 0.85
             原先无意义的红/绿交替已废止。小圆柱（r*52，Ø5mm 旋钮轴）在正常视距下
             不可见，维持近黑不动，唯一例外见 r1352 的注释。 -->
        <material>
          <ambient>0.85 0.05 0.05 1</ambient>
          <diffuse>0.85 0.05 0.05 1</diffuse>
        </material>
      </visual>
            <collision name="collision">
        <!-- ODE 本 Gazebo 中 trimesh-vs-trimesh 碰撞整体失效（指尖/夹具同为
             mesh，按压无接触力 → CONTACT_DETECTION_TIMEOUT）。按钮板改用等尺寸
             box 代理（34.6×34.6×8mm，局部 y∈[-0.007,0.001] 与 r1351.STL 一致，
             南面 y=-0.007 即世界 4.8113 受压面），mesh(指尖)-vs-box 可靠。外观 mesh 不变。 -->
        <pose>0 -0.003 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.0346 0.008 0.0346</size>
          </box>
        </geometry>
      </collision>
