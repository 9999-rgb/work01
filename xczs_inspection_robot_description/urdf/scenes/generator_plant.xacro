      <!-- 2026-09-15 用户裁决：去掉旋钮轴的 visual —— 他要的是「末端直接旋转整个
           旋钮（这块方板）」，而不是让中间那根 Ø5mm 小圆柱露出来。
           注意：r1352 这个 link 及其 <collision> **保留**（不渲染），
              · 方板 r1351 是它的 prismatic 子件，所以轴一转、整块方板跟着转 —— 正是
                「旋转整个旋钮」；视觉上已无小圆柱。
              · collision 保留 = 工具夹持面（北侧作业靠它凸出才咬得住，见 collision 注释）。
           若连 collision 一起删，软件耦合仍在，但物理夹持面消失、北侧实测需重验。 -->

      <collision name="collision">
        <!-- 与上面的 visual 同步：平移 +4mm、Y 缩放 1.6（见该 link 的注释）。 -->
        <pose>0 0.004 0 0 0 0</pose>
        <geometry>
          <mesh>
