    <joint name="fr135" type="revolute">
      <pose>0 0 0 0 0 0</pose>
      <parent>fadianground</parent>
      <child>r1352</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>0</lower>
          <upper>0.8</upper>
          <effort>100</effort>
          <velocity>1</velocity>
        </limit>
