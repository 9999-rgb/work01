        <state_topic>/xczs/cabinet/generator_plant/fr25452_knob/state</state_topic>
        <state_ids>left center right</state_ids>
        <detents>0.0 0.4 0.8</detents>
        <detent_stiffness>0.6</detent_stiffness>
        <spring_damping>0.005</spring_damping>
        <grasp_stiffness>0</grasp_stiffness>
        <grasp_damping>0</grasp_damping>
        <grasp_coupling_stiffness>5</grasp_coupling_stiffness>
        <grasp_coupling_damping>0.005</grasp_coupling_damping>
        <grasp_coupling_max_effort>0.2</grasp_coupling_max_effort>
        <!-- 旋钮物理静止位由重力+干摩擦决定（死区约 0.056 rad，fr135 因按钮
             偏心质心偏到 0.0558）。motion_tolerance 放宽到 0.08：既认可旋钮
             的天然落位（in_motion 不再误报），又不影响 0/0.4/0.8 三档判定。
             按钮仍用 press/release_threshold，与此无关。 -->
        <motion_tolerance>0.08</motion_tolerance>
        <reset_position>0.0</reset_position>
        <graspable>true</graspable>
        <grasp_point>0 0.004 0</grasp_point>
      </control>
    </plugin>
  </model>
