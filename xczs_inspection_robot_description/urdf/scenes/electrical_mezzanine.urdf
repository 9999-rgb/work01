<?xml version="1.0"?>
<!-- 电气夹层静态场景（由 SolidWorks 导出，SW2URDF v1.5.1）。
     单 link 静态网格；去掉了导出的大质量 <inertial>（静态模型无需惯性）。
     网格沿用原 link 名 dianqi_ground。 -->
<robot name="electrical_mezzanine">
  <link name="dianqi_ground">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh
          filename="package://xczs_inspection_robot_description/meshes/scenes/electrical_mezzanine/dianqi_ground.STL"/>
      </geometry>
      <material name="scene_grey">
        <color rgba="0.698039215686274 0.698039215686274 0.698039215686274 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh
          filename="package://xczs_inspection_robot_description/meshes/scenes/electrical_mezzanine/dianqi_ground.STL"/>
      </geometry>
    </collision>
  </link>
  <gazebo>
    <static>true</static>
  </gazebo>
</robot>
