<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <material name="industrial_navy">
    <color rgba="0.035 0.145 0.255 1" />
  </material>
  <material name="safety_orange">
    <color rgba="1.0 0.36 0.04 1" />
  </material>
  <material name="graphite_black">
    <color rgba="0.12 0.14 0.17 1" />
  </material>
  <material name="rubber_black">
    <color rgba="0.025 0.025 0.03 1" />
  </material>
  <!--
    The four end-effector tools were exported from SolidWorks with a white
    appearance (rgba 1 1 1 1).  Restored so the tools read as the user's
    original mechanism instead of an uncoloured dark blob against the wrist.
  -->
  <material name="solidworks_white">
    <color rgba="1 1 1 1" />
  </material>
</robot>
