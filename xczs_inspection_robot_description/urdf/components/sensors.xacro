<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Arm-mounted RGB camera parameters. -->
  <xacro:property name="arm_camera_update_rate" value="30.0" />
  <xacro:property name="arm_camera_horizontal_fov" value="1.3962634" />
  <xacro:property name="arm_camera_image_width" value="800" />
  <xacro:property name="arm_camera_image_height" value="800" />
  <xacro:property name="arm_camera_near_clip" value="0.02" />
  <xacro:property name="arm_camera_far_clip" value="300.0" />

  <!-- Body-mounted planar lidar parameters. -->
  <xacro:property name="body_lidar_update_rate" value="40.0" />
  <xacro:property name="body_lidar_samples" value="720" />
  <xacro:property name="body_lidar_min_angle" value="-1.57079632679" />
  <xacro:property name="body_lidar_max_angle" value="1.57079632679" />
  <xacro:property name="body_lidar_min_range" value="0.10" />
  <xacro:property name="body_lidar_max_range" value="30.0" />
  <xacro:property name="body_lidar_range_resolution" value="0.01" />

  <xacro:macro name="xczs_arm_camera" params="">
    <link name="arm_camera_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="0.05" />
        <inertia
          ixx="1.1771e-05"
          ixy="0"
          ixz="0"
          iyy="1.5521e-05"
          iyz="0"
          izz="1.7083e-05" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <box size="0.050 0.040 0.035" />
        </geometry>
        <material name="graphite_black" />
      </visual>
      <visual>
        <origin xyz="0.031 0 0" rpy="0 1.57079632679 0" />
        <geometry>
          <cylinder radius="0.012" length="0.012" />
        </geometry>
        <material name="graphite_black" />
      </visual>
    </link>
    <joint name="wrist_camera_mount" type="fixed">
      <!--
        Mount the camera on the upper side of the wrist. Its positive X axis
        points along the tool's negative Z axis, while the diagonal offset
        keeps the gripper near the edge of the optical path.
      -->
      <origin
        xyz="0.065 -0.105 -0.190"
        rpy="0 1.57079632679 0" />
      <parent link="end" />
      <child link="arm_camera_link" />
    </joint>
    <gazebo reference="wrist_camera_mount">
      <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>

    <link name="arm_camera_optical_frame" />
    <joint name="arm_camera_optical_joint" type="fixed">
      <origin
        xyz="0.040 0 0"
        rpy="-1.57079632679 0 -1.57079632679" />
      <parent link="arm_camera_link" />
      <child link="arm_camera_optical_frame" />
    </joint>

    <gazebo reference="arm_camera_link">
      <material>Gazebo/Black</material>
      <gravity>false</gravity>
      <sensor name="arm_camera" type="camera">
        <pose>0.040 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>${arm_camera_update_rate}</update_rate>
        <visualize>false</visualize>
        <camera name="arm_camera">
          <horizontal_fov>${arm_camera_horizontal_fov}</horizontal_fov>
          <image>
            <width>${arm_camera_image_width}</width>
            <height>${arm_camera_image_height}</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>${arm_camera_near_clip}</near>
            <far>${arm_camera_far_clip}</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
        <plugin
          name="xczs_arm_camera_plugin"
          filename="libgazebo_ros_camera.so">
          <ros>
            <namespace>/xczs/camera</namespace>
            <remapping>image_raw:=image_raw</remapping>
            <remapping>camera_info:=camera_info</remapping>
          </ros>
          <camera_name>arm_camera</camera_name>
          <frame_name>arm_camera_optical_frame</frame_name>
          <hack_baseline>0.0</hack_baseline>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="xczs_body_lidar" params="">
    <link name="body_lidar_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="0.10" />
        <inertia
          ixx="8.0625e-05"
          ixy="0"
          ixz="0"
          iyy="8.0625e-05"
          iyz="0"
          izz="1.0125e-04" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <cylinder radius="0.045" length="0.060" />
        </geometry>
        <material name="graphite_black" />
      </visual>
    </link>
    <joint name="body_lidar_mount" type="fixed">
      <origin xyz="0 -0.230 0.280" rpy="0 0 0" />
      <parent link="body" />
      <child link="body_lidar_link" />
    </joint>
    <gazebo reference="body_lidar_mount">
      <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>

    <gazebo reference="body_lidar_link">
      <material>Gazebo/Black</material>
      <gravity>false</gravity>
      <sensor name="body_lidar" type="ray">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>${body_lidar_update_rate}</update_rate>
        <visualize>false</visualize>
        <ray>
          <scan>
            <horizontal>
              <samples>${body_lidar_samples}</samples>
              <resolution>1.0</resolution>
              <min_angle>${body_lidar_min_angle}</min_angle>
              <max_angle>${body_lidar_max_angle}</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>${body_lidar_min_range}</min>
            <max>${body_lidar_max_range}</max>
            <resolution>${body_lidar_range_resolution}</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>
        <plugin
          name="xczs_body_lidar_plugin"
          filename="libgazebo_ros_ray_sensor.so">
          <ros>
            <namespace>/xczs/lidar</namespace>
            <remapping>~/out:=scan</remapping>
          </ros>
          <output_type>sensor_msgs/LaserScan</output_type>
          <frame_name>body_lidar_link</frame_name>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="xczs_sensors" params="">
    <xacro:xczs_arm_camera />
    <xacro:xczs_body_lidar />
  </xacro:macro>
</robot>
