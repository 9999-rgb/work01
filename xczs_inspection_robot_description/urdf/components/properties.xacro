<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Centralized wheel and contact parameters for Gazebo tuning. -->
  <xacro:property name="wheel_joint_effort" value="100" />
  <xacro:property name="wheel_joint_velocity" value="20" />
  <xacro:property name="wheel_joint_damping" value="0.1" />
  <xacro:property name="wheel_joint_friction" value="0.0" />
  <!--
    gazebo_ros_planar_move is the source of planar X/Y/yaw motion.  Keep the
    wheel collisions for vertical support.  A small isotropic coefficient
    damps manipulator reaction motion without fighting commanded holonomic
    translation or in-place rotation like the exported rubber value did.
  -->
  <xacro:property name="planar_wheel_surface_friction" value="0.10" />
  <xacro:property name="contact_kp" value="1000000" />
  <xacro:property name="contact_kd" value="100" />
  <xacro:property name="contact_max_velocity" value="0.2" />
  <xacro:property name="contact_min_depth" value="0.001" />
  <!--
    Keep the kinematic planar mover aligned with every 500 Hz physics step.
    A slower mover update lets wheel contacts introduce lateral drift during
    an in-place turn; the separate publish_rate still limits odometry to 20 Hz.
  -->
  <xacro:property name="planar_move_update_rate" value="500" />
</robot>
