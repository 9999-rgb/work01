<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Centralized wheel and contact parameters for Gazebo tuning. -->
  <xacro:property name="wheel_joint_effort" value="100" />
  <xacro:property name="wheel_joint_velocity" value="20" />
  <xacro:property name="wheel_joint_damping" value="0.1" />
  <xacro:property name="wheel_joint_friction" value="0.0" />
  <xacro:property name="front_wheel_collision_radius" value="0.050" />
  <xacro:property name="front_wheel_collision_length" value="0.0496" />
  <xacro:property name="back_wheel_collision_radius" value="0.090" />
  <xacro:property name="back_wheel_collision_length" value="0.184" />
  <!--
    Stable convex base collisions instead of the exported triangle mesh.
    The lower front volume follows the lidar deck height so the sensor mounted
    above that deck does not detect the robot's own collision geometry.
  -->
  <xacro:property
    name="base_rear_collision_origin"
    value="0 -0.205 -0.105" />
  <xacro:property
    name="base_rear_collision_size"
    value="0.680 0.620 0.700" />
  <xacro:property
    name="base_front_collision_origin"
    value="0 0.240 -0.3075" />
  <xacro:property
    name="base_front_collision_size"
    value="0.680 0.270 0.295" />
  <xacro:property name="contact_kp" value="1000000" />
  <xacro:property name="contact_kd" value="100" />
  <xacro:property name="contact_max_velocity" value="0.2" />
  <xacro:property name="contact_min_depth" value="0.001" />
  <!-- Zero means that planar constraints are applied every physics update. -->
  <xacro:property name="planar_move_update_rate" value="0" />
  <!-- Programmatic vertical carriage used to cover the full 2.2 m cabinet. -->
  <xacro:property name="arm_lift_travel" value="0.85" />
  <xacro:property name="arm_lift_velocity" value="0.25" />
  <xacro:property name="arm_lift_effort" value="500" />
  <!-- Fixed mast extends above the carriage at maximum lift. -->
  <xacro:property
    name="arm_lift_mast_height"
    value="${arm_lift_travel + 0.30}" />
  <xacro:property
    name="arm_lift_mast_center_z"
    value="${arm_lift_mast_height / 2.0}" />
</robot>
