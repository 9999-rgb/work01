<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro
    name="xczs_position_controlled_joint"
    params="joint_name initial_value:=0.0">
    <joint name="${joint_name}">
      <command_interface name="position" />
      <state_interface name="position">
        <param name="initial_value">${initial_value}</param>
      </state_interface>
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
  </xacro:macro>

  <xacro:macro
    name="xczs_effort_controlled_joint"
    params="joint_name initial_value:=0.0">
    <joint name="${joint_name}">
      <command_interface name="effort" />
      <state_interface name="position">
        <param name="initial_value">${initial_value}</param>
      </state_interface>
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
  </xacro:macro>

  <xacro:macro name="xczs_state_only_joint" params="joint_name">
    <joint name="${joint_name}">
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
  </xacro:macro>

  <xacro:macro name="xczs_ros2_control" params="initial_positions_file">
    <!--
      GazeboSystem applies these state-interface initial values directly to
      both the Gazebo joints and its position-command buffers while the model
      plugin is loading.  The robot therefore enters the world in this pose;
      no post-spawn trajectory or transient zero-pose command is required.
    -->
    <xacro:property
      name="initial_positions"
      value="${xacro.load_yaml(initial_positions_file)['initial_positions']}" />
    <ros2_control name="XCZSGazeboSystem" type="system">
      <hardware>
        <plugin>gazebo_ros2_control/GazeboSystem</plugin>
      </hardware>

      <!-- Left arm - 7-DOF revolute chain. -->
      <xacro:xczs_position_controlled_joint joint_name="l_arm_0_joint" initial_value="${initial_positions['l_arm_0_joint']}" />
      <xacro:xczs_position_controlled_joint joint_name="l_arm_1_joint" initial_value="${initial_positions['l_arm_1_joint']}" />
      <xacro:xczs_position_controlled_joint joint_name="l_arm_2_joint" initial_value="${initial_positions['l_arm_2_joint']}" />
      <xacro:xczs_position_controlled_joint joint_name="l_arm_3_joint" initial_value="${initial_positions['l_arm_3_joint']}" />
      <xacro:xczs_position_controlled_joint joint_name="l_arm_4_joint" initial_value="${initial_positions['l_arm_4_joint']}" />
      <xacro:xczs_position_controlled_joint joint_name="l_arm_5_joint" initial_value="${initial_positions['l_arm_5_joint']}" />
      <xacro:xczs_position_controlled_joint joint_name="l_arm_6_joint" initial_value="${initial_positions['l_arm_6_joint']}" />

      <!-- Right arm - 7-DOF revolute chain. -->
      <xacro:xczs_position_controlled_joint joint_name="r_arm_0_joint" initial_value="${initial_positions['r_arm_0_joint']}" />
      <xacro:xczs_position_controlled_joint joint_name="r_arm_1_joint" initial_value="${initial_positions['r_arm_1_joint']}" />
      <xacro:xczs_position_controlled_joint joint_name="r_arm_2_joint" initial_value="${initial_positions['r_arm_2_joint']}" />
      <xacro:xczs_position_controlled_joint joint_name="r_arm_3_joint" initial_value="${initial_positions['r_arm_3_joint']}" />
      <xacro:xczs_position_controlled_joint joint_name="r_arm_4_joint" initial_value="${initial_positions['r_arm_4_joint']}" />
      <xacro:xczs_position_controlled_joint joint_name="r_arm_5_joint" initial_value="${initial_positions['r_arm_5_joint']}" />
      <xacro:xczs_position_controlled_joint joint_name="r_arm_6_joint" initial_value="${initial_positions['r_arm_6_joint']}" />

      <!-- Tool joints are declared only for the mounted toolset (A/B), so
           controller_manager never builds controllers for tool joints that
           are absent from the URDF. Set A is three-cylinder(右) + two-cylinder(左);
           Set B is rotate-button(右) + rocker(左). -->
      <xacro:if value="${'$(arg toolset)'.upper() == 'A'}">
        <!-- 2026-09-11 改为 position 命令接口（原为 effort/PID）。
             原方案是为了躲开 Gazebo Classic ODE 在 prismatic SetPosition 下
             每个物理步刷一条 Anchor 警告的日志洪水；但 effort 接口有个致命
             副作用：JointTrajectoryController 在轨迹结束后**不再写新命令**，
             最后那个 effort 值一直挂着 —— 杆等于处在恒定力下、没有任何位置
             伺服，机械臂一运动就把杆带走（实测前伸 20mm 漂 7~12mm、内收 40mm
             漂 50mm，累计后杆被顶到限位外并锁死，双向都驱不动）。
             臂关节本来就用 position 接口、从不漂，所以五根杆统一改成 position，
             与臂同路径；Anchor 日志另行在启动侧抑制。 -->
        <xacro:xczs_position_controlled_joint joint_name="r_three_cyl_finger1_joint" />
        <xacro:xczs_position_controlled_joint joint_name="r_three_cyl_finger2_joint" />
        <xacro:xczs_position_controlled_joint joint_name="r_three_cyl_finger3_joint" />
        <xacro:xczs_position_controlled_joint joint_name="l_two_cyl_finger1_joint" />
        <xacro:xczs_position_controlled_joint joint_name="l_two_cyl_finger2_joint" />
      </xacro:if>
      <xacro:if value="${'$(arg toolset)'.upper() == 'B'}">
        <!-- 同 Set A：统一走 position，避免 effort 接口"轨迹结束即失去位置
             伺服"导致的杆位漂移；旋转关节本来就是 revolute，position 控制
             与臂一致。 -->
        <xacro:xczs_position_controlled_joint joint_name="r_rotbtn_rotate_joint" />
        <xacro:xczs_position_controlled_joint joint_name="r_rotbtn_jaw1_joint" />
        <xacro:xczs_position_controlled_joint joint_name="r_rotbtn_jaw2_joint" />
        <xacro:xczs_position_controlled_joint joint_name="l_rocker_rotor_joint" />
      </xacro:if>

      <!-- The planar Gazebo plugin moves the base. ros2_control only exposes
           wheel state so robot_state_publisher keeps the complete TF tree. -->
      <xacro:xczs_state_only_joint joint_name="l_wheel_0_joint" />
      <xacro:xczs_state_only_joint joint_name="l_wheel_1_joint" />
      <xacro:xczs_state_only_joint joint_name="r_wheel_0_joint" />
      <xacro:xczs_state_only_joint joint_name="r_wheel_1_joint" />
    </ros2_control>

    <gazebo>
      <plugin
        name="xczs_ros2_control_$(arg gazebo_plugin_instance_id)"
        filename="libgazebo_ros2_control.so">
        <robot_param>robot_description</robot_param>
        <robot_param_node>/robot_state_publisher</robot_param_node>
        <parameters>
          $(find xczs_inspection_robot_description)/config/ros2_controllers_toolset_${'$(arg toolset)'.upper()}.yaml
        </parameters>
        <hold_joints>true</hold_joints>
        <ros>
          <namespace>/xczs</namespace>
        </ros>
      </plugin>
    </gazebo>
  </xacro:macro>
</robot>
