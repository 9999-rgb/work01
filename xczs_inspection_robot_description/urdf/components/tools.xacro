<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
    End-effector tools for the dual-arm robot, converted verbatim from the
    SolidWorks URDF exports in model/urdf20260817/.  Link and joint names are
    prefixed with the owning arm (l_ / r_) so the four tools, which share the
    generic SolidWorks names endbody/endlink, remain globally unique inside
    one robot_description.

    Tool -> arm -> cabinet-control mapping
      three_cylinder (right) - extend a cylinder to press a cabinet button
      two_cylinder    (left)  - extend two cylinders to grasp + pull a drawer
      rocker          (left)  - rock the rotor to toggle a switch
      rotate_button   (right) - clamp a round knob while the wrist rotates it

    The mounting transforms below are a BEST-EFFORT estimate - the exact pose of
    each tool base on the l_arm_6 / r_arm_6 flange is not exported by SolidWorks
    and must be confirmed/tuned in Gazebo.  Each pose is a single property so
    tuning is a one-line change.  A passive carrier plate spans both mount
    origins on each wrist; without that plate the +/-0.20 m origins leave the
    four otherwise-fixed tools visibly floating beside the wrist.

    The operator publishes every contact-link pose with +Z outward and applies
    the calibrated business-point offset along link -Z.  All four fixed mounts
    therefore retain the established R_y(pi) transform.  The +/-X offsets put
    the two tools side-by-side on the rigid carrier rather than inline along
    the approach direction.
  -->

  <!--
    Per-tool mount orientation and carrier offsets (xyz).

    R_y(pi) keeps the operator's business-point direction toward the cabinet.
    The xyz offsets are tuned so the tool BODIES clear the forearm
    links (arm_4/arm_5) at the all-zero home pose: the right/left cylinder
    tools are lifted ABOVE the wrist (+X flange, world +Z) while the
    rotate-button / rocker tools hang BELOW it (-X flange).  Without this the
    tool bodies overlap the forearms by 2-16 mm at all-zero, which makes the
    MoveIt start state invalid and blocks every control plan.
  -->
  <!-- R_y(pi) preserves the operator coordinate contract shared by all four
       tools: contact-link +Z is outward and the calibrated business-point
       offset runs along link -Z toward the cabinet.  Tool/forearm clearance
       is a transport-pose constraint and must not be hidden by flipping a
       tool away from its physical working direction. -->
  <xacro:property name="three_cyl_mount_rpy" value="0 3.14159265359 0" />
  <xacro:property name="two_cyl_mount_rpy" value="0 3.14159265359 0" />
  <xacro:property name="rocker_mount_rpy" value="0 3.14159265359 0" />
  <xacro:property name="rotate_button_mount_rpy" value="0 3.14159265359 0" />
  <xacro:property name="three_cyl_mount_xyz" value="0.20 0 0.00" />
  <xacro:property name="rotate_button_mount_xyz" value="-0.20 0 0.00" />
  <xacro:property name="two_cyl_mount_xyz" value="0.20 0 0.00" />
  <xacro:property name="rocker_mount_xyz" value="-0.20 0 0.00" />

  <!--
    Rigid dual-tool carrier.  The 0.48 m span covers both +/-0.20 m tool
    centres plus their 33.5 mm SolidWorks flange radius.  The 80 mm visual
    width covers the complete flange diameter; each 68 mm collision wing
    covers the exported 67 mm flange and the 30 mm plate thickness overlaps
    its shoulder.  Its centre is embedded in the arm_6 wrist shell, so the
    union of wrist and carrier geometry is continuous to both tool bases.
    This is a fixed structural mount, not an actuator or an additional robot
    degree of freedom.
  -->
  <xacro:macro name="xczs_tool_carrier" params="prefix parent">
    <joint name="${prefix}_tool_carrier_mount" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <parent link="${parent}" />
      <child link="${prefix}_tool_carrier" />
    </joint>
    <gazebo reference="${prefix}_tool_carrier_mount">
      <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>

    <link name="${prefix}_tool_carrier">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="0.35" />
        <inertia
          ixx="0.000212"
          ixy="0"
          ixz="0"
          iyy="0.006746"
          iyz="0"
          izz="0.006907" />
      </inertial>
      <visual name="${prefix}_tool_carrier_visual">
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <box size="0.48 0.08 0.03" />
        </geometry>
        <material name="graphite_black" />
      </visual>
      <!-- arm_6 already supplies the physical centre of the plate.  Splitting
           the carrier collision into two wings avoids duplicating that solid
           wrist volume (which otherwise falsely collides with adjacent
           arm_5), while both wings overlap the measured arm_6 X envelope. -->
      <collision name="${prefix}_tool_carrier_positive_collision">
        <origin xyz="0.1575 0 0" rpy="0 0 0" />
        <geometry>
          <box size="0.165 0.068 0.03" />
        </geometry>
      </collision>
      <collision name="${prefix}_tool_carrier_negative_collision">
        <origin xyz="-0.1475 0 0" rpy="0 0 0" />
        <geometry>
          <box size="0.185 0.068 0.03" />
        </geometry>
      </collision>
    </link>
  </xacro:macro>

  <!--
    Three electric cylinders (right hand).  Three prismatic fingers; finger3 is
    a second, shorter stage stacked on finger2, so it is a serial child joint.
  -->
  <xacro:macro name="xczs_three_cylinder" params="prefix parent">
    <joint name="${prefix}_three_cyl_mount" type="fixed">
      <origin xyz="${three_cyl_mount_xyz}" rpy="${three_cyl_mount_rpy}" />
      <parent link="${parent}" />
      <child link="${prefix}_three_cyl_base" />
    </joint>
    <!-- Preserve the fixed base link through URDF->SDF conversion.  It is the
         MoveIt end-effector / Gazebo grasp link (contact_tool_link) and must
         stay addressable by name instead of being lumped into the wrist. -->
    <gazebo reference="${prefix}_three_cyl_mount">
      <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>

    <link name="${prefix}_three_cyl_base">
      <inertial>
        <origin xyz="-2.749E-05 -0.047586 -0.15922" rpy="0 0 0" />
        <mass value="1.8714" />
        <inertia
          ixx="0.0031433"
          ixy="-4.2863E-06"
          ixz="1.1463E-07"
          iyy="0.0028455"
          iyz="-2.1303E-06"
          izz="0.0012283" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://xczs_inspection_robot_description/meshes/tools/three_cylinder/endbody3.STL" />
        </geometry>
        <material name="graphite_black" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://xczs_inspection_robot_description/meshes/tools/three_cylinder/endbody3.STL" />
        </geometry>
      </collision>
    </link>

    <link name="${prefix}_three_cyl_finger1">
      <inertial>
        <origin xyz="-0.0005181 2.0477E-10 0.0022188" rpy="0 0 0" />
        <mass value="0.11476" />
        <inertia
          ixx="7.3931E-05"
          ixy="-1.1531E-10"
          ixz="-8.0168E-07"
          iyy="7.3625E-05"
          iyz="1.171E-12"
          izz="1.3185E-05" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://xczs_inspection_robot_description/meshes/tools/three_cylinder/endllink1.STL" />
        </geometry>
        <material name="graphite_black" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://xczs_inspection_robot_description/meshes/tools/three_cylinder/endllink1.STL" />
        </geometry>
      </collision>
    </link>
    <joint name="${prefix}_three_cyl_finger1_joint" type="prismatic">
      <origin xyz="0.034 -0.061735 -0.2985" rpy="0 0 0" />
      <parent link="${prefix}_three_cyl_base" />
      <child link="${prefix}_three_cyl_finger1" />
      <axis xyz="0 0 -1" />
      <limit lower="0" upper="0.12" effort="100" velocity="1" />
      <dynamics damping="0.1" friction="1" />
      <safety_controller soft_lower_limit="0" soft_upper_limit="0.12" k_position="1" k_velocity="1" />
    </joint>

    <link name="${prefix}_three_cyl_finger2">
      <inertial>
        <origin xyz="-0.0037004 0.0221089 0.0142134" rpy="0 0 0" />
        <mass value="0.091170" />
        <inertia
          ixx="9.4466E-05"
          ixy="6.6551E-06"
          ixz="1.0732E-06"
          iyy="7.0181E-05"
          iyz="-1.1067E-06"
          izz="3.7619E-05" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://xczs_inspection_robot_description/meshes/tools/three_cylinder/endllink2.STL" />
        </geometry>
        <material name="graphite_black" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://xczs_inspection_robot_description/meshes/tools/three_cylinder/endllink2.STL" />
        </geometry>
      </collision>
    </link>
    <joint name="${prefix}_three_cyl_finger2_joint" type="prismatic">
      <origin xyz="-0.034 -0.061735 -0.2935" rpy="0 0 0" />
      <parent link="${prefix}_three_cyl_base" />
      <child link="${prefix}_three_cyl_finger2" />
      <axis xyz="0 0 -1" />
      <limit lower="0" upper="0.12" effort="100" velocity="1" />
      <dynamics damping="0.1" friction="1" />
      <safety_controller soft_lower_limit="0" soft_upper_limit="0.12" k_position="1" k_velocity="1" />
    </joint>

    <link name="${prefix}_three_cyl_finger3">
      <inertial>
        <origin xyz="-2.3655E-07 0.00029683 -0.0041007" rpy="0 0 0" />
        <mass value="0.001962" />
        <inertia
          ixx="5.992E-08"
          ixy="7.7782E-13"
          ixz="1.417E-13"
          iyy="5.4141E-08"
          iyz="3.0527E-10"
          izz="4.3864E-08" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://xczs_inspection_robot_description/meshes/tools/three_cylinder/endllink3.STL" />
        </geometry>
        <material name="graphite_black" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://xczs_inspection_robot_description/meshes/tools/three_cylinder/endllink3.STL" />
        </geometry>
      </collision>
    </link>
    <joint name="${prefix}_three_cyl_finger3_joint" type="prismatic">
      <origin xyz="-0.012 0.082 -0.05245" rpy="0 0 0" />
      <parent link="${prefix}_three_cyl_finger2" />
      <child link="${prefix}_three_cyl_finger3" />
      <axis xyz="0 0 -1" />
      <limit lower="0" upper="0.0254" effort="100" velocity="1" />
      <dynamics damping="0.1" friction="1" />
      <safety_controller soft_lower_limit="0" soft_upper_limit="0.0254" k_position="1" k_velocity="1" />
    </joint>
  </xacro:macro>

  <!-- Two electric cylinders (left hand) - a two-finger drawer grasp. -->
  <xacro:macro name="xczs_two_cylinder" params="prefix parent">
    <joint name="${prefix}_two_cyl_mount" type="fixed">
      <origin xyz="${two_cyl_mount_xyz}" rpy="${two_cyl_mount_rpy}" />
      <parent link="${parent}" />
      <child link="${prefix}_two_cyl_base" />
    </joint>
    <gazebo reference="${prefix}_two_cyl_mount">
      <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>

    <link name="${prefix}_two_cyl_base">
      <inertial>
        <origin xyz="-5.5021E-05 -0.047926 -0.15922" rpy="0 0 0" />
        <mass value="1.8714" />
        <inertia
          ixx="0.0031433"
          ixy="-1.6051E-06"
          ixz="3.5399E-07"
          iyy="0.0028455"
          iyz="-2.1303E-06"
          izz="0.0012282" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://xczs_inspection_robot_description/meshes/tools/two_cylinder/endBody4.STL" />
        </geometry>
        <material name="graphite_black" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://xczs_inspection_robot_description/meshes/tools/two_cylinder/endBody4.STL" />
        </geometry>
      </collision>
    </link>

    <link name="${prefix}_two_cyl_finger1">
      <inertial>
        <origin xyz="0.00019307 0.00639 0.024544" rpy="0 0 0" />
        <mass value="0.070322" />
        <inertia
          ixx="7.0736E-05"
          ixy="-1.1531E-10"
          ixz="-1.1462E-12"
          iyy="6.3227E-05"
          iyz="2.1893E-06"
          izz="1.1317E-05" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://xczs_inspection_robot_description/meshes/tools/two_cylinder/endlink1.STL" />
        </geometry>
        <material name="graphite_black" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://xczs_inspection_robot_description/meshes/tools/two_cylinder/endlink1.STL" />
        </geometry>
      </collision>
    </link>
    <joint name="${prefix}_two_cyl_finger1_joint" type="prismatic">
      <origin xyz="0.034 -0.061735 -0.2935" rpy="0 0 0" />
      <parent link="${prefix}_two_cyl_base" />
      <child link="${prefix}_two_cyl_finger1" />
      <axis xyz="0 0 -1" />
      <limit lower="0" upper="0.12" effort="100" velocity="1" />
      <dynamics damping="0.1" friction="1" />
      <safety_controller soft_lower_limit="0" soft_upper_limit="0.12" k_position="1" k_velocity="1" />
    </joint>

    <link name="${prefix}_two_cyl_finger2">
      <inertial>
        <origin xyz="0.0005181 -2.0477E-10 -0.0027812" rpy="0 0 0" />
        <mass value="0.11476" />
        <inertia
          ixx="7.3931E-05"
          ixy="-1.1531E-10"
          ixz="8.0168E-07"
          iyy="7.3625E-05"
          iyz="-1.171E-12"
          izz="1.3185E-05" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://xczs_inspection_robot_description/meshes/tools/two_cylinder/endlink2.STL" />
        </geometry>
        <material name="graphite_black" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://xczs_inspection_robot_description/meshes/tools/two_cylinder/endlink2.STL" />
        </geometry>
      </collision>
    </link>
    <joint name="${prefix}_two_cyl_finger2_joint" type="prismatic">
      <origin xyz="-0.034 -0.061735 -0.2935" rpy="0 0 0" />
      <parent link="${prefix}_two_cyl_base" />
      <child link="${prefix}_two_cyl_finger2" />
      <axis xyz="0 0 -1" />
      <limit lower="0" upper="0.12" effort="100" velocity="1" />
      <dynamics damping="0.1" friction="1" />
      <safety_controller soft_lower_limit="0" soft_upper_limit="0.12" k_position="1" k_velocity="1" />
    </joint>
  </xacro:macro>

  <!-- Rock-in / rock-out mechanism (left hand) - a single rocking rotor. -->
  <xacro:macro name="xczs_rocker" params="prefix parent">
    <joint name="${prefix}_rocker_mount" type="fixed">
      <origin xyz="${rocker_mount_xyz}" rpy="${rocker_mount_rpy}" />
      <parent link="${parent}" />
      <child link="${prefix}_rocker_body" />
    </joint>
    <gazebo reference="${prefix}_rocker_mount">
      <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>

    <link name="${prefix}_rocker_body">
      <inertial>
        <origin xyz="-0.0027407 -0.042059 0.072703" rpy="0 0 0" />
        <mass value="0.45189" />
        <inertia
          ixx="0.00039369"
          ixy="4.162E-06"
          ixz="-3.6991E-06"
          iyy="0.00030531"
          iyz="-4.2375E-09"
          izz="0.0003897" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://xczs_inspection_robot_description/meshes/tools/rocker/endbody2.STL" />
        </geometry>
        <material name="graphite_black" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://xczs_inspection_robot_description/meshes/tools/rocker/endbody2.STL" />
        </geometry>
      </collision>
    </link>

    <link name="${prefix}_rocker_rotor">
      <inertial>
        <origin xyz="-1.0757E-05 -6.0061E-06 -0.086156" rpy="0 0 0" />
        <mass value="0.051985" />
        <inertia
          ixx="1.2277E-05"
          ixy="-6.5213E-09"
          ixz="-1.9512E-10"
          iyy="1.235E-05"
          iyz="-1.8084E-09"
          izz="5.3078E-06" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://xczs_inspection_robot_description/meshes/tools/rocker/endrotatelink.STL" />
        </geometry>
        <material name="graphite_black" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://xczs_inspection_robot_description/meshes/tools/rocker/endrotatelink.STL" />
        </geometry>
      </collision>
    </link>
    <joint name="${prefix}_rocker_rotor_joint" type="revolute">
      <origin xyz="-0.01 -0.07 0.2611" rpy="0 0 0" />
      <parent link="${prefix}_rocker_body" />
      <child link="${prefix}_rocker_rotor" />
      <axis xyz="0 0 1" />
      <limit lower="-3.14" upper="3.14" effort="100" velocity="1" />
      <dynamics damping="0.1" friction="1" />
      <safety_controller soft_lower_limit="-3.14" soft_upper_limit="3.14" k_position="1" k_velocity="1" />
    </joint>
  </xacro:macro>

  <!--
    Rotate-button mechanism (right hand) - a passive revolute carrier (rotate link,
    position-held at 0 by the controller) rides between the body and the two
    opposing jaws; the jaws clamp a round knob while the arm wrist rotates.
    The updated SolidWorks export declares the jaw clamp travel as 0..0.018 (real
    clamp), so the prismatic limits now reflect the physical mechanism.
  -->
  <xacro:macro name="xczs_rotate_button" params="prefix parent">
    <joint name="${prefix}_rotbtn_mount" type="fixed">
      <origin xyz="${rotate_button_mount_xyz}" rpy="${rotate_button_mount_rpy}" />
      <parent link="${parent}" />
      <child link="${prefix}_rotbtn_body" />
    </joint>
    <gazebo reference="${prefix}_rotbtn_mount">
      <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>

    <link name="${prefix}_rotbtn_body">
      <inertial>
        <origin xyz="-0.048762 0.0054367 0.0897504" rpy="0 0 0" />
        <mass value="0.57342" />
        <inertia
          ixx="0.00061121"
          ixy="3.0809E-07"
          ixz="6.8548E-05"
          iyy="0.00055725"
          iyz="7.5112E-07"
          izz="0.00032591" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://xczs_inspection_robot_description/meshes/tools/rotate_button/endbody.STL" />
        </geometry>
        <material name="graphite_black" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://xczs_inspection_robot_description/meshes/tools/rotate_button/endbody.STL" />
        </geometry>
      </collision>
    </link>

    <link name="${prefix}_rotbtn_rotate">
      <inertial>
        <origin xyz="6.4752E-07 -1.0998E-06 0.0066044" rpy="0 0 0" />
        <mass value="0.011598" />
        <inertia
          ixx="1.66116E-06"
          ixy="1.33386E-10"
          ixz="5.84594E-12"
          iyy="1.36259E-06"
          iyz="-1.68912E-11"
          izz="2.57566E-06" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://xczs_inspection_robot_description/meshes/tools/rotate_button/rotate.STL" />
        </geometry>
        <material name="graphite_black" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://xczs_inspection_robot_description/meshes/tools/rotate_button/rotate.STL" />
        </geometry>
      </collision>
    </link>
    <joint name="${prefix}_rotbtn_rotate_joint" type="revolute">
      <origin xyz="-0.06128 -0.006 0.1725" rpy="0 0 0" />
      <parent link="${prefix}_rotbtn_body" />
      <child link="${prefix}_rotbtn_rotate" />
      <axis xyz="0 0 1" />
      <limit lower="-3.14" upper="3.14" effort="100" velocity="1" />
      <dynamics damping="0.1" friction="1" />
      <safety_controller soft_lower_limit="-3.14" soft_upper_limit="3.14" k_position="1" k_velocity="1" />
    </joint>

    <link name="${prefix}_rotbtn_jaw1">
      <inertial>
        <origin xyz="-0.0058217 0.019764 0.0055009" rpy="0 0 0" />
        <mass value="0.00481" />
        <inertia
          ixx="3.7186E-07"
          ixy="3.7141E-08"
          ixz="4.2433E-08"
          iyy="2.6869E-07"
          iyz="-6.4061E-08"
          izz="2.9875E-07" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://xczs_inspection_robot_description/meshes/tools/rotate_button/endlink1.STL" />
        </geometry>
        <material name="graphite_black" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://xczs_inspection_robot_description/meshes/tools/rotate_button/endlink1.STL" />
        </geometry>
      </collision>
    </link>
    <joint name="${prefix}_rotbtn_jaw1_joint" type="prismatic">
      <origin xyz="0.0106 -0.0035 0.016" rpy="0 0 0" />
      <parent link="${prefix}_rotbtn_rotate" />
      <child link="${prefix}_rotbtn_jaw1" />
      <axis xyz="0 -1 0" />
      <limit lower="0" upper="0.018" effort="100" velocity="1" />
      <dynamics damping="0.1" friction="1" />
      <safety_controller soft_lower_limit="-3.14" soft_upper_limit="3.14" k_position="1" k_velocity="1" />
    </joint>

    <link name="${prefix}_rotbtn_jaw2">
      <inertial>
        <origin xyz="0.0058217 -0.019764 0.0055009" rpy="0 0 0" />
        <mass value="0.00481" />
        <inertia
          ixx="3.7186E-07"
          ixy="3.7141E-08"
          ixz="-4.2433E-08"
          iyy="2.6869E-07"
          iyz="6.4061E-08"
          izz="2.9875E-07" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://xczs_inspection_robot_description/meshes/tools/rotate_button/endlink2.STL" />
        </geometry>
        <material name="graphite_black" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://xczs_inspection_robot_description/meshes/tools/rotate_button/endlink2.STL" />
        </geometry>
      </collision>
    </link>
    <joint name="${prefix}_rotbtn_jaw2_joint" type="prismatic">
      <origin xyz="-0.0106 0.0035 0.016" rpy="0 0 0" />
      <parent link="${prefix}_rotbtn_rotate" />
      <child link="${prefix}_rotbtn_jaw2" />
      <axis xyz="0 1 0" />
      <limit lower="0" upper="0.018" effort="100" velocity="1" />
      <dynamics damping="0.1" friction="1" />
      <safety_controller soft_lower_limit="-3.14" soft_upper_limit="3.14" k_position="1" k_velocity="1" />
    </joint>
  </xacro:macro>

  <!--
    Compose all four tools onto their owning arm flanges.
      right arm -> three_cylinder + rotate_button
      left  arm -> two_cylinder    + rocker
  -->
  <xacro:macro name="xczs_tools" params="">
    <xacro:xczs_tool_carrier prefix="r" parent="r_arm_6" />
    <xacro:xczs_tool_carrier prefix="l" parent="l_arm_6" />
    <xacro:xczs_three_cylinder prefix="r" parent="r_tool_carrier" />
    <xacro:xczs_rotate_button prefix="r" parent="r_tool_carrier" />
    <xacro:xczs_two_cylinder prefix="l" parent="l_tool_carrier" />
    <xacro:xczs_rocker prefix="l" parent="l_tool_carrier" />
  </xacro:macro>
</robot>
