    </link>
    <joint name="end_worklink2" type="revolute">
      <origin xyz="0 0.021 -0.2695" rpy="3.1416 -1.5708 0" />
      <parent link="end" />
      <child link="worklink2" />
      <axis xyz="0 0 -1" />
      <limit
        lower="-0.35"
        upper="0.0"
        effort="100"
        velocity="0.5" />
      <dynamics damping="5.0" friction="30.0" />
      <safety_controller
