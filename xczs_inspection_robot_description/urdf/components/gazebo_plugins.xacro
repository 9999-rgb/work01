<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro
    name="xczs_gazebo_link_properties"
    params="link_name material gravity friction">
    <gazebo reference="${link_name}">
      <material>${material}</material>
      <xacro:if value="${gravity}">
        <gravity>true</gravity>
      </xacro:if>
      <xacro:unless value="${gravity}">
        <gravity>false</gravity>
      </xacro:unless>
      <mu1>${friction}</mu1>
      <mu2>${friction}</mu2>
      <kp>${contact_kp}</kp>
      <kd>${contact_kd}</kd>
      <maxVel>${contact_max_velocity}</maxVel>
      <minDepth>${contact_min_depth}</minDepth>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="xczs_gazebo" params="">
    <xacro:xczs_gazebo_link_properties
      link_name="body"
      material="Gazebo/Blue"
      gravity="true"
      friction="0.8" />
    <xacro:xczs_gazebo_link_properties
      link_name="arm1"
      material="Gazebo/Orange"
      gravity="false"
      friction="0.8" />
    <xacro:xczs_gazebo_link_properties
      link_name="arm2"
      material="Gazebo/Orange"
      gravity="false"
      friction="0.8" />
    <xacro:xczs_gazebo_link_properties
      link_name="arm3"
      material="Gazebo/Orange"
      gravity="false"
      friction="0.8" />
    <xacro:xczs_gazebo_link_properties
      link_name="arm4"
      material="Gazebo/Orange"
      gravity="false"
      friction="0.8" />
    <xacro:xczs_gazebo_link_properties
      link_name="arm5"
      material="Gazebo/Orange"
      gravity="false"
      friction="0.8" />
    <xacro:xczs_gazebo_link_properties
      link_name="end"
      material="Gazebo/DarkGrey"
      gravity="false"
      friction="0.8" />
    <xacro:xczs_gazebo_link_properties
      link_name="worklink1"
      material="Gazebo/DarkGrey"
      gravity="false"
      friction="0.8" />
    <xacro:xczs_gazebo_link_properties
      link_name="worklink2"
      material="Gazebo/DarkGrey"
      gravity="false"
      friction="0.8" />
    <xacro:xczs_gazebo_link_properties
      link_name="front_right_wheel"
      material="Gazebo/Black"
      gravity="true"
      friction="1.2" />
    <xacro:xczs_gazebo_link_properties
      link_name="front_left_wheel"
      material="Gazebo/Black"
      gravity="true"
      friction="1.2" />
    <xacro:xczs_gazebo_link_properties
      link_name="back_right_wheel"
      material="Gazebo/Black"
      gravity="true"
      friction="1.2" />
    <xacro:xczs_gazebo_link_properties
      link_name="back_left_wheel"
      material="Gazebo/Black"
      gravity="true"
      friction="1.2" />

    <gazebo>
      <plugin
        name="xczs_planar_move"
        filename="libgazebo_ros_planar_move.so">
        <ros>
          <namespace>/xczs</namespace>
        </ros>
        <update_rate>${planar_move_update_rate}</update_rate>
        <publish_rate>20</publish_rate>
        <publish_odom>true</publish_odom>
        <publish_odom_tf>true</publish_odom_tf>
        <odometry_frame>odom</odometry_frame>
        <robot_base_frame>body</robot_base_frame>
        <covariance_x>0.0001</covariance_x>
        <covariance_y>0.0001</covariance_y>
        <covariance_yaw>0.001</covariance_yaw>
      </plugin>
      <plugin
        name="xczs_planar_stabilizer"
        filename="libxczs_planar_stabilizer.so">
        <settling_duration>1.5</settling_duration>
      </plugin>
      <plugin
        name="xczs_joint_pose_trajectory"
        filename="libgazebo_ros_joint_pose_trajectory.so">
        <ros>
          <namespace>/xczs</namespace>
          <remapping>set_joint_trajectory:=joint_trajectory</remapping>
        </ros>
        <update_rate>100</update_rate>
      </plugin>
      <plugin
        name="xczs_joint_state_publisher"
        filename="libgazebo_ros_joint_state_publisher.so">
        <ros>
          <namespace>/xczs</namespace>
        </ros>
        <update_rate>50</update_rate>
        <joint_name>body_arm1</joint_name>
        <joint_name>arm1_arm2</joint_name>
        <joint_name>arm2_arm3</joint_name>
        <joint_name>arm3_arm4</joint_name>
        <joint_name>arm4_arm5</joint_name>
        <joint_name>arm5_end</joint_name>
        <joint_name>end_worklink1</joint_name>
        <joint_name>end_worklink2</joint_name>
        <joint_name>body_frw</joint_name>
        <joint_name>body_flw</joint_name>
        <joint_name>body_brw</joint_name>
        <joint_name>body_blw</joint_name>
      </plugin>
    </gazebo>
  </xacro:macro>
</robot>
