<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro
    name="xczs_gazebo_link_properties"
    params="link_name material gravity friction">
    <gazebo reference="${link_name}">
      <material>${material}</material>
      <xacro:if value="${gravity}">
        <gravity>true</gravity>
      </xacro:if>
      <xacro:unless value="${gravity}">
        <gravity>false</gravity>
      </xacro:unless>
      <mu1>${friction}</mu1>
      <mu2>${friction}</mu2>
      <kp>${contact_kp}</kp>
      <kd>${contact_kd}</kd>
      <maxVel>${contact_max_velocity}</maxVel>
      <minDepth>${contact_min_depth}</minDepth>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="xczs_gazebo" params="">
    <xacro:xczs_gazebo_link_properties
      link_name="body"
      material="Gazebo/Blue"
      gravity="true"
      friction="0.8" />

    <!-- Left arm links. -->
    <xacro:xczs_gazebo_link_properties link_name="l_arm_0" material="Gazebo/Orange" gravity="false" friction="0.8" />
    <xacro:xczs_gazebo_link_properties link_name="l_arm_1" material="Gazebo/Orange" gravity="false" friction="0.8" />
    <xacro:xczs_gazebo_link_properties link_name="l_arm_2" material="Gazebo/Orange" gravity="false" friction="0.8" />
    <xacro:xczs_gazebo_link_properties link_name="l_arm_3" material="Gazebo/Orange" gravity="false" friction="0.8" />
    <xacro:xczs_gazebo_link_properties link_name="l_arm_4" material="Gazebo/Orange" gravity="false" friction="0.8" />
    <xacro:xczs_gazebo_link_properties link_name="l_arm_5" material="Gazebo/Orange" gravity="false" friction="0.8" />
    <xacro:xczs_gazebo_link_properties link_name="l_arm_6" material="Gazebo/DarkGrey" gravity="false" friction="0.8" />

    <!-- Right arm links. -->
    <xacro:xczs_gazebo_link_properties link_name="r_arm_0" material="Gazebo/Orange" gravity="false" friction="0.8" />
    <xacro:xczs_gazebo_link_properties link_name="r_arm_1" material="Gazebo/Orange" gravity="false" friction="0.8" />
    <xacro:xczs_gazebo_link_properties link_name="r_arm_2" material="Gazebo/Orange" gravity="false" friction="0.8" />
    <xacro:xczs_gazebo_link_properties link_name="r_arm_3" material="Gazebo/Orange" gravity="false" friction="0.8" />
    <xacro:xczs_gazebo_link_properties link_name="r_arm_4" material="Gazebo/Orange" gravity="false" friction="0.8" />
    <xacro:xczs_gazebo_link_properties link_name="r_arm_5" material="Gazebo/Orange" gravity="false" friction="0.8" />
    <xacro:xczs_gazebo_link_properties link_name="r_arm_6" material="Gazebo/DarkGrey" gravity="false" friction="0.8" />

    <!-- Right tools - toolset A (three_cylinder) / toolset B (rotate_button). -->
    <xacro:if value="${'$(arg toolset)'.upper() == 'A'}">
      <xacro:xczs_gazebo_link_properties link_name="r_three_cyl_base" material="Gazebo/DarkGrey" gravity="false" friction="0.8" />
      <xacro:xczs_gazebo_link_properties link_name="r_three_cyl_finger1" material="Gazebo/Blue" gravity="false" friction="0.8" />
      <xacro:xczs_gazebo_link_properties link_name="r_three_cyl_finger2" material="Gazebo/Blue" gravity="false" friction="0.8" />
      <xacro:xczs_gazebo_link_properties link_name="r_three_cyl_finger3" material="Gazebo/Blue" gravity="false" friction="0.8" />
    </xacro:if>
    <xacro:if value="${'$(arg toolset)'.upper() == 'B'}">
      <xacro:xczs_gazebo_link_properties link_name="r_rotbtn_body" material="Gazebo/DarkGrey" gravity="false" friction="0.8" />
      <xacro:xczs_gazebo_link_properties link_name="r_rotbtn_rotate" material="Gazebo/Orange" gravity="false" friction="0.8" />
      <xacro:xczs_gazebo_link_properties link_name="r_rotbtn_jaw1" material="Gazebo/Orange" gravity="false" friction="0.8" />
      <xacro:xczs_gazebo_link_properties link_name="r_rotbtn_jaw2" material="Gazebo/Orange" gravity="false" friction="0.8" />
    </xacro:if>

    <!-- Left tools - toolset A (two_cylinder) / toolset B (rocker). -->
    <xacro:if value="${'$(arg toolset)'.upper() == 'A'}">
      <xacro:xczs_gazebo_link_properties link_name="l_two_cyl_base" material="Gazebo/DarkGrey" gravity="false" friction="0.8" />
      <xacro:xczs_gazebo_link_properties link_name="l_two_cyl_finger1" material="Gazebo/Blue" gravity="false" friction="0.8" />
      <xacro:xczs_gazebo_link_properties link_name="l_two_cyl_finger2" material="Gazebo/Blue" gravity="false" friction="0.8" />
    </xacro:if>
    <xacro:if value="${'$(arg toolset)'.upper() == 'B'}">
      <xacro:xczs_gazebo_link_properties link_name="l_rocker_body" material="Gazebo/DarkGrey" gravity="false" friction="0.8" />
      <xacro:xczs_gazebo_link_properties link_name="l_rocker_rotor" material="Gazebo/Orange" gravity="false" friction="0.8" />
    </xacro:if>

    <!-- Passive visual sensor housings.  The body-mounted laser housings
         (l_laser / r_laser) are fixed to body and get lumped into it during
         URDF-to-SDF conversion, so they intentionally carry no gazebo block
         here, since a per-link gravity would surface as a second <gravity> on
         the body link and break the single gravity=1 chassis contract. -->
    <xacro:xczs_gazebo_link_properties link_name="l_camera" material="Gazebo/Black" gravity="false" friction="0.8" />
    <xacro:xczs_gazebo_link_properties link_name="r_camera" material="Gazebo/Black" gravity="false" friction="0.8" />

    <!-- Wheels - vertical support with low surface friction so the planar mover
         can translate holonomically. -->
    <xacro:xczs_gazebo_link_properties
      link_name="l_wheel_0"
      material="Gazebo/Black"
      gravity="true"
      friction="${planar_wheel_surface_friction}" />
    <xacro:xczs_gazebo_link_properties
      link_name="l_wheel_1"
      material="Gazebo/Black"
      gravity="true"
      friction="${planar_wheel_surface_friction}" />
    <xacro:xczs_gazebo_link_properties
      link_name="r_wheel_0"
      material="Gazebo/Black"
      gravity="true"
      friction="${planar_wheel_surface_friction}" />
    <xacro:xczs_gazebo_link_properties
      link_name="r_wheel_1"
      material="Gazebo/Black"
      gravity="true"
      friction="${planar_wheel_surface_friction}" />

    <gazebo>
      <plugin
        name="xczs_planar_move_$(arg gazebo_plugin_instance_id)"
        filename="libgazebo_ros_planar_move.so">
        <ros>
          <namespace>/xczs</namespace>
        </ros>
        <update_rate>${planar_move_update_rate}</update_rate>
        <publish_rate>20</publish_rate>
        <publish_odom>true</publish_odom>
        <publish_odom_tf>true</publish_odom_tf>
        <odometry_frame>odom</odometry_frame>
        <robot_base_frame>body</robot_base_frame>
        <covariance_x>0.0001</covariance_x>
        <covariance_y>0.0001</covariance_y>
        <covariance_yaw>0.001</covariance_yaw>
      </plugin>
      <!-- Keep the spawn pose until its required verifier releases this
           startup-only hold.  It must not remain active during ordinary
           trajectories, where ros2_control is the sole joint authority. -->
      <plugin
        name="xczs_planar_stabilizer_$(arg gazebo_plugin_instance_id)"
        filename="libxczs_planar_stabilizer.so">
        <ros>
          <namespace>/xczs</namespace>
        </ros>
        <grasp_active_topic>/xczs/cabinet/grasp_active</grasp_active_topic>
        <joint_hold_topic>/xczs/joint_hold_enabled</joint_hold_topic>
        <cmd_vel_topic>/xczs/cmd_vel</cmd_vel_topic>
        <settling_duration>1.5</settling_duration>
        <hold_joint>l_arm_0_joint</hold_joint>
        <hold_joint>l_arm_1_joint</hold_joint>
        <hold_joint>l_arm_2_joint</hold_joint>
        <hold_joint>l_arm_3_joint</hold_joint>
        <hold_joint>l_arm_4_joint</hold_joint>
        <hold_joint>l_arm_5_joint</hold_joint>
        <hold_joint>l_arm_6_joint</hold_joint>
        <hold_joint>r_arm_0_joint</hold_joint>
        <hold_joint>r_arm_1_joint</hold_joint>
        <hold_joint>r_arm_2_joint</hold_joint>
        <hold_joint>r_arm_3_joint</hold_joint>
        <hold_joint>r_arm_4_joint</hold_joint>
        <hold_joint>r_arm_5_joint</hold_joint>
        <hold_joint>r_arm_6_joint</hold_joint>
        <xacro:if value="${'$(arg toolset)'.upper() == 'A'}">
          <hold_joint>r_three_cyl_finger1_joint</hold_joint>
          <hold_joint>r_three_cyl_finger2_joint</hold_joint>
          <hold_joint>r_three_cyl_finger3_joint</hold_joint>
          <hold_joint>l_two_cyl_finger1_joint</hold_joint>
          <hold_joint>l_two_cyl_finger2_joint</hold_joint>
        </xacro:if>
        <xacro:if value="${'$(arg toolset)'.upper() == 'B'}">
          <hold_joint>r_rotbtn_rotate_joint</hold_joint>
          <hold_joint>r_rotbtn_jaw1_joint</hold_joint>
          <hold_joint>r_rotbtn_jaw2_joint</hold_joint>
          <hold_joint>l_rocker_rotor_joint</hold_joint>
        </xacro:if>
      </plugin>
    </gazebo>
  </xacro:macro>
</robot>
