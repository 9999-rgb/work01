<?xml version="1.0"?>
<package format="3">
  <name>xczs_inspection_robot_bringup</name>
  <version>1.0.0</version>
  <description>
    Unified bringup entry point for the XCZS inspection robot: composes the
    Gazebo, MoveIt, Nav2 and control stack into one launch file.
  </description>

  <maintainer email="live@example.com">live</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>xczs_inspection_robot_control</exec_depend>
  <exec_depend>xczs_inspection_robot_description</exec_depend>
  <exec_depend>xczs_inspection_robot_gazebo</exec_depend>
  <exec_depend>xczs_inspection_robot_moveit_config</exec_depend>
  <exec_depend>xczs_inspection_robot_nav2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
