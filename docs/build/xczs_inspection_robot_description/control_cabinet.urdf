  <gazebo>
    <!-- The body is fixed to world; interactive controls remain dynamic. -->
    <static>false</static>
    <selfCollide>false</selfCollide>
    <!--
      Gazebo hosts every cabinet plugin in one process.  Keep the plugin/node
      name unique even when process-wide ROS arguments override the namespace;
      otherwise rosout treats all cabinet instances as the same node.
    -->
    <plugin filename="libxczs_cabinet_state.so" name="xczs_control_cabinet_state">
      <ros>
        <namespace>/xczs/cabinet/control_cabinet</namespace>
      </ros>
      <state_publish_rate>20.0</state_publish_rate>
      <reset_service>/xczs/cabinet/control_cabinet/reset_physics</reset_service>
      <grasp_service>/xczs/cabinet/control_cabinet/grasp</grasp_service>
      <grasp_active_topic>/xczs/cabinet/control_cabinet/grasp_active</grasp_active_topic>
      <active_control_topic>/xczs/cabinet/control_cabinet/active_control</active_control_topic>
      <operation_heartbeat_topic>/xczs/cabinet/control_cabinet/operation_heartbeat</operation_heartbeat_topic>
      <operation_fault_topic>/xczs/cabinet/control_cabinet/operation_fault</operation_fault_topic>
      <grasp_distance_threshold>0.12</grasp_distance_threshold>
      <!-- Above the 1.25 s worst normal heartbeat, below the 3 s lease TTL. -->
      <operation_watchdog_timeout>2.0</operation_watchdog_timeout>
      <control>
        <control_id>box_1_button_1</control_id>
        <control_type>button</control_type>
        <joint_name>box_1_box_1_button_1</joint_name>
        <joint_state_topic>/xczs/cabinet/control_cabinet/box_1_button_1/joint_states</joint_state_topic>
        <pressed_topic>/xczs/cabinet/control_cabinet/box_1_button_1/pressed</pressed_topic>
        <state_topic>/xczs/cabinet/control_cabinet/box_1_button_1/state</state_topic>
        <state_ids>released pressed</state_ids>
        <spring_stiffness>800.0</spring_stiffness>
        <spring_damping>8.0</spring_damping>
        <press_threshold>0.006</press_threshold>
