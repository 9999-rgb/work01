  <joint name="cabinet_body_box_11" type="fixed">
    <origin rpy="0 0 0" xyz="0.005 0.322 0"/>
    <parent link="cabinet_body"/>
    <child link="box_11"/>
  </joint>
  <link name="box_11_knob">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0.0135 0.018"/>
      <mass value="0.08"/>
      <inertia ixx="3.7e-05" ixy="0" ixz="0" iyy="1.0e-05" iyz="0" izz="3.0e-05"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://xczs_inspection_robot_description/meshes/control_cabinet/box_11_knob.stl"/>
      </geometry>
      <material name="cabinet_black"/>
    </visual>
    <!-- The base and blade stay primitive so contact remains convex. -->
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.02" radius="0.0175"/>
      </geometry>
    </collision>
    <collision>
      <origin rpy="0 0 0" xyz="0 0.0135 0.018"/>
      <geometry>
        <box size="0.011 0.065 0.036"/>
      </geometry>
    </collision>
  </link>
  <joint name="box_11_box_11_knob" type="revolute">
    <origin rpy="0 0 0" xyz="0.13547 0.43394 0.0295"/>
    <parent link="cabinet_body"/>
    <child link="box_11_knob"/>
    <axis xyz="0 0 1"/>
    <limit effort="5.0" lower="-0.8853981633974483" upper="0.8853981633974483" velocity="1.0"/>
    <!--
        Joint friction must stay well below the detent restoring force at the
        cushion offset (0.60 * 0.01 = 0.006 N m).  0.02 N m gave a +-0.033 rad
        Coulomb dead zone, so a release snap landing 0.0054 rad past the detent
        stuck there on the ODE stop motor and kicked on approach.  0.002 N m
        keeps the dead zone +-0.0033 rad inside the cushion, so the detent
        always seats the knob back at its detent.
      -->
    <dynamics damping="0.04" friction="0.002"/>
  </joint>
  <gazebo reference="box_11_knob">
    <material>Gazebo/Black</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000</kp>
    <kd>100</kd>
    <maxVel>0.1</maxVel>
    <minDepth>0.001</minDepth>
  </gazebo>
  <gazebo reference="box_11_box_11_knob">
    <implicitSpringDamper>true</implicitSpringDamper>
    <provideFeedback>true</provideFeedback>
  </gazebo>
